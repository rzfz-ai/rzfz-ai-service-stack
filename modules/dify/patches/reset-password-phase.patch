# Dify 1.14 reset-password phase-strip fix — unified diff (documentary)
#
# Memory ref: project_dify_114_reset_password_phase_strip.md
# Blind-spot: B-12 (BLIND-SPOTS.md)
# Bug ref:    .gsd/reports/blind-spots-bugs-2026-05-15.md::BS-AUTH-BUG-03
# Test ref:   tests/api/dify-api/test_reset_password_phase.py
#
# Upstream: PR #34380 (langgenius/dify) introduced `_TokenData` as a
# TypedDict that *only* listed the fields explicitly assembled by token
# *issuers*. Subsequent PR #35425 added a security check on the *consumer*
# side that asserts `phase == <expected>` on the decoded TokenData. The
# net effect: every password-reset / change-email flow that goes through
# the token-decode path returns 400 invalid_or_expired_token, because the
# `phase` key the consumer is checking for has been silently stripped by
# the TypedDict's `total=False` round-trip.
#
# Upstream PR #36117 adds `phase: str` to the TypedDict; it is *open* as
# of 2026-05-13. Until it merges and we move to a Dify release that
# carries the fix, we apply it at container start via
# `dify/patches/entrypoint-wrapper.sh` (idempotent, grep-guarded).
#
# This file is the unified-diff form of that surgical edit, kept under
# version control so:
#   (a) the fix is auditable / reviewable without running the container,
#   (b) reverts and upstream-rebases can spot the patch via `git grep`,
#   (c) the in-source patch-presence test
#       (test_in_source_patch_marker_present in
#        tests/api/dify-api/test_reset_password_phase.py) has a stable
#       fingerprint file to assert on.
#
# When upstream merges PR #36117 and we bump to a Dify release that ships
# `phase: str` in the TypedDict, delete this file *and* Patch 1 in
# entrypoint-wrapper.sh in the same commit. The runtime patch is
# grep-guarded and will silently no-op until then, so a stale fix is
# harmless — only this documentary `.patch` would need cleanup.

--- a/api/libs/helper.py
+++ b/api/libs/helper.py
@@ -36,6 +36,7 @@ class _TokenData(TypedDict, total=False):
     token_type: str
     code: str
     old_email: str
+    phase: str


 _token_data_adapter: TypeAdapter[_TokenData] = TypeAdapter(_TokenData)
