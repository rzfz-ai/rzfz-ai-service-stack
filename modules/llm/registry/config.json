{
  "storage": {
    "rootDirectory": "/var/lib/registry",
    "dedupe": true,
    "gc": true
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000",
    "compat": [
      "docker2s2"
    ],
    "readTimeout": "0s",
    "writeTimeout": "0s",
    "auth": {
      "htpasswd": {
        "path": "/etc/zot/auth/htpasswd"
      }
    },
    "accessControl": {
      "repositories": {
        "**": {
          "anonymousPolicy": [
            "read"
          ],
          "policies": [
            {
              "users": [
                "llm-manager"
              ],
              "actions": [
                "read",
                "create",
                "update",
                "delete"
              ]
            }
          ]
        }
      }
    }
  },
  "log": {
    "level": "info"
  },
  "extensions": {
    "search": {
      "enable": true
    },
    "ui": {
      "enable": true
    }
  }
}
