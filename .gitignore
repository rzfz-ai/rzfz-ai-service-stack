# rzfz.ai Stack — locally generated files, never committed.
# NOTE: config/.env.example and config/.env.dify.example ARE tracked — they seed `rzfz init`.

# Runtime config + secrets (generated by `rzfz init`)
.env
.env.dify
.env.pre-upgrade-backup
.env.dify.pre-upgrade-backup

# Governance checksum DB (generated by `rzfz setup --checksum-take` / pre-upgrade
# snapshot). MUST be ignored: it is an untracked, container-bind-mounted FILE, and
# on a PUBLIC box the upgrade's `git stash --include-untracked` would otherwise
# stash it away, so `docker compose up` recreates the bind-mount source as a
# DIRECTORY and razzfazz-config crash-loops on `sqlite3.connect` ("unable to open
# database file"). The dev .gitignore already ignores it; the curated public one
# dropped it (#156 — public-channel-only; internal boxes were unaffected).
.checksums.db
.checksums.db-journal

# Runtime state written on the box, NEVER committed (#173). Missing these from the
# curated list left them untracked-and-not-ignored on customer boxes, so the
# upgrade's `update_code` -> `git stash --include-untracked` tried to stash
# gigabytes of encrypted backups (HANG — hit live on a Care Solutions box with a
# 20 GB backups/ dir) and #158's untracked-stash-drop could DELETE the staged
# Enterprise overlay/. The internal repo .gitignore already carries these; the
# curated public one dropped them.
backups/
overlay/
*.log
*.pdf
.razzfazz_initialized
# Reorg-aware bootstrap, fetched fresh into the repo root for a pre-reorg -> 2026.07
# crossing. It IS a tracked file on Codeberg (force-added to the export in the push
# block below so `curl …/raw/tag/<tag>/razzfazz-upgrade-from-2026.04-GA.x.sh` keeps
# working); ignoring it here only stops the UNTRACKED self-copy the bootstrap drops
# in the stack dir from tripping `git stash --include-untracked` / blocking
# `git checkout <tag>` mid-upgrade.
razzfazz-upgrade-from-2026.04-GA.x.sh

# TLS material & keys
certs/
*.key
*.pem
*.pfx
id_rsa*
.git-credentials

# Appliance build artifacts (never commit the ~2 GB install ISOs — #151)
*.iso

# Python
__pycache__/
*.pyc
.venv/

# Node
node_modules/

# Test artifacts
tests/results/
tests/.venv/

# OS
.DS_Store
