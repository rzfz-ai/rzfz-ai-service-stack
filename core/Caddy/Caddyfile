# 20. MATRIX — Synapse homeserver (Profile: matrix) [EXPERIMENTAL]
# ==============================================================================
# Handles Matrix federation API and Authentik OIDC callback.
# No Authentik forward-auth — Synapse handles auth internally via OIDC.
# .well-known delegation allows Matrix IDs to use the root domain (@user:MAIN_DOMAIN).
{$MATRIX_DOMAIN} {
    import tls_config
    import security_headers

    # F-064 (accepted risk): Matrix .well-known requires wildcard CORS per Matrix spec.
    # Clients from any origin must be able to discover the homeserver URL.
    # Matrix .well-known delegation (root domain → matrix subdomain)
    handle /.well-known/matrix/client {
        header Content-Type application/json
        header Access-Control-Allow-Origin *
        respond `{"m.homeserver":{"base_url":"https://{$MATRIX_DOMAIN}"},"m.identity_server":{"base_url":"https://vector.im"}}` 200
    }
    handle /.well-known/matrix/server {
        header Content-Type application/json
        respond `{"m.server":"{$MATRIX_DOMAIN}:443"}` 200
    }

    # F-042: Block Synapse admin APIs from external access — these are powerful
    # server management endpoints that should only be accessed locally.
    handle /_synapse/admin/* {
        respond "Forbidden" 403
    }

    reverse_proxy synapse:8008
}

