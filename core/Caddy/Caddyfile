# 5. Authentik (Identity Provider)
{$AUTHENTIK_DOMAIN} {
    import tls_config
    import security_headers

    # GHSA-qvxx-mfm6-626f (Critical, Authenticated RCE in Policy/Property Mapping
    # test endpoint, CVSS 9.1) is unpatched on the 2026.2.x line as of 2026.2.2;
    # patches only landed on 2025.8.6 / 2025.10.4 / 2025.12.4. In our deployment
    # only `akadmin` (is_superuser) holds the `view_policy` / `view_propertymapping`
    # perms — no razzfazz.ai user group grants either — so the practical risk is
    # LOW (akadmin-credential-compromise scenario only). Even so, block at the
    # edge: there's no legitimate need to hit /test/ from a production box during
    # normal operation; admin-UI "Test" buttons inside Authentik can be reached
    # by temporarily commenting this if needed. Remove when 2026.2.3 lands.
    # See .gsd/notes/authentik-ghsa-qvxx-2026-05-09.md for the full RBAC analysis.
    @ghsa_qvxx path_regexp ghsa ^/api/v3/(policies|propertymappings)/all/[^/]+/test/?$
    respond @ghsa_qvxx 403

    # F-B7: rate-limit the authentication (login) flow only — brute-force protection
    # on credential entry. Scope to the default-authentication-flow executor so the
    # OIDC authorization/consent flow (default-provider-authorization-*) shared by
    # every SSO sign-in (Vaultwarden, Chat, Dify, …) is NOT throttled — that broad
    # /api/v3/flows/executor/* match was 429-ing legitimate reverse-SSO logins.
    # 30/min per client IP still stops any real brute-force.
    @auth_flow path /flows/-/default/authentication/* /api/v3/flows/executor/default-authentication-flow/*
    rate_limit @auth_flow {
        zone authentik_login {
            key {remote_ip}
            events 30
            window 1m
        }
    }

    # Health check: proxied to Authentik's native health endpoint
    handle /healthz {
        rewrite * /-/health/live/
        reverse_proxy authentik-server:9000
    }

    # CORS headers for OAuth flows from all subdomains.
    # Uses dynamic origin matching so any *.MAIN_DOMAIN subdomain is allowed,
    # preventing CORS errors when sessions expire on Dify, Chat, etc.
    @cors_origin header_regexp origin Origin ^https://([a-zA-Z0-9-]+\.)?{$MAIN_DOMAIN}$

    @cors_preflight {
        method OPTIONS
        header_regexp origin Origin ^https://([a-zA-Z0-9-]+\.)?{$MAIN_DOMAIN}$
    }
    handle @cors_preflight {
        header Access-Control-Allow-Origin "{http.request.header.Origin}"
        header Access-Control-Allow-Methods "GET, POST, OPTIONS"
        header Access-Control-Allow-Headers "Content-Type, Authorization"
        header Access-Control-Allow-Credentials "true"
        header Vary "Origin"
        respond "" 204
    }

    header @cors_origin Access-Control-Allow-Origin "{http.request.header.Origin}"
    header @cors_origin Access-Control-Allow-Credentials "true"
    header @cors_origin Vary "Origin"

    import branding_static

    # /media/* — legacy public-asset route. Authentik 2026.2+ doesn't actually
    # request brand assets at this URL (it uses /files/media/public/<file>?
    # token=<JWT> internally — see authentik-server's own routing). Kept here
    # for any third-party integration / dashboard that hard-codes /media/
    # URLs. Same physical files as /branding/* above.
    handle /media/* {
        uri strip_prefix /media
        root * /srv/authentik-media/media/public
        file_server
    }

    # M028 — post-login redirect (narrowed per ARCH-1).
    # Direct visits to auth.<domain>/ (the bare host) and to
    # /if/user/library/ (Authentik's default post-login landing) get
    # redirected to start.<domain>. Direct OIDC inbound goes through
    # /application/o/authorize/... and Authentik's post-callback redirect
    # goes back to the originating subdomain — neither of those paths
    # match this rule, so deep links into chat.<domain> etc. continue
    # to land at the originally-requested app.
    @start_redirect_paths {
        path / /if/user/library/ /if/user/library
    }
    redir @start_redirect_paths https://{$START_DOMAIN}/ 302

    reverse_proxy authentik-server:9000 {
        flush_interval -1
    }
}

