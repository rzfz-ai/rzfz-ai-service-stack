# 6b. Start Portal — M028 (post-login launcher)
{$START_DOMAIN} {
    import tls_config
    import security_headers

    # Health check: bypasses Authentik, proxied to app's /healthz
    handle /healthz {
        reverse_proxy razzfazz-start-portal:5000
    }

    @start_protected {
        not path /healthz
        not path /outpost.goauthentik.io/*
    }

    forward_auth @start_protected authentik-server:9000 {
        import authentik_upstream_config
    }

    # Authentik outpost endpoints (auth callback + sign_out) must reach
    # Authentik directly, not the portal app. Required for forward-auth
    # logout via /outpost.goauthentik.io/sign_out (clears the proxy session).
    handle /outpost.goauthentik.io/* {
        reverse_proxy authentik-server:9000
    }

    reverse_proxy razzfazz-start-portal:5000
}

