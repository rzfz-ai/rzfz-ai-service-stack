# ==============================================================================
# INTERNAL ADAPTERS & FORWARD PROXY (Internal Use Only)
# ==============================================================================

# F-037: Internal adapters are unauthenticated by design — they are only reachable
# from within the Docker network (other containers address them as caddy:8989, etc.).
# They cannot be bound to 127.0.0.1 because that would prevent inter-container access
# via Docker DNS. These ports are NOT published to the host (no `ports:` mapping in
# core/compose.yml for Caddy's internal ports), so they are not reachable from outside
# the Docker network. Trust model: any container on the default Docker bridge network
# can reach these endpoints. This is acceptable because all containers are operator-
# controlled and the adapters serve as protocol translators, not data stores.

# 1. GPUStack API Adapter (:8989)
# Translates OpenAI /v1/* requests to GPUStack /v1-openai/* format.
# Used by Dify and other services that expect standard OpenAI API paths.
:8989 {
    log {
        output stdout
        format json
    }
    handle_path /v1/* {
        rewrite * /v1-openai{uri}
        reverse_proxy gpustack:9090 {
            header_up Host {upstream_hostport}
            header_up X-Real-IP {remote}
        }
    }
    handle /health {
        respond "GPUStack Adapter Active" 200
    }
}

# 2. Dify Marketplace Proxy (:8196)
# Proxies requests to the external Dify plugin marketplace.
# Required because Dify containers cannot reach the internet directly.
:8196 {
    reverse_proxy https://marketplace.dify.ai {
        header_up Host "marketplace.dify.ai"
        header_up User-Agent "Mozilla/5.0"
    }
}

# 3. Dify SSRF Protection & Forward Proxy (:8195)
# Dify's HTTP Request workflow node routes outbound calls through this proxy via
# SSRF_PROXY_HTTP_URL / SSRF_PROXY_HTTPS_URL. The ACL denies RFC1918 + loopback +
# link-local so user-authored workflows cannot reach internal services (postgres,
# valkey, authentik, etc.), and allows all public destinations so legitimate
# external REST APIs work. Sandbox isolation is handled separately by the
# internal-only ssrf_proxy_network — the sandbox has no route to the internet
# regardless of this ACL.
:8195 {
    log
    route {
        header User-Agent "Mozilla/5.0"

        forward_proxy {
            hide_ip
            hide_via
            acl {
                # ga.6: scoped SSRF exception. A Dify workflow that orchestrates
                # internal document tools (PDF→JSON: docling / tika / presidio)
                # needs the forward proxy to permit those specific hosts, which the
                # RFC1918 deny below would otherwise block. Evaluated FIRST
                # (first-match-wins) → ONLY the named hosts in
                # $DIFY_DOC_TOOLS_SSRF_ALLOW are allowed; every other private
                # address stays denied. The closed default is the non-resolving
                # sentinel "disabled.invalid" (set in .env / .env.example) — NOT an
                # empty string: Caddy's {$VAR:default} only applies the default when
                # the var is UNSET, so a set-but-empty value expands to a bare
                # `allow` and crashes Caddy on startup. Enable via .env:
                # DIFY_DOC_TOOLS_SSRF_ALLOW="docling tika presidio-analyzer
                # presidio-anonymizer" (security-relevant — record in the assessment).
                allow {$DIFY_DOC_TOOLS_SSRF_ALLOW:disabled.invalid}
                deny 10.0.0.0/8
                deny 172.16.0.0/12
                deny 192.168.0.0/16
                deny 127.0.0.0/8
                deny 169.254.0.0/16
                allow all
            }
        }
    }
}
