# 9. (#22) The Setup UI (setup.<domain>) was removed in 2026.07. Its
#    functions live in the Configuration Portal (config.<domain>, §9b) and
#    the host-side `rzfz setup` CLI.

# 9b. Configuration UI (M008 — config-dev profile)
{$CONFIG_DOMAIN} {
    import tls_config
    import security_headers
    # NOTE: do NOT `import branding_static` here. razzfazz-config's Flask app
    # has its own static_url_path=/branding serving /app/app/static/* (logo,
    # module icons). Caddy's branding_static handler would shadow that and
    # try to serve from /srv/authentik-media/media/public/ which doesn't have
    # the config-portal-specific assets. F-PROD-8 (prod 2026.05 cutover):
    # operator reported "config login razzfazz logo still broken" — caused by
    # the now-removed import. Note same applies to AGENTS_DOMAIN (still has
    # the import; fix when agent-manager logo is reported broken).

    # Health check: bypasses Authentik
    handle /healthz {
        reverse_proxy razzfazz-config:5000
    }

    @config_protected {
        not path /healthz
        # razzfazz-config's Flask app serves /branding/* as static assets
        # (logo, module icons, favicons). Without this bypass, every <img
        # src="/branding/media/X.png"> inside the Release Notes / What's
        # New popup triggers Caddy → Authentik forward_auth → 302 OIDC
        # redirect for each image, which browsers don't follow as
        # subresources → all icons render broken. Branding assets aren't
        # sensitive; same pattern is used elsewhere in this Caddyfile for
        # public static surfaces. Filed as v2026.05-ga.4 hotfix.
        not path /branding/*
    }

    forward_auth @config_protected authentik-server:9000 {
        import authentik_upstream_config
    }

    reverse_proxy razzfazz-config:5000
}

