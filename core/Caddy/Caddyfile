# ==============================================================================
# 25. OPENHANDS — AI Software Development Agent (Profile: openhands) [EXPERIMENTAL]
# ==============================================================================
# OpenHands spawns per-task agent-server containers via Docker socket.
# Authentik forward-auth gates the entire domain.
# /api/options is exempted for health checks only.
# ==============================================================================
{$OPENHANDS_DOMAIN} {
    import tls_config
    import security_headers

    @openhands_protected {
        not path /api/options
        not method OPTIONS
    }

    forward_auth @openhands_protected authentik-server:9000 {
        import authentik_upstream_config
    }

    # rc6.7 #89: sandbox-path-proxy for OpenHands runtimes
    # (ga-readiness #1, option A). OpenHands spawns oh-agent-server-*
    # containers on Docker's default `bridge` and publishes random host
    # ports. Browser tries to open WSS to those random ports; Caddy
    # only fronts :443 → "Starting" hangs forever. Workaround: tell
    # OpenHands to advertise `https://<this-domain>/sandbox/{port}/`
    # via OH_SANDBOX_CONTAINER_URL_PATTERN, then route /sandbox/<port>/*
    # here back to host.docker.internal:<port>/* so the browser stays
    # on :443. The host-gateway alias on caddy (compose.yml) +
    # `bridge` network attachment together make host.docker.internal
    # routable to docker0 NAT, which DNATs into the sandbox.
    #
    # Caddy's reverse_proxy supports placeholder substitution in the
    # upstream `to` clause when the value is set via `vars` in the
    # subroute. The path_regexp matcher captures port + remainder.
    @sandbox path_regexp sb ^/sandbox/(\d+)(/.*)?$
    handle @sandbox {
        rewrite * {http.regexp.sb.2}
        reverse_proxy host.docker.internal:{http.regexp.sb.1} {
            header_up Host {upstream_hostport}
        }
    }

    reverse_proxy openhands:3000
}

