# ==============================================================================
# CADDY CONFIGURATION (Reverse & Forward Proxy)
# ==============================================================================
# This Caddyfile configures the entry point for the entire service stack.
# It handles:
# 1. Reverse Proxying: Routing external traffic to internal Docker services.
# 2. Authentication: Integrating with Authentik for SSO.
# 3. Security: Adding security headers and TLS termination.
# 4. Internal Utilities: Forward Proxy (SSRF protection) and API Adapters.
#
# Environment variables like {$DOMAIN} are injected from .env at runtime.
# ==============================================================================

# ------------------------------------------------------------------------------
# GLOBAL OPTIONS
# ------------------------------------------------------------------------------
# F-B7: rate_limit plugin (github.com/mholt/caddy-ratelimit) is compiled in via
# core/Caddy/Dockerfile. Applied to the Authentik login flow and Gitea login in
# their respective site blocks below (10 req/min per client IP).
# ------------------------------------------------------------------------------
{
    # #60: ACME account email. Derived by core/Caddy/entrypoint.sh into
    # ACME_EMAIL_DIRECTIVE — it expands to `email <addr>` only when ACME is
    # actually in use (TLS_MODE empty/letsencrypt) AND LETSENCRYPT_EMAIL is
    # non-empty; otherwise it's empty. A hard-coded email directive with a bare
    # LETSENCRYPT_EMAIL would expand to `email` with no argument whenever the
    # address is legitimately empty (TLS_MODE=certificate / internal), failing
    # Caddyfile adaptation and crash-looping Caddy.
    {$ACME_EMAIL_DIRECTIVE:}
    # Admin API — enabled for Agent Manager dynamic route registration
    # Only accessible from Docker network (not published to host)
    admin 0.0.0.0:2019
    # Define order of handlers
    order forward_proxy before reverse_proxy
    # F-B7: rate_limit must run before reverse_proxy so 429s go out fast.
    order rate_limit before reverse_proxy

    # Disable HTTP/3 to reduce UDP buffer contention and improve network stability
    servers {
        protocols h1 h2
    }

    # On-demand TLS guard for the *.AGENTS_DOMAIN wildcard block.
    # Caddy hits agent-manager's /api/tls/ask before issuing a per-name LE
    # cert; the endpoint returns 200 only for hostnames that resolve to a
    # registered agent instance (token-based subdomain). This blocks the
    # cert-flood DoS vector. Required for the wildcard's `tls { on_demand }`
    # in section 27b below.
    on_demand_tls {
        ask http://agent-manager:5000/api/tls/ask
    }
}

# ------------------------------------------------------------------------------
# SNIPPETS (Reusable Blocks)
# ------------------------------------------------------------------------------

(security_headers) {
    header {
        X-XSS-Protection "1; mode=block"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # F-043: Additional security headers
        Referrer-Policy "strict-origin-when-cross-origin"
        # Camera/mic/geolocation disabled for ALL sites by default (least privilege).
        # The Open WebUI site alone imports (security_headers_owui) below, which grants
        # microphone to same-origin only (voice input / dictation, RZFZAI-644 / #199).
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }
}

# Identical to (security_headers) EXCEPT microphone=(self) — imported ONLY by the Open
# WebUI site so browser voice input / dictation works there (RZFZAI-644 / #199), while
# every other subdomain keeps the microphone fully disabled. Camera stays off everywhere
# (no stack feature needs it). Keep the non-Permissions-Policy headers in sync with
# (security_headers) above.
(security_headers_owui) {
    header {
        X-XSS-Protection "1; mode=block"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(self), geolocation=()"
        -Server
    }
}

# Branding assets — serves razzfazz.ai media from authentik-media volume.
# Path lineage:
#   pre-2025.12:  files at volume root (/data/<file>)        → root /srv/authentik-media
#   2025.12 hop:  files at /data/media/<file>                 → root /srv/authentik-media/media
#   2026.2:       files at /data/media/public/<file>          → root /srv/authentik-media/media/public
# Authentik 2026.2 itself serves protected brand assets via signed JWT URLs
# (/files/media/public/<file>?token=...) handled by authentik-server, NOT
# Caddy. /branding/* is the LEGACY public-asset route used by Application
# meta_icon URLs configured in our blueprints (icons stored alongside the
# brand assets). It's effectively the same physical files; we just don't
# require Authentik's signed token for application icons (they're public).
(branding_static) {
    handle /branding/* {
        uri strip_prefix /branding
        root * /srv/authentik-media/media/public
        file_server
    }
}

(authentik_upstream_config) {
    uri /outpost.goauthentik.io/auth/caddy
    # F-062: The full Authentik JWT is forwarded to all upstream services via X-Authentik-Jwt.
    # This is a known characteristic of Caddy forward-auth with Authentik — most services
    # ignore the JWT body. Stripping it would break services that rely on it for user identity.
    copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Uid X-Authentik-Jwt X-Authentik-Meta-Jwk X-Authentik-Meta-Outpost X-Authentik-Meta-Provider X-Authentik-Meta-App X-Authentik-Meta-Version
}

# SECURITY (C1 bypass fix, PR #84 re-review): the sandbox coding-agent
# containers share the `coding-agents` docker network with agent-manager, so a
# malicious user who controls their own sandbox could otherwise dial
# agent-manager:5000 directly with a forged `Host:` + `X-Authentik-Username:`
# and hijack a victim's shell — bypassing Caddy, the ONLY component that
# validates the Authentik session. The "came through Caddy" anchor is a
# SOURCE-IP check at the manager (proxy.py `_proxy_proof_ok`: request.remote_addr
# must be Caddy's IP) — NOT an injected header. A header proof was tried first
# but Caddy's per-instance `forward_auth` does not reliably propagate a
# route-injected request header to the upstream (it delivered the X-Authentik-*
# copy_headers but dropped the proof), which 403'd the real owner. A sandbox
# cannot spoof Caddy's source IP (cap_drop ALL → no NET_RAW), so no snippet is
# needed here.

# TLS_DIRECTIVE is set by razzfazz-init.sh:
#   "tls internal" for self-signed certs (local/dev)
#   "" (empty) for automatic Let's Encrypt (production)
(tls_config) {
    {$TLS_DIRECTIVE:}
}

# Health check response snippet — used by all /healthz handlers that
# respond directly from Caddy (for services without a native /healthz).
(health_respond) {
    header Content-Type "application/json"
    respond `{"status":"ok","service":"{args[0]}"}` 200
}

# ==============================================================================
# REVERSE PROXY SECTION (External -> Internal)
# ==============================================================================


# 1. Dify (LLM App Builder)
{$DIFY_DOMAIN} {
    import tls_config
    import security_headers

    # CSP — REPORT-ONLY for now. Compensating control for the upstream
    # echarts DOM-XSS GHSA-qqjx-5h5w-x5vj which has no upstream patch as
    # of 2026-05-09. We're observing first to learn what Dify's frontend
    # legitimately needs (Next.js inline hydration scripts, monaco web-
    # workers, blob: URIs for charts, etc.) before promoting to enforce.
    # Default-src 'none' forces an explicit allowlist for everything;
    # 'unsafe-inline'/'unsafe-eval' on script-src kept until we wire
    # nonces (Next 16 supports them but Dify config doesn't opt in by
    # default). 'data:'/'blob:' on img-src + connect-src are needed for
    # echarts SVG rendering and OPFS sandbox storage. report-uri sends
    # JSON violation reports to /csp-report which Caddy 204s — review
    # access logs to find what the policy would block before flipping
    # to enforcing. Remove report-only / flip the header name to
    # 'Content-Security-Policy' once the report stream is clean.
    header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' wss: https:; frame-ancestors 'self'; worker-src 'self' blob:; base-uri 'self'; form-action 'self'; report-uri /csp-report"

    # CSP violation sink — return 204 so the browser doesn't retry; the
    # JSON body lands in Caddy's access log for review.
    handle /csp-report {
        respond 204
    }

    # F-034: API path exemptions — Dify has its own JWT auth for all API endpoints.
    # /console/api/* — Dify console backend (JWT auth, prevents CORS issues when Authentik session expires)
    # /v1/*          — Dify external API (API key auth)
    # /files/*       — File serving (Dify session auth)
    # /api/*         — Dify app API (API key auth)
    # /triggers/*    — Webhook triggers (Dify signature verification)
    # /sslog/*, /_next/*, /favicon.ico, /logo.png — static assets, no auth needed
    #
    # RZFZAI-1308: PUBLIC web-app (published-app share) routes MUST bypass the
    # Authentik forward-auth gate — otherwise a truly-public visitor to a
    # published Dify app is bounced to SSO login. In Dify 1.15.0 the frontend
    # serves shared apps from the (shareLayout) segment; those routes are
    # /chat/<token>, /completion/<token>, /workflow/<token>, /chatbot/<token>
    # (embed) and /agent/<token>, plus the web-app auth pages /webapp-signin
    # and /webapp-reset-password. Their data calls go to /api/* (already
    # exempted above) so no console JWT is needed. Community Edition has
    # webapp_auth disabled, so a published app with its site enabled is
    # reachable without any Dify login once Authentik stops gating these paths.
    @dify_protected {
        not path /healthz
        not path /console/api/*
        not path /v1/*
        not path /files/*
        not path /app/*
        not path /api/*
        not path /triggers/*
        not path /sslog/*
        not path /_next/*
        not path /favicon.ico
        not path /logo.png
        not path /csp-report
        # RZFZAI-1308 — public published-app (shareLayout) routes, no SSO gate
        not path /chat/*
        not path /completion/*
        not path /workflow/*
        not path /chatbot/*
        not path /agent/*
        not path /webapp-signin
        not path /webapp-signin/*
        not path /webapp-reset-password
        not path /webapp-reset-password/*
        not method OPTIONS
    }

    forward_auth @dify_protected authentik-server:9000 {
        import authentik_upstream_config
    }

    # Health check: proxied to Dify API's native /health endpoint
    handle /healthz {
        rewrite * /health
        reverse_proxy dify-api:5001
    }

    handle /console/api/* {
        reverse_proxy dify-api:5001
    }

    handle /api/* {
        reverse_proxy dify-api:5001
    }
    
    handle /v1/* {
        reverse_proxy dify-api:5001
    }

    handle /files/* {
        reverse_proxy dify-api:5001
    }

    handle /triggers/* {
        reverse_proxy dify-api:5001
    }

    handle {
        reverse_proxy dify-web:3000
    }
}

# 2. OpenWebUI (Chat Interface)
{$OPENWEBUI_DOMAIN} {
    import tls_config
    import security_headers_owui

    # F-034: API path exemptions — OpenWebUI has its own session/API key auth.
    # /api/*    — OpenWebUI REST API (session cookie or API key auth)
    # /ollama/* — Ollama-compatible API proxy (API key auth)
    # /v1/*     — OpenAI-compatible API (API key auth)
    # /static/*, /assets/*, /manifest.json, /favicon.ico — static assets
    @openwebui_protected {
        not path /healthz
        not path /api/*
        not path /ollama/*
        not path /v1/*
        not path /static/*
        not path /assets/*
        not path /manifest.json
        not path /favicon.ico
        not method OPTIONS
    }

    forward_auth @openwebui_protected authentik-server:9000 {
        import authentik_upstream_config
    }

    # Health check: proxied to OpenWebUI's native /health endpoint
    handle /healthz {
        rewrite * /health
        reverse_proxy openwebui:8080
    }

    reverse_proxy openwebui:8080 {
        flush_interval -1
    }
}

# 3. GPUStack (LLM Backend Manager)
{$GPUSTACK_DOMAIN} {
    import tls_config
    import security_headers
    
    # F-035: Authentik bypass is path-based + format-restricted header.
    # Originally rc4 had a blanket "any Authorization header skips forward-auth"
    # bypass; F-035 (2026-04-29 audit) removed it. 2026.05-ga then dropped it
    # entirely — broke GPUStack v0.7.1 master/worker comms.
    #
    # F-PROD-7 fix re-enabled the bypass with TWO format-restricted regexes:
    #
    #   1. `^Bearer [a-f0-9]{32}$` — covers code paths that pass the master
    #      token as an api_key (e.g. CLI / reset-admin-password).
    #   2. `^Basic c3lzdGVtL3dvcmtlci8\S+$` — the actual workhorse path. v0.7.1
    #      `gpustack/worker/worker.py` constructs ClientSet with
    #      username=f"system/worker/{worker_ip}" + password=cfg.token, so the
    #      header is `Authorization: Basic base64("system/worker/<ip>:<token>")`.
    #      base64 of "system/worker/" always starts with `c3lzdGVtL3dvcmtlci8`,
    #      and no admin user name begins with `system/worker/`, so this prefix
    #      uniquely identifies worker traffic. \S+ requires at least one more
    #      base64 char (the IP + ":" + token tail).
    #
    # GPUStack admin Bearer keys have format `gpustack_<16hex>_<32hex>`
    # (longer, contains `_`) and admin Basic credentials are user-supplied
    # names — neither matches either regex. So forward-auth still protects
    # all UI / admin paths against forged Authorization headers (F-035 spirit).
    #
    # Bypasses (forward-auth skipped when ANY of these match):
    #   OPTIONS                                  — CORS preflight
    #   /healthz                                 — health check
    #   /v1-openai*                              — OpenAI-compat API
    #   Authorization: Bearer <32 hex>           — worker token via api_key path
    #   Authorization: Basic c3lzdGVtL3dvcmtlci8…— worker via username/password
    @gpustack_protected {
        not method OPTIONS
        not path /healthz
        not path /v1-openai*
        not header_regexp Authorization "^(Bearer [a-f0-9]{32}|Basic c3lzdGVtL3dvcmtlci8\S+)$"
    }

    forward_auth @gpustack_protected authentik-server:9000 {
        import authentik_upstream_config
    }

    # #19: box-wide LLM backpressure limiter ("option C").
    #
    # Caps the rate of OpenAI-compat inference requests admitted to gpustack
    # across ALL clients that reach it through this public ingress, returning
    # 429 + Retry-After once the cap is exceeded — instead of letting an
    # overload pile onto gpustack until it OOMs / storms. Complements the
    # per-app Dify `max_active_requests` guard (#30) with a shared cap.
    #
    # Box-wide, not per-IP: `key llm` is a STATIC constant, so every client
    # shares ONE bucket (mholt/caddy-ratelimit zones are global by name). A
    # `{remote_ip}` key would instead give each source its own N — no box cap.
    #
    # Scope: only `/v1-openai*` (chat/completions, embeddings, rerank — the
    # calls that actually load the runner). /healthz, the UI, and the
    # master/worker Basic-auth comms are deliberately NOT throttled, so this
    # cannot regress the #1 keepalive/retry health-check fix below.
    #
    # Tunable + OFF by default: LLM_MAX_CONCURRENT is the number of inference
    # requests admitted per LLM_MAX_CONCURRENT_WINDOW. The .env default
    # (100000 / 1s) is effectively unlimited so existing installs are never
    # throttled; an operator opts in by setting a real cap (e.g. 8) in .env.
    #
    # CAVEAT (documented in the PR): consumers that dial the `gpustack:9090`
    # Docker-DNS name directly (OWUI, cognee, lightrag, the agents, …) bypass
    # Caddy and are NOT covered here — this guards the llm.<domain> ingress +
    # anything routed through it. A truly stack-wide cap that also covers the
    # direct-DNS consumers is a larger follow-up (route them via Caddy too).
    @llm_inference path /v1-openai*
    rate_limit @llm_inference {
        zone llm_backpressure {
            key llm
            events {$LLM_MAX_CONCURRENT:100000}
            window {$LLM_MAX_CONCURRENT_WINDOW:1s}
        }
    }

    # Health check: proxied to GPUStack's native /healthz endpoint.
    # #1: retry on a keep-alive conn-reset — when gpustack closes an idle
    # connection Caddy reused, the request resets; without a retry window that
    # surfaces as a recurring /healthz 502 blip. lb_try_duration retries the
    # (idempotent) request on a fresh connection within the window.
    handle /healthz {
        reverse_proxy gpustack:9090 {
            lb_try_duration 5s
            lb_try_interval 250ms
        }
    }

    reverse_proxy gpustack:9090 {
        flush_interval -1
        # #1: retry idempotent requests on a gpustack keep-alive connection reset
        # instead of returning 502.
        lb_try_duration 5s
        lb_try_interval 250ms
        transport http {
            versions 1.1
        }
    }
}

