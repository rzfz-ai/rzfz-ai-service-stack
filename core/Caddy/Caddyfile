# 10. Gitea (Git Service)
{$GITEA_DOMAIN} {
    import tls_config
    import security_headers

    # F-B7: rate-limit the Gitea interactive login (10/min per client IP).
    # Git clone/push use token/ssh and are excluded by specific path.
    @gitea_login path /user/login /user/login/*
    rate_limit @gitea_login {
        zone gitea_login {
            key {remote_ip}
            events 10
            window 1m
        }
    }

    # Git operations (clone, push, pull) should not require Authentik auth
    # They use Gitea's own authentication (SSH keys, access tokens, HTTP basic)
    # Patterns need both /*.git/* (bare repo) and /*/*.git/* (org/repo) forms
    # because Caddy's * wildcard does not match path separators (/)
    @git_operations {
        path /*.git/*
        path /*/*.git/*
        path /*/info/*
        path /*/*/info/*
        path /*/git-*
        path /*/*/git-*
    }
    
    # API endpoints for Git LFS and other programmatic access
    @api_paths {
        path /api/*
        path /v2/*
        path /user/*
        path /login/oauth/*
    }
    
    # Web UI paths that should be protected by Authentik
    @web_ui {
        not path /healthz
        not path /*.git/*
        not path /*/*.git/*
        not path /*/info/*
        not path /*/*/info/*
        not path /*/git-*
        not path /*/*/git-*
        not path /api/*
        not path /v2/*
        not path /user/*
        not path /login/oauth/*
        not path /assets/*
        not path /avatars/*
        not path /repo-avatars/*
        not path /favicon.ico
        not method OPTIONS
    }
    
    forward_auth @web_ui authentik-server:9000 {
        import authentik_upstream_config
    }

    # Health check: proxied to Gitea's native /api/healthz endpoint
    handle /healthz {
        rewrite * /api/healthz
        reverse_proxy gitea:3000
    }

    reverse_proxy gitea:3000
}

# 11. Cognee (GraphRAG Knowledge Engine) [EXPERIMENTAL]
# rc6.7 #57: split frontend/backend.
#   /api/*, /docs*, /openapi.json, /redoc, /health* → cognee backend (FastAPI :8000)
#   everything else                                 → cognee-frontend (Next.js :3000)
# Both routes share the same Authentik forward_auth gate, with API/health/docs
# exempt because Cognee's own JWT (fastapi-users) auths them.
{$COGNEE_DOMAIN} {
    import tls_config
    import security_headers

    # F-034: API path exemptions — Cognee has its own JWT auth (fastapi-users).
    # /api/*        — Cognee REST API (JWT bearer token auth)
    # /health*      — Health check endpoints
    # /openapi.json, /docs*, /redoc — OpenAPI documentation (read-only, no sensitive data)
    @cognee_protected {
        not path /healthz
        not path /health
        not path /health/*
        not path /api/*
        not path /openapi.json
        not path /docs
        not path /docs/*
        not path /redoc
        not method OPTIONS
    }

    forward_auth @cognee_protected authentik-server:9000 {
        import authentik_upstream_config
    }

    # rc6.7 #68: bypass the cognee-frontend onboarding wizard. Upstream's
    # /onboarding flow is hardwired for Cognee Cloud (Step 1 asks the user
    # for a sk-cog-* token, sets COGNEE_CLOUD_AUTH_TOKEN in .env, then
    # polls /api/v1/sync waiting for cloud sync to succeed). For a
    # self-hosted deployment with no Cognee Cloud account the wizard hangs
    # at Step 1 forever and Step 2 surfaces the failure as "Uploading
    # files: Failed / No connection to the server". The "Skip onboarding"
    # link only sets a per-session sessionStorage key and resets every new
    # tab. There is no env-var feature flag in cognee-frontend v1.0.1 to
    # disable the wizard, and no DB-level is_onboarded column. Sending
    # everyone straight to /dashboard is the smallest blast-radius fix
    # that survives upstream cognee-frontend updates.
    redir /onboarding /dashboard 302
    redir /onboarding/* /dashboard 302

    # Backend routes — FastAPI on cognee:8000.
    # /api/* preserves the full path (no rewrite); cognee mounts under /api/v1/...
    handle /api/* {
        reverse_proxy cognee:8000
    }
    handle /healthz {
        reverse_proxy cognee:8000
    }
    handle /health* {
        reverse_proxy cognee:8000
    }
    handle /openapi.json {
        reverse_proxy cognee:8000
    }
    handle /docs* {
        reverse_proxy cognee:8000
    }
    handle /redoc {
        reverse_proxy cognee:8000
    }

    # Everything else → Next.js UI on cognee-frontend:3000.
    handle {
        reverse_proxy cognee-frontend:3000
    }
}

