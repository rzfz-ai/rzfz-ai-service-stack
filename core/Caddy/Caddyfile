# ==============================================================================
# 22. ROOT DOMAIN — Matrix .well-known delegation (Profile: matrix) [EXPERIMENTAL]
# ==============================================================================
# Serves /.well-known/matrix/* from the root domain so that Matrix clients can
# discover the homeserver via default_server_name (e.g. @user:razzfazz-dev.ai).
# Without this, Element Web cannot auto-discover the homeserver URL.
{$MAIN_DOMAIN} {
    import tls_config

    # F-064 (accepted risk): Matrix .well-known requires wildcard CORS per Matrix spec.
    handle /.well-known/matrix/client {
        header Content-Type application/json
        header Access-Control-Allow-Origin *
        respond `{"m.homeserver":{"base_url":"https://{$MATRIX_DOMAIN}"},"m.identity_server":{"base_url":"https://vector.im"}}` 200
    }
    handle /.well-known/matrix/server {
        header Content-Type application/json
        respond `{"m.server":"{$MATRIX_DOMAIN}:443"}` 200
    }

    # Caddy internal CA certificate — download and install in your browser/OS
    # to trust all self-signed *.razzfazz-dev.ai subdomains without per-domain warnings.
    handle /caddy-ca.crt {
        root * /data/caddy/pki/authorities/local
        rewrite * /root.crt
        file_server
        header Content-Type application/x-x509-ca-cert
        header Content-Disposition `attachment; filename="razzfazz-ca.crt"`
    }

    # Everything else on the root domain: redirect to the start portal
    # (#22 — was the now-removed setup.<domain>).
    handle {
        redir https://{$START_DOMAIN}{uri} 302
    }
}

