# SPDX-License-Identifier: BUSL-1.1
# ── rzfz.ai THIN NODE environment (#549 R0) ──────────────────────────────────
# The COMPLETE configuration of an inference worker. Written by `rzfz node-init`;
# consumed by modules/llm/node-agent/compose.thin.yml. Twelve keys, not 370 —
# a node that is not a stack needs a node's worth of configuration.
#
# This file is .env.node on the box (never .env — a thin node must not look like
# a half-installed stack to tooling that greps for .env).

# ── identity + enrolment (rzfz node-init fills these) ────────────────────────
# The master's LLM Manager URL, as reachable FROM THIS BOX.
LLM_MANAGER_URL=
# Per-worker command key from enrolment (#285) — this node's ONLY credential.
LLM_WORKER_COMMAND_KEY=
# This worker's name, as enrolled. The token's name is authoritative (#285).
LLM_WORKER_NAME=
# Host-routable address the master uses to reach this node's engines (#262).
LLM_WORKER_ADVERTISE_ADDR=
# TLS trust anchor (#585). Written by `rzfz worker-join` when the join used
# --ca-pin: the path to the master's CA (plus this box's public roots) that the
# join AUTHENTICATED against the pin. EMPTY = the box's public bundle is used,
# which is correct for a master on a real certificate. A self-signed master with
# this unset ends in CERTIFICATE_VERIFY_FAILED and the node never registers.
LLM_WORKER_CA_FILE=

# ── hardware ─────────────────────────────────────────────────────────────────
# amd | cpu | nvidia | cuda-gb10 — selects the engine driver and the runner image
# family (cuda-gb10 = DGX Spark / GB10 class, #1329; gb10 / nvidia-gb10 fold onto it).
HARDWARE=amd

# online | offline — the box's network mode, as on a full box (#184). The node
# agent reads it to decide whether a missing weight may be fetched from
# HuggingFace; on an air-gapped node say `offline`, and the agent answers
# "weights not present and offline mode" instead of reaching out (#2219).
RAZZFAZZ_NETWORK_MODE=online

# #1552 — the AGENT's own GPU access (not the engines'). On NVIDIA the node's
# memory reading comes from nvidia-smi/NVML, which needs the nvidia runtime and
# the `utility` capability; without them `vram_total` is empty and the manager's
# admission gate is inert for this worker (#227/#328). `install-worker.sh` sets
# all three for --hardware nvidia; on AMD/CPU they stay empty and the service
# renders exactly as before (`runc` is the daemon default).
LLM_WORKER_RUNTIME=
NVIDIA_VISIBLE_DEVICES=
NVIDIA_DRIVER_CAPABILITIES=
# Real model-memory budget in GB (the #227 admission input; the auto-probe is
# unreliable on unified-memory boxes). EMPTY = auto-probe.
LLM_WORKER_MEM_BUDGET_GB=

# ── the master's registries, reached over the LAN ────────────────────────────
# ⚠ REACHABILITY (#549 R0 finding): both defaults inside the stack
# (llm-registry:5000) are docker-network names that DO NOT resolve from a
# remote box, and the master's host bind is loopback-only (127.0.0.1:8093).
# #559: the master now exposes the registry at hub.<master-domain> — real TLS
# cert (no insecure-registries daemon entry needed), docker API on /v2 behind
# HTTP Basic. On the master: `rzfz hub-credentials` mints the password; on this
# node: `docker login hub.<master-domain>` once, then set both keys to that
# host. The runner allow-list matches the exact host, so use the bare domain
# (no scheme) in LLM_WORKER_RUNNER_REGISTRY.
#   LLM_REGISTRY_URL=https://hub.<master-domain>
#   LLM_WORKER_RUNNER_REGISTRY=hub.<master-domain>

# #1677: the coordinate an EMPTY LLM_WORKER_RUNNER_REGISTRY falls back to. The
# runner pull is executed by this host's docker daemon, so the name has to be one
# the HOST resolves — a compose-network name never is. On a thin node this is the
# master's hub domain; `rzfz node-init --registry hub.<master-domain>` writes the
# explicit key above and this stays empty.
LLM_HUB_DOMAIN=
LLM_REGISTRY_URL=
LLM_WORKER_RUNNER_REGISTRY=
# #571: the hub's /v2 docker API is HTTP-Basic at the edge. ONE pair covers
# both consumers (runner-image pulls via the docker SDK and weight-blob pulls
# over HTTP) — the values the master printed from `rzfz hub-credentials`.
# Empty = unauthenticated (correct for the in-network llm-registry:5000
# default). The agent only ever sends these to the configured registry host.
LLM_WORKER_REGISTRY_USER=
LLM_WORKER_REGISTRY_PASSWORD=

# ── engine supervision windows (#971) ────────────────────────────────────────
# READINESS GRACE is the one a large-model node actually needs. It is how long
# an engine may take to answer /health after launch before the supervisor calls
# the load failed and restarts it. On the CUDA/vLLM path weights load in
# seconds, then the engine spends MINUTES in vLLM's vision-encoder + KV-cache
# profiling and (non-eager) CUDA-graph capture before /health ever answers. Too
# low and the supervisor kills the engine mid-profiling and loops forever — no
# crash, no OOM, exit 0, the model simply never serves. The old 120 s did that
# to a 35B multimodal FP8 model; 300 s clears it with margin. Raise it if this
# node runs something bigger still.
# Seconds. Empty / unparseable / non-positive → the default shown.
RZFZ_ENGINE_READINESS_GRACE=300
# #316 self-heal: cooldown before a circuit-broken engine is half-opened, and
# the bound on those attempts.
RZFZ_ENGINE_RECOVER_AFTER=180
RZFZ_ENGINE_MAX_RECOVER_ATTEMPTS=3
# Per-instance engine /health probe timeout on this node's report loop.
RZFZ_ENGINE_PROBE_TIMEOUT=2

# ── engine images (#331 / #1436 / #1516 / #1518) ─────────────────────────────
# Repin the engine image this node launches, without a code change. EMPTY = the
# built-in default for the hardware class (app/drivers/images.py):
#   amd        llama-runner:b9851-vulkan
#   cpu        llama-runner:b10853-cpu
#   cuda       ASK THE GPU — the compute capability picks the runner (#1517):
#                12.0 (RTX PRO 6000, sm_120)  llama-runner:b9851-cuda12.8-sm120
#                12.1 (GB10 / DGX Spark)      llama-runner:b9851-cuda13.0-sm121a
#              An unmapped capability is REFUSED, not guessed — a llama.cpp
#              binary is compiled for one architecture and the wrong one dies
#              with "no kernel image is available for execution on the device".
# There is no vLLM default any more (#1518): every hardware class serves GGUF
# through llama.cpp and only the BINARY differs. The pre-#1516 names
# (llama-vulkan-runner:*, llama-cpu-runner:*, llama-cuda-runner:*,
# llama-cuda-gb10-runner:*) are published as aliases for one cycle, so a box
# already pinned to one keeps resolving — but they are not what EMPTY gives you.
# A running engine keeps its image until its next (re)launch.
RAZZFAZZ_ENGINE_IMAGE_AMD=
RAZZFAZZ_ENGINE_IMAGE_CPU=
RAZZFAZZ_ENGINE_IMAGE_CUDA=
RAZZFAZZ_ENGINE_IMAGE_CUDA_LLAMACPP=
RAZZFAZZ_ENGINE_IMAGE_CUDA_GB10=
RAZZFAZZ_ENGINE_IMAGE_CUDA_GB10_LLAMACPP=

# #1517: which CUDA llama.cpp runner this box can execute is decided by the
# GPU's compute capability, as `nvidia-smi --query-gpu=compute_cap` reports it
# (12.0 = RTX PRO 6000 / sm_120, 12.1 = GB10 / sm_121a). EMPTY = ask the GPU.
# Set this only for a card we have not mapped yet, or one that misreports: a
# llama.cpp binary is compiled FOR an architecture, so pinning the wrong value
# fails at engine start with "no kernel image is available for execution on
# the device". This is the escape hatch the agent's error message names.
RAZZFAZZ_CUDA_COMPUTE_CAP=

# #1456: fraction of the GB10 node's UNIFIED memory one vLLM engine may
# pre-allocate. Empty = derived from LLM_WORKER_MEM_BUDGET_GB / MemTotal
# (96 of 121.6 GB -> 0.79), 0.5 without a budget. Set this when the derived
# value does not fit — e.g. to leave room for a second engine.
# Engine this node ADVERTISES + runs (cuda: "vllm" | "llamacpp"). EMPTY = the
# per-hardware default driver.
RAZZFAZZ_NODE_ENGINE=

# #1517 rev-B: the two remaining knobs the ENGINE DRIVERS read, wired here
# because a key the drivers read but nothing forwards is a promise the box
# cannot redeem (#319/#1436). Both are per-node, so a thin node needs them too.
# Numeric HOST GIDs granting a non-root engine access to /dev/kfd + /dev/dri,
# comma-separated. Group NAMES cannot be used — docker resolves them against
# the engine image's /etc/group, which minimal runner images do not define.
# EMPTY = engine runs as root, which already has device access.
RAZZFAZZ_GPU_GROUP_GIDS=
# The llama.cpp server binary inside the runner image. EMPTY = llama-server,
# which is what every runner this repo builds ships. Only a custom runner
# image with a differently-named binary needs this.
RAZZFAZZ_LLAMACPP_BINARY=

# ── plumbing (defaults are correct for the thin compose; rarely touched) ─────
LLM_WORKER_MODELS_VOLUME=rzfz-node_llm-node-models
LLM_WORKER_ENGINE_NETWORK=rzfz-node_default
LLM_WORKER_REPORT_INTERVAL=30
# #1619 — the lean beat beside the full report above: it carries the four
# utilisation numbers and claims queued commands, nothing else. The console's
# live chart and the model log both come from here; the 30 s report keeps the
# registration, the instance table and the image pins. 0 switches the beat off
# and this node behaves exactly as it did before.
LLM_WORKER_FAST_BEAT_INTERVAL=3
LLM_WORKER_AGENT_PORT=8090
TZ=UTC
