SYNAPSE_REPORT_STATS=no
SYNAPSE_REGISTRATION_SHARED_SECRET=
SYNAPSE_MACAROON_SECRET_KEY=
SYNAPSE_FORM_SECRET=
SYNAPSE_CLIENT_SECRET=
MATRIX_CLIENT_ID=

# ==============================================================================
# (M020 S07) MOLTIS + HERMES global config removed — both are now per-user via
# agent-manager (`agents` profile). Per-user instances are launched from the
# "My Agents" dashboard at https://agents.${MAIN_DOMAIN}/dashboard. Per-instance
# secrets (MOLTIS password, HERMES API_SERVER_KEY) are generated by the
# agent-manager provisioner at launch and stored in the per-instance config
# JSONB column — they're returned to the OpenWebUI pipes via the user-scoped
# /api/find/<agent_type> endpoint.
#
# Build-time image pins for the per-user agent images (locally built once, then
# provisioned per-user by agent-manager). Match the compose ${VAR:-default}
# fallbacks in modules/agents/compose.yml and the manifest runtime_only pins.
# Bump via the check-and-bump-versions skill.
HERMES_AGENT_VERSION=v2026.8.27
MOLTIS_VERSION=20260827.01
# ==============================================================================

# Element Web (Matrix browser client) — served alongside Synapse
ELEMENT_WEB_CLIENT_SECRET=

# ==============================================================================
# GPUSTACK CONFIGURATION
# ==============================================================================
# GPUStack Mode: standalone, master, or worker
# standalone: All ports bound to localhost only (default, no external workers)
# master: All ports bound to 0.0.0.0 (accepts external worker connections)
# worker: Connect to a remote GPUStack master server as compute node
GPUSTACK_MODE=standalone
# Port bind address (auto-set by razzfazz-init.sh based on GPUSTACK_MODE)
# 127.0.0.1 = standalone, 0.0.0.0 = master/worker
GPUSTACK_BIND=127.0.0.1
# Worker IP address advertised to master (host IP, not Docker-internal IP)
# Only for worker nodes - auto-detected by razzfazz-init.sh
GPUSTACK_WORKER_IP=
# Worker name shown in master UI (defaults to hostname if empty)
GPUSTACK_WORKER_NAME=

# Per-service admin password (generated by razzfazz-init.sh, unique per service)
GPUSTACK_ADMIN_PASSWORD=

GPUSTACK_DATABASE_URL="postgresql://${GPUSTACK_DB_USER}:${GPUSTACK_DB_PASSWORD}@postgres:5432/${GPUSTACK_DB}"
GPUSTACK_MASTER_SERVER_URL=   # Only for worker nodes
GPUSTACK_MASTER_SERVER_TOKEN= # Only for worker nodes
# GPUStack API Key for model-sync service (generate in GPUStack UI after first start)
# Set via: rzfz setup --set-gpustack-api-key <KEY>  or the Settings portal (settings.<domain> -> Settings -> GPUStack)
# IMPORTANT: These are placeholders — you MUST replace them after GPUStack's first start.
# Log in to https://llm.<domain>, create an API key, then run:
#   rzfz setup --set-gpustack-api-key <KEY>
GPUSTACK_API_KEY=gpustack_CHANGEME_AFTER_FIRST_START
# GPUStack OpenAI-compatible API Key for ollama-proxy
# IMPORTANT: Same as above — must be replaced with a real key from GPUStack UI.

# ------------------------------------------------------------------------------
# LLM backpressure limiter (#19 — "option C", box-wide 429 backpressure)
# ------------------------------------------------------------------------------
# Caddy caps the rate of OpenAI-compat inference requests (llm.<domain>/v1-openai*)
# admitted to gpustack ACROSS ALL clients that reach it via the public ingress,
# returning 429 + Retry-After once the cap is exceeded — so an overload backs off
# instead of piling onto gpustack until it OOMs/storms. Complements the per-app
# Dify max_active_requests guard (#30). Box-wide (single shared bucket), NOT
# per-IP.
#
# LLM_MAX_CONCURRENT       = inference requests admitted per window (the cap).
# LLM_MAX_CONCURRENT_WINDOW = the window (Caddy duration, e.g. 1s, 500ms, 2s).
#
# DEFAULT = OFF: 100000/1s is effectively unlimited, so existing installs are
# never throttled. To enable backpressure, set a real cap sized to your box,
# e.g. LLM_MAX_CONCURRENT=8 with LLM_MAX_CONCURRENT_WINDOW=1s. Apply with
# `docker compose up -d --force-recreate caddy`.
#
# NOTE: consumers that dial the canonical endpoint by Docker DNS directly (OWUI, cognee,
# lightrag, agents) bypass Caddy and are not covered by this ingress cap.
LLM_MAX_CONCURRENT=100000
LLM_MAX_CONCURRENT_WINDOW=1s

# ------------------------------------------------------------------------------
# Mac LLM gateway (profile: mac-llm) — opt-in, OFF by default (2026.08)
# ------------------------------------------------------------------------------
# A LiteLLM proxy (llm-mac-gateway) that fronts one-or-more Macs running Ollama
# (Apple-Silicon / MLX) as a SECOND OpenAI-compatible endpoint, load-balanced +
# health-checked. GPUStack is UNTOUCHED. Enable by adding `mac-llm` to
# COMPOSE_PROFILES AND creating modules/llm/mac-gateway/config.yaml (copy
# config.example.yaml and declare your Macs). See modules/llm/mac-gateway/README.md.
#
# MAC_GATEWAY_MASTER_KEY: stack components authenticate to the gateway with this.
#   REQUIRED when mac-llm is enabled — generate a strong random secret.
# MAC_GATEWAY_PORT: loopback host-side port for operator debug (127.0.0.1 only);
#   in-network consumers use llm-mac-gateway:4000 via Docker DNS.
# LITELLM_VERSION: pinned LiteLLM image tag (ghcr.io/berriai/litellm:<tag>).
#   Repin to a reviewed tag / @sha256 digest at ship (security review).
MAC_GATEWAY_MASTER_KEY=
MAC_GATEWAY_PORT=4000
LITELLM_VERSION=main-v1.83.7-stable

# ==============================================================================
# OPENWEBUI CONFIGURATION
# ==============================================================================
WEBUI_URL=https://${OPENWEBUI_DOMAIN}
OLLAMA_BASE_URL= # Blank for OpenAI compatible API usage via GPUStack
# Open WebUI OpenAI-compatible endpoints (2026.08). OWUI takes a ;-separated
# list of base URLs paired 1:1 with keys. GPUStack is always endpoint #1; when
# the `mac-llm` profile is enabled, append the Mac gateway as endpoint #2:
#   OWUI_OPENAI_BASE_URLS=http://llm:8080/v1;http://llm-mac-gateway:4000/v1
#   OWUI_OPENAI_KEYS=${LLM_MANAGER_OWUI_KEY};${MAC_GATEWAY_MASTER_KEY}
# Defaults keep the manager-only wiring (#1445: the canonical endpoint) — the
# gateway is unreachable unless mac-llm is on). The P2 Config Portal toggle
# writes these automatically.
OWUI_OPENAI_BASE_URLS=http://llm:8080/v1
# Left EMPTY on purpose: docker-compose does NOT recursively expand a .env value, so
# `${GPUSTACK_API_KEY}` here would reach Open WebUI as a LITERAL string and break auth
# (GPUStack 401 -> "no models"). razzfazz-post-install.sh resolves this to the live
# GPUStack key (both fresh + --refresh); the mac-llm / Config Portal toggle may override
# with a multi-backend "gpustack;mac" combo.
OWUI_OPENAI_KEYS=
# #320: service keys for the llm-manager line, minted by post-install when the
# llm-manager profile is active (docker exec into the manager; cost-centres
# stack/openwebui + stack/dify so chargeback separates the consumers). Empty =
# not yet wired. NEVER paste a personal rzfz-sk here.
LLM_MANAGER_OWUI_KEY=
LLM_MANAGER_DIFY_KEY=
# EXO-13/CFG-14: the Configuration Portal's OWN read-only key (cost centre
# stack/config-portal), minted by the same post-install step. Keeps the admin
# dashboard's reads out of the OWUI tenant's usage series, keeps the panel
# alive across an OWUI key rotation, and — minted with NO allowed_models —
# makes the panel show what the BOX serves rather than what a possibly
# model-restricted consumer key may see (#329). Empty = not yet wired; the
# portal then falls back to the OWUI/Dify key with the old caveats.
LLM_MANAGER_CONFIG_KEY=
# #320: RAG embedding seam — override BOTH to move OWUI RAG off GPUStack
# (e.g. to http://llm-manager:8080/v1 + a service key). Empty = GPUStack.
OWUI_RAG_OPENAI_BASE_URL=
OWUI_RAG_OPENAI_KEY=
# #245: OTLP endpoint injected into every PERSONAL AGENT instance while the
# observability profile is active (post-install manages it — empty when the
# profile is off, so agents never dial a dead collector).
OBSERVABILITY_OTEL_AGENTS_ENDPOINT=
# Open WebUI ships fast (multiple 0.9.x patches per week). The default
# in-app "update available" banner pings GitHub on every page load and
# is noise for fleets that pin OPENWEBUI_VERSION via this .env. Disable
# the version-check call + the banner stack-wide. Operators who want to
# track upstream releases can flip back to true on their own .env.
ENABLE_VERSION_UPDATE_CHECK=false

# ==============================================================================
# GOOGLE OAUTH (Scenario: google)
# ==============================================================================
# Set to true when using --scenario google, false for --scenario base
ENABLE_GOOGLE_OAUTH=false
# Derived: set to true when ENABLE_GOOGLE_OAUTH or ENABLE_OPENWEBUI_OIDC is true.
# Controls ENABLE_OAUTH_SIGNUP in Open WebUI — allows new users to register via OAuth/OIDC.
# Managed automatically by razzfazz-init.sh. Do not set manually.
# #659: on an SSO box OAuth signup is SAFE — the OAuth callback is only
# reachable AFTER an Authentik forward_auth login (plus the IdP's own
# domain binding), so the ga.1 hardening posture (native form closed)
# holds; without it every NEW employee 403s on their first SSO login.
# Reconciled on every upgrade too (reconcile_owui_oauth_signup).
ENABLE_OAUTH_SIGNUP=false
# #659: role for OAuth-auto-created users. init/upgrade set 'user' on SSO
# boxes (otherwise the auto-created user is 'pending' and waits for an
# admin — the second half of the first-login trap). Empty = OWUI default.
OWUI_DEFAULT_USER_ROLE=
# Set by razzfazz-init.sh --scenario google (interactive prompt or --google-client-id / --google-client-secret)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Restrict Google OAuth to specific domain (e.g., seqis.com)
GOOGLE_OAUTH_DOMAIN=seqis.com

# ==============================================================================
# MICROSOFT ENTRA ID OAUTH (SSO)
# ==============================================================================
# Enable Microsoft Entra ID (formerly Azure AD) as a second SSO source.
# Can be enabled independently of or alongside ENABLE_GOOGLE_OAUTH.
# Requires an App Registration in Microsoft Entra ID (Azure Portal):
#   - Redirect URI: https://auth.<domain>/source/oauth/callback/entra/
#   - API permissions: openid, profile, email
#   - Single-tenant: set ENTRA_TENANT_ID to your Directory (tenant) ID
ENABLE_ENTRA_OAUTH=false
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
# Optional: restrict enrollment to accounts with this email domain.
# Leave empty to allow all accounts from the configured tenant.
# Useful for blocking guest/B2B accounts that exist in your tenant.
ENTRA_OAUTH_DOMAIN=

# ==============================================================================
# NATIVE OIDC — Open WebUI & Gitea (via Authentik)
# ==============================================================================
# When enabled, Open WebUI / Gitea authenticate natively via Authentik OIDC
# and auto-provision users on first login. Caddy forward-auth is retained
# as a defense-in-depth outer layer.
# Client ID/Secret are auto-seeded by razzfazz-init.sh (#30): the init's
# secret-generation step sets OPENWEBUI_OIDC_CLIENT_ID=openwebui_oidc_client and
# a random OPENWEBUI_OIDC_CLIENT_SECRET. They feed BOTH the Authentik
# openwebui-oidc blueprint (the provider) and the Open WebUI container env. Set
# ENABLE_OPENWEBUI_OIDC=true to activate native SSO login (removes OWUI's second
# login). init-authentik.sh applies the blueprint only when both are non-empty.
# #70: defaults TRUE so a fresh box has working native OIDC out of the box —
# the openwebui-oidc Authentik app + provider exist, OWUI's "Continue with
# Authentik" button resolves (was 404 on clean install), and discovery is
# fetched over the live Caddy CA (#55). Caddy forward-auth remains the
# defense-in-depth outer gate. Creds are seeded unconditionally below, so the
# blueprint gate is satisfied on every clean init.
ENABLE_OPENWEBUI_OIDC=true
OPENWEBUI_OIDC_CLIENT_ID=openwebui_oidc_client
OPENWEBUI_OIDC_CLIENT_SECRET=

# Gitea native OIDC against Authentik (#29). Client ID/Secret are auto-seeded by
# razzfazz-init.sh: GITEA_OIDC_CLIENT_ID=gitea_oidc_client + a random
# GITEA_OIDC_CLIENT_SECRET. They feed the Authentik gitea-oidc blueprint and
# modules/gitea/init-gitea.sh (`gitea admin auth add-oauth --auto-discover-url
# …/gitea-oidc/…`). Set ENABLE_GITEA_AUTHENTIK_OIDC=true to activate the
# "Sign in with Authentik" button; Gitea auto-registers the OIDC user on first
# login. init-authentik.sh applies the blueprint only when both are non-empty.
# #70: defaults TRUE (see ENABLE_OPENWEBUI_OIDC) — on a fresh box init-gitea.sh
# runs `gitea admin auth add-oauth` so the "Sign in with Authentik" button is
# wired (was 404 on clean install) and the gitea-oidc Authentik app exists.
ENABLE_GITEA_AUTHENTIK_OIDC=true
GITEA_OIDC_CLIENT_ID=gitea_oidc_client
GITEA_OIDC_CLIENT_SECRET=
# Derived by razzfazz-init.sh: true when Google OAuth OR Authentik OIDC is
# enabled. Gates Gitea's GITEA__oauth2_client__ENABLE_AUTO_REGISTRATION so SSO
# users self-provision on first login.
GITEA_OAUTH_AUTO_REGISTER=false

# ------------------------------------------------------------------------------
# TRUE SSO — group -> in-app role mapping (#33)
# ------------------------------------------------------------------------------
# The 4 native-OIDC apps (Open WebUI, Gitea, Matrix/Synapse, Vaultwarden)
# auto-provision the SSO user on first login, but everyone historically landed
# as a plain "user". This maps an Authentik GROUP -> the app's admin role via
# each app's native OIDC group-claim mechanism. Authentik emits the user's group
# names as a `groups` claim (core/Authentik/blueprints/base/06-oauth-groups-scope.yaml).
#
# SSO_ADMIN_GROUP is the Authentik group whose members become in-app ADMINS.
# It reuses the existing tier/group model — do NOT hardcode a user. Default is
# the superuser group seeded by 02-groups.yaml.
SSO_ADMIN_GROUP=razzfazz.ai Super Admins
#
# Open WebUI role management. When true, OWUI derives each user's role from their
# Authentik groups on EVERY OIDC login: admin if in OAUTH_ADMIN_ROLES, user if in
# OAUTH_ALLOWED_ROLES, else denied. Fresh installs default ON — the seeded admin
# (akadmin) is in "razzfazz.ai Super Admins", so it maps to admin with no lockout.
# NOTE: the UPGRADE migration (migrations/env-changes.json) adds this as FALSE on
# existing boxes, because turning it on re-evaluates existing users and would
# demote an OWUI admin who is NOT in SSO_ADMIN_GROUP. On upgrade, flip to true
# only after confirming your operator account is in "razzfazz.ai Super Admins".
ENABLE_OWUI_OAUTH_ROLE_MANAGEMENT=true
# Groups (comma-separated) allowed to sign in to Open WebUI as regular users.
# Members of SSO_ADMIN_GROUP additionally get admin (OAUTH_ADMIN_ROLES).
OWUI_OAUTH_ALLOWED_ROLES=razzfazz.ai Chat Users,razzfazz.ai Super Admins
# Gitea maps SSO_ADMIN_GROUP -> Gitea site admin automatically via its OIDC
# source (--admin-group + --group-claim-name groups) — no separate toggle;
# always active whenever ENABLE_GITEA_AUTHENTIK_OIDC=true.
#
# Matrix/Synapse and Vaultwarden: OIDC group->admin-ROLE is NOT supported by
# these apps in their stable configs (Synapse server-admin is a DB/admin-API
# flag; Vaultwarden's admin panel is a shared ADMIN_TOKEN). The `groups` claim
# is emitted for them anyway; elevate their admins manually. See PR / brief.

# ==============================================================================
# AUTHENTIK CONFIGURATION
# ==============================================================================
# Generated by razzfazz-init.sh — do not use example values in production
# #1148 (operator decision 2026-09-02): the Authentik superuser is called
# `rzfz-admin` on NEW installations. Authentik knows no bootstrap username —
# it always creates `akadmin` — so init renames it once, right after the
# bootstrap; the primary key survives, so every OIDC link (which maps by sub /
# e-mail) stays intact.
#
# Why not `razzfazz-ai-admin`: that is also the LINUX user on the boxes, and a
# host login would be indistinguishable from an SSO login in the audit trail.
#
# An EXISTING box keeps `akadmin`: the migration writes that value, not this
# one. Per-user resources are username-slug-keyed (agent containers
# `agent-<type>-akadmin-…`, MCP instances), so an automatic rename would orphan
# them. docs/walkthroughs/rename-the-authentik-superuser.md has the manual path.
RAZZFAZZ_ADMIN_USERNAME=rzfz-admin
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_TOKEN=

# SMTP / Email — passed through to Authentik (internal relay, no credentials needed)
AUTHENTIK_EMAIL__HOST=smtp-relay
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=
AUTHENTIK_EMAIL__USE_TLS=false
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__FROM=${SMTP_FROM:-noreply@${MAIN_DOMAIN}}
AUTHENTIK_EMAIL__TIMEOUT=10

# B-11 — Tighter MFA policy default (NIS2 21(2)(j)).
# When `true` (the default for new installs), the shipped Authentik
# blueprint `core/Authentik/blueprints/base/07-mfa-policy.yaml` enables
# the `razzfazz.ai - Require Admin MFA` PolicyBinding, which gates the
# default-authentication-flow's MFA-validation stage on Super Admins
# group membership. Combined with the upstream stage's
# `not_configured_action: configure`, every member of `razzfazz.ai
# Super Admins` (akadmin + any operator-promoted admin) is force-walked
# through TOTP / WebAuthn / Static enrolment on their next login if
# they don't yet have an authenticator registered. Non-admin users
# (customer end-users / per-app-group users) are unaffected.
#
# Set to `false` to disable the policy WITHOUT removing the blueprint
# (so flipping back to `true` later doesn't recreate IDs).
#
# Existing installs (upgrade path): this var is NOT auto-added to the
# customer's `.env` by `razzfazz-upgrade.sh` — the operator decides
# post-handover whether to opt in. New installs land with the default
# (`true`) baked in.
RAZZFAZZ_REQUIRE_ADMIN_MFA=true

# Options: 'base' or 'google' (set by razzfazz-init.sh --scenario)
DEPLOYMENT_SCENARIO=base

# Secrets referenced in blueprints (Best Practice)
# Authentik proxy provider client secrets (generated by razzfazz-init.sh)
CHAT_CLIENT_SECRET=

# ==============================================================================
# SMTP RELAY CONFIGURATION
# ==============================================================================
# Centralized SMTP relay for all services (Authentik, Dify, Gitea, OpenWebUI).
# All services send to the internal smtp-relay container on port 587.
# The relay can either send directly or forward to an external SMTP provider.
#
# SMTP_MODE: "relay" or "direct"
#   relay  = Forward through external SMTP provider (recommended for deliverability)
#   direct = Send directly to recipient MX servers (requires SPF/DKIM/DMARC DNS records)
SMTP_MODE=relay

# Internal SASL password for Docker-internal SMTP relay (generated by razzfazz-init.sh)
# Used by services that require SMTP authentication (e.g., Dify email plugin)
SMTP_INTERNAL_PASSWORD=

# Sender address used by all services
SMTP_FROM=razzfazz-ai-box-1@${MAIN_DOMAIN}
# #2004: the DNS names the relay's own STARTTLS certificate is minted for.
# Every consumer in this stack dials the container name `smtp-relay`; this
# exists so an operator who reaches the relay under another name does not have
# to patch a script. Space- or comma-separated; the certificate is re-minted
# automatically when a name is added.
#
# Why the relay has a certificate at all: it used to present Debian's snakeoil
# (CN=localhost), so a client that verifies could not talk to it. Six modules
# turned TLS off, Infisical turned certificate verification off for its whole
# Node process, and OpenUEM — whose mail client verifies unconditionally — could
# do neither and simply could not send.
SMTP_TLS_NAMES=smtp-relay

# Allowed sender domains for the SMTP relay container
# Add additional domains if SMTP_FROM uses a different domain than MAIN_DOMAIN
# SMTP_ALLOWED_SENDER_DOMAINS=${MAIN_DOMAIN} otherdomain.com

# --- Relay Mode Settings (only used when SMTP_MODE=relay) ---
# External SMTP provider credentials
# For Google Workspace SMTP Relay (IP-based auth): smtp-relay.gmail.com
# For Gmail with App Password: smtp.gmail.com
# For Mailgun/Brevo/SendGrid: use their SMTP credentials
SMTP_RELAY_HOST=smtp-relay.gmail.com
SMTP_RELAY_PORT=587
SMTP_RELAY_USERNAME=
SMTP_RELAY_PASSWORD=

# --- Direct Mode Settings (only used when SMTP_MODE=direct) ---
# DKIM signing (optional but strongly recommended for direct mode)
# Generate: opendkim-genkey -s mail -d yourdomain.com
# SMTP_DKIM_SELECTOR=mail
# SMTP_DKIM_PRIVATE_KEY_FILE=/etc/opendkim/keys/mail.private

# ==============================================================================
# KOMODO CONFIGURATION
# ==============================================================================
# ga.1 (Issue F): Komodo 2.2.0 validates incoming requests against KOMODO_HOST.
# Behind Caddy the external Host is admin.<domain>, so localhost mismatched → HTTP 400.
# Point it at the external URL Komodo is actually reached on.
KOMODO_HOST=https://${KOMODO_DOMAIN}
KOMODO_TITLE=razzfazz.ai Services Stack
KOMODO_DB_TYPE=mongodb
KOMODO_DATABASE_URI=mongodb://${POSTGRES_USER}:${POSTGRES_PASSWORD}@ferretdb:27017/komodo?authSource=admin
KOMODO_FIRST_SERVER=https://komodo-periphery:${KOMODO_PERIPHERY_PORT}
KOMODO_FIRST_SERVER_NAME=Local
KOMODO_LOCAL_AUTH=true
# Per-service admin password (generated by razzfazz-init.sh, unique per service)
KOMODO_INIT_ADMIN_USERNAME=admin
KOMODO_INIT_ADMIN_PASSWORD=

# ==============================================================================
# BACKUP CONFIGURATION
# ==============================================================================
BACKUP_CRON_EXPRESSION="0 3 * * *"
BACKUP_FILENAME="backup-%Y-%m-%d-%H%M.tar.gz"
BACKUP_RETENTION_DAYS="7"
# Where offen builds the temporary archive. offen writes the archive (and, with
# encryption, the .gpg) to a HARDCODED /tmp inside the backup container — it does
# NOT honor TMPDIR — so /tmp is a mount. Leave EMPTY (default) on boxes with a
# large root/OS disk: a named docker volume (backup-tmp) on the root disk is used.
# On a box whose root disk is small and the backup archive lives on a SEPARATE
# disk, set this to a host path ON that backup disk (e.g. the dir that holds the
# backups), so the ~2x-archive-size temp build never pressures root and can't
# trigger a disk-full -> postgres crash-loop. Example:
#   BACKUP_TMP_DIR=/home/<user>/razzfazz-ai-service-stack/backups/.offen-tmp
BACKUP_TMP_DIR=""
# Include LLM/TTS model files (gpustack-data, speaches-data, and since #1450 the
# LLM Manager's llm-node-models + llm-registry-data) in backups?
# "false" (default): exclude model files — saves significant disk space
# "true": include model files in every backup
BACKUP_INCLUDE_MODEL_FILES="false"
# Exclude the dify-plugin-daemon volume from backups?
# "false" (default): the volume IS backed up.
# "true": skip it — Dify plugin data is re-downloadable and can grow large.
# The Configuration Portal (Backup → Settings) toggles this and derives
# BACKUP_EXCLUDE_REGEXP below from it together with BACKUP_INCLUDE_MODEL_FILES.
BACKUP_EXCLUDE_DIFY_PLUGINS="false"
# Regex pattern for volumes to exclude from backup (used by offen/docker-volume-backup)
# DERIVED from BACKUP_INCLUDE_MODEL_FILES + BACKUP_EXCLUDE_DIFY_PLUGINS by the
# Configuration Portal — edit those toggles rather than this line by hand.
#
# #182: the physical DB datadirs — postgres-data, valkey-data,
# postgres-komodo-data — are ALWAYS excluded. They are captured LOGICALLY by
# core/backup/pre-backup.sh (pg_dumpall → databases/postgres_core.sql +
# postgres_komodo.sql; valkey SAVE), which is what restore imports. Excluding
# the live datadirs means offen never tars a churning pg_wal (the
# `lstat …/pg_wal/…: no such file` race that silently killed the whole
# nightly + upgrade backup, #157), so postgres NO LONGER has to be stopped
# during the archive — no more ~24 s nightly DB-unavailability blip. The
# Configuration Portal re-appends these three datadirs on every settings save,
# so they can never be toggled back in by accident. IF you ever re-add
# postgres-data / postgres-komodo-data to the tar, you MUST also restore the
# `docker-volume-backup.stop-during-backup=true` label on those services
# (see core/compose.yml) or the pg_wal race returns.
# #139 (prod postmortem 2026-06-18): REGENERABLE caches are excluded by
# default too — onyx model caches + vespa index, clickhouse observability
# data, the help-UI cache, and dify's sandbox pip cache re-derive themselves
# on the next run and were re-archiving ~40 GB into every nightly tar.
# Remove a token here if you explicitly want it archived; the settings UIs
# preserve any hand-edited token on save (they reconcile, never rebuild).
# Default (models excluded, dify plugins kept, regenerable caches excluded):
BACKUP_EXCLUDE_REGEXP="gpustack-data|speaches-data|llm-node-models|llm-registry-data|postgres-data|valkey-data|postgres-komodo-data|clickhouse-data|help-cache|dify-sandbox-dependencies|onyx-model-cache|onyx-indexer-model-cache|onyx-vespa-data"
# Password used to encrypt backup archives (GPG). Set by razzfazz-init.sh to
# AUTHENTIK_BOOTSTRAP_PASSWORD so the customer can decrypt using the sticker
# on the box — losing the admin password also loses backup decryption.
BACKUP_ENCRYPTION_PASSWORD=

# ==============================================================================
# ADDITIONAL SECRETS (generated by razzfazz-init.sh)
# ==============================================================================
DIFY_CLIENT_SECRET=
ADMIN_CLIENT_SECRET=
LLM_CLIENT_SECRET=
BACKUP_CLIENT_SECRET=
GITEA_CLIENT_SECRET=
# Authentik proxy provider secrets for Licenses, Help UIs
# (#22) SETUP_CLIENT_SECRET removed — setup.<domain> app retired in 2026.07.
LICENSES_CLIENT_SECRET=
HELP_CLIENT_SECRET=
# #386 (F-P4-12): Config Portal proxy provider — generated at init/upgrade.
CONFIG_CLIENT_SECRET=

ACME_EMAIL=
GPUSTACK_SECRET_KEY=
KOMODO_PASSKEY=

# Per-service admin passwords (generated by razzfazz-init.sh, each unique)
# Dify admin password (max 30 characters)
DIFY_ADMIN_PASSWORD=
# Cognee default user password
COGNEE_ADMIN_PASSWORD=
# Cognee API key for the cognee-mcp sidecar (M033 S12) — minted post-install
# from cognee /api/v1/auth/api-keys. Lets MCP agents (Moltis/Hermes) use cognee
# as memory via http://cognee-mcp:8000/mcp. Empty → sidecar can't authenticate.
COGNEE_MCP_API_KEY=
# #36 two-tier Cognee memory: enable backend access control + auth enforcement.
# When true (default), the Cognee backend requires auth on /api/* and scopes
# datasets per user — required for TRULY isolated "Personal Memory (private)"
# MCP integrations (the mcp-manager fail-closes personal cognee provisioning
# when this is off, so no isolation is ever faked). All in-stack callers already
# authenticate, so this does not break them. Set false only for a deliberate
# single-tenant box.
COGNEE_ACCESS_CONTROL=true

# ==============================================================================
# PAPERLESS-NGX CONFIGURATION [EXPERIMENTAL]
# ==============================================================================
# Self-hosted document management — scan, OCR, archive, and search documents.
# Reuses existing gotenberg and tika containers for Office doc + metadata support.
# Upstream: https://github.com/paperless-ngx/paperless-ngx (GPL-3.0)
# User-facing at https://paperless.${MAIN_DOMAIN}
PAPERLESS_PORT=8001
PAPERLESS_DOMAIN=paperless.${MAIN_DOMAIN}
PAPERLESS_DB=paperless_db
PAPERLESS_SECRET_KEY=
PAPERLESS_OCR_LANGUAGE=eng+deu
PAPERLESS_CLIENT_SECRET=

# ==============================================================================
# VAULTWARDEN CONFIGURATION [EXPERIMENTAL]
# ==============================================================================
# Self-hosted Bitwarden-compatible password manager with Authentik OIDC SSO.
# Vault encryption is local (master password independent of SSO provider).
# Upstream: https://github.com/dani-garcia/vaultwarden (GPL-3.0)
# User-facing at https://vault.${MAIN_DOMAIN}
VAULTWARDEN_PORT=8222
VAULTWARDEN_DOMAIN=vault.${MAIN_DOMAIN}
VAULTWARDEN_DB=vaultwarden_db
# /admin is a shared-secret, user-agnostic server backdoor. Left EMPTY by default =
# panel DISABLED (Vaultwarden refuses to open it token-free). All admin work is done
# via Authentik SSO Org-Owner roles. To enable /admin for break-glass, set this to an
# Argon2 hash from `vaultwarden hash` (NOT a plaintext token — that's a config-leak = takeover).
VAULTWARDEN_ADMIN_TOKEN=
VAULTWARDEN_CLIENT_SECRET=
# Organization Groups (group-based collection access) — on by default so org Owners
# can grant collection permissions to groups instead of per-member. Set to "false" to
# hide the Groups feature. Vaultwarden's own default is off; the stack enables it.
VAULTWARDEN_ORG_GROUPS_ENABLED=true
# F-041: Set to "true" only when TLS_MODE=internal (self-signed certs)
# razzfazz-init.sh sets this based on TLS_MODE at install time
VAULTWARDEN_SSO_ACCEPT_INVALID_CERTS=false
# Email (#12): Vaultwarden has no MAIL_ENABLED toggle — mail is enabled purely by
# setting SMTP_HOST. EMPTY = mail off (default). Set to `smtp-relay` to route
# Vaultwarden email through the internal relay (SASL auth: mail@${MAIN_DOMAIN} /
# SMTP_INTERNAL_PASSWORD, reusing SMTP_FROM). Port/security are overridable below.
VAULTWARDEN_SMTP_HOST=
VAULTWARDEN_SMTP_PORT=587
VAULTWARDEN_SMTP_SECURITY=off

# ==============================================================================
# INFISICAL CONFIGURATION [EXPERIMENTAL]
# ==============================================================================
# Self-hosted secrets management for developers and AI agents.
# Agents (gsd-2, paperclip, openhands) use INFISICAL_API_URL + machine identity tokens.
# Upstream: https://github.com/Infisical/infisical (MIT)
# User-facing at https://infisical.${MAIN_DOMAIN}
INFISICAL_PORT=8888
INFISICAL_DOMAIN=infisical.${MAIN_DOMAIN}
INFISICAL_DB=infisical_db
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=
INFISICAL_CLIENT_SECRET=

# ==============================================================================
# ONYX (AI ENTERPRISE SEARCH) CONFIGURATION [EXPERIMENTAL]
# ==============================================================================
# AI-powered enterprise search across Gitea repos + paperless-ngx documents.
# Uses Gitea GitHub-compatible API as connector source.
# Upstream: https://github.com/onyx-dot-app/onyx (MIT)
# User-facing at https://onyx.${MAIN_DOMAIN}
ONYX_DOMAIN=onyx.${MAIN_DOMAIN}
ONYX_DB=onyx_db
ONYX_SECRET=
ONYX_CLIENT_SECRET=
# #170 — disable Qwen3 "thinking" for Onyx's own LLM calls ONLY. The stack's Onyx
# points at the GPUStack qwen3.6 model (llama-box runner), which defaults to
# thinking-mode and leaves Onyx's agentic answers empty. This JSON is forwarded by
# Onyx's LiteLLM as extra_body → chat_template_kwargs reaches llama-box (the runner
# ignores the vLLM enable_thinking flag). SCOPED TO ONYX: the shared qwen3.6 model
# is untouched, so OWUI / Dify / cognee / TARIC keep thinking ON. Set empty to opt
# out (e.g. if you point Onyx at a provider that rejects unknown body params).
ONYX_LITELLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# ==============================================================================
# OPENUEM (UNIFIED ENDPOINT MANAGEMENT) CONFIGURATION [EXPERIMENTAL]
# ==============================================================================
# Endpoint inventory, software deployment and remote assistance for the fleet.
# Endpoint agents run on the fleet's own machines and talk to the NATS broker
# below; the broker authenticates them with mutual TLS against OpenUEM's own CA.
# Upstream: https://github.com/open-uem (Apache-2.0)
# User-facing at https://openuem.${MAIN_DOMAIN}
OPENUEM_VERSION=0.12.0
OPENUEM_DOMAIN=openuem.${MAIN_DOMAIN}
OPENUEM_DB=openuem_db
OPENUEM_DB_USER=openuem_user
OPENUEM_DB_PASSWORD=
# Signs the console's registration/session JWTs. razzfazz-init.sh generates it
# (64 hex chars). Upstream's own example ships a hardcoded demo JWT key and its
# docs call replacing it "strongly recommended" — we ship no default at all, and
# a guard test asserts that upstream's demo literal appears nowhere in the repo.
OPENUEM_CONSOLE_JWT_KEY=
# Authentik forward-auth client secret; razzfazz-init.sh generates it.
OPENUEM_CLIENT_SECRET=
#
# --- PKI identity: IMMUTABLE AFTER FIRST START -------------------------------
# These five fields are written into every certificate subject AND into the NATS
# authorization DN table, from the same environment, in the same run. Changing
# any of them afterwards regenerates the broker's DN table while the existing
# certificates keep the old subjects — every component and every enrolled agent
# is then denied at the broker. To change them you must wipe the openuem-pki,
# openuem-nats-conf and openuem-certs-* volumes and re-enrol every agent.
OPENUEM_ORGNAME=razzfazz.ai
OPENUEM_ORGPROVINCE=Wien
OPENUEM_ORGLOCALITY=Wien
# Empty on purpose — matches upstream's tested .env-example shape.
OPENUEM_ORGADDRESS=
OPENUEM_ORGCOUNTRY=AT
#
# --- NATS broker (agents <-> server) -----------------------------------------
# Endpoint agents dial ${OPENUEM_NATS_HOST}:${OPENUEM_NATS_PORT}. The name must
# resolve for them (your DNS, or a hosts entry) AND is a SAN on the broker's
# certificate, so do not change it after the PKI has been generated.
OPENUEM_NATS_HOST=openuem-nats.${MAIN_DOMAIN}
OPENUEM_NATS_PORT=4433
# SECURITY: loopback by default (single box, no remote agents). To serve agents
# on other machines, set this to a SPECIFIC LAN IP of this box — NEVER 0.0.0.0.
# What protects the open port is the broker's own configuration, not obscurity:
# the generated nats.cfg sets verify_and_map: true (a client must present a
# certificate chaining to this module's CA, and its subject DN is mapped to a
# NATS user) plus ocsp_peer: true (checked against the responder below on every
# connect), with a per-DN publish/subscribe allow-list. There is no anonymous
# path onto this port.
OPENUEM_NATS_HOST_BIND=127.0.0.1
#
# --- OCSP responder ----------------------------------------------------------
# Every certificate this module issues embeds
# http://${OPENUEM_OCSP_HOST}:${OPENUEM_OCSP_PORT} as its revocation-check URL.
OPENUEM_OCSP_HOST=openuem-ocsp.${MAIN_DOMAIN}
OPENUEM_OCSP_PORT=8202
# SECURITY: loopback by default. Open it only together with the NATS port, and
# only to a SPECIFIC LAN IP — NEVER 0.0.0.0. OCSP is unauthenticated by design
# (RFC 6960): a read-only revocation oracle that accepts no state-changing
# request and discloses only whether a certificate serial is known/revoked.
OPENUEM_OCSP_HOST_BIND=127.0.0.1
#
# --- Break-glass -------------------------------------------------------------
# Set to "true" for ONE start to regenerate the built-in `openuem` console
# account's password (printed to the openuem-console container log), then set it
# back to empty. See docs/enterprise/how-to/openuem.md.
OPENUEM_RESET_OPENUEM_USER=
#
# --- Email: the stack's mail configuration, not a second setup ---------------
# OpenUEM keeps its SMTP settings NOT in the environment but in openuem_db
# (table `settings`, the global row). The console writes them through its SMTP
# form and openuem-worker-notification reads that same row. So `rzfz
# post-install` seeds that row from the values here, and the module inherits the
# box's mail configuration instead of asking for it a second time (#1992).
# Seeded ONLY while the console still holds no SMTP server - an entry the
# operator typed themselves is never overwritten.
# The sender is ${SMTP_FROM}, and that is load-bearing: the relay's
# ALLOWED_SENDER_DOMAINS is ${MAIN_DOMAIN} and it refuses anything else.
# EMPTY = do not seed at all (the operator enters their own server), the same
# meaning VAULTWARDEN_SMTP_HOST has.
OPENUEM_SMTP_HOST=smtp-relay
OPENUEM_SMTP_PORT=587
#
# --- Egress note (not a knob) ------------------------------------------------
# openuem-console contacts https://releases.openuem.eu every 6 hours to check
# for new agent/server releases and DOWNLOADS agent installer binaries from
# there. Upstream exposes no switch to disable it. On an offline box it logs
# "[ERROR]: could not get latest agent releases" and retries every 2 minutes;
# everything else (inventory, deployment of already-present packages, remote
# assistance) keeps working. openuem-console is registered in the corporate-
# proxy egress allow-list so a TLS-intercepting box gets the CA.

# ==============================================================================
# WAZUH CONFIGURATION [EXPERIMENTAL]
# ==============================================================================
# Security monitoring (SIEM/XDR) — host intrusion detection, file-integrity
# monitoring, log correlation, CIS/NIST/PCI compliance mappings. Three
# containers (manager/indexer/dashboard) + four one-shots + a per-box
# wazuh-agent (scripts/install-wazuh-agent.sh).
# Upstream: https://github.com/wazuh/wazuh (server GPL-2.0; indexer + dashboard
#           are OpenSearch forks, Apache-2.0)
# User-facing at https://wazuh.${MAIN_DOMAIN}
WAZUH_VERSION=4.14.7
# 8203, not 8202: OPENUEM_OCSP_PORT already claims 8202 (#1075). 8203 is the
# next free slot in the 8200-8299 band.
WAZUH_DASHBOARD_PORT=8203
WAZUH_DOMAIN=wazuh.${MAIN_DOMAIN}

# Dashboard authentication. `forward_auth` (default, #2191): Caddy's Authentik
# gate is the single sign-on at the edge, and inside the dashboard you sign in
# once more with the local admin (`admin` + WAZUH_INDEXER_PASSWORD). `native_oidc`
# additionally configures the OpenSearch-Dashboards security plugin against
# Authentik for a real per-user identity inside Wazuh — EXPERIMENTAL: its
# callback loops on 401 (#1940, 2026.10); do not set it on a box you need.
WAZUH_AUTH_MODE=forward_auth

# SECURITY: standalone (single-box, no remote agents) defaults to loopback.
# A real multi-box fleet operator pins a specific LAN IP here (NEVER a
# wildcard address) so wazuh-agent on other boxes can enrol/report. The bind is
# NOT the authenticator: enrolment requires WAZUH_AUTHD_PASSWORD and every
# listener is <allowed-ips>-fenced. See DECISION-4 in the implementation plan.
WAZUH_MANAGER_HOST_BIND=127.0.0.1
WAZUH_MANAGER_EVENTS_PORT=1514
WAZUH_MANAGER_ENROLL_PORT=1515

# SECURITY: plain syslog is UNAUTHENTICATED whatever it runs over — its bind is
# separate on purpose, so widening the agent ports for a fleet does not drag
# the syslog listener onto the LAN with them. The listener is 514/TCP (the otel
# syslog exporter that feeds the #253 seam speaks TCP only). Note 514 is the
# well-known syslog port and is commonly already bound on a host by rsyslog;
# check with `sudo lsof -iTCP:514 -sTCP:LISTEN` before changing this.
WAZUH_SYSLOG_HOST_BIND=127.0.0.1
WAZUH_MANAGER_SYSLOG_PORT=514

# Extra CIDRs allowed to reach the manager's 1514 agent event channel,
# comma-separated (e.g. "192.168.0.0/24"). #1537: this does NOT cover the 1515
# enrolment port — wazuh-authd refuses an <allowed-ips> element inside <auth>
# and the manager then refuses to start, so 1515 is fenced by
# WAZUH_MANAGER_HOST_BIND and the authd password alone.
# Empty = loopback + the docker bridge only. Values are shape-validated; a
# default route or anything that is not a CIDR is rejected by the render
# script.
WAZUH_ALLOWED_IPS=

# Agent auto-enrolment (#1874). SECURITY: ships OFF. Turning it ON makes THIS
# box's host enrol its own wazuh-agent at `rzfz post-install` (and on every
# --refresh/upgrade, which is the how-to's "re-run after every upgrade"), so a
# fresh master/worker appears in Wazuh automatically — monitoring journald,
# host FIM, and the allow-listed container logs below. It enlarges the SIEM
# enrolment surface (and a fleet manager may need a LAN-facing
# WAZUH_MANAGER_HOST_BIND), so the default is OFF and flipping it is an explicit
# operator act gated by the release security assessment. Needs
# WAZUH_AUTHD_PASSWORD and root (apt).
WAZUH_AGENT_AUTO_ENROLL=false
# The manager this box's agent enrols against. Empty = 127.0.0.1 when this box
# runs the wazuh manager itself (the `wazuh` profile is enabled here); a worker
# with no local manager MUST set the fleet manager's LAN address here.
WAZUH_AGENT_MANAGER_ADDRESS=
# Comma-separated container NAMES whose stdout the agent ships (the stack's
# Docker-security surface — container logs, not the docker-listener socket).
# Empty = a sensible core set (caddy,postgres,authentik-server).
WAZUH_AGENT_CONTAINERS=

# Cloud security — AWS S3 log ingestion (#1874 part 4). Empty bucket = OFF.
# Set WAZUH_AWS_S3_BUCKET to your CloudTrail (or other) log bucket to have the
# manager ingest it. Credentials are NOT set here: the wazuh aws-s3 wodle uses
# the standard AWS credential chain via WAZUH_AWS_PROFILE (inline access/secret
# keys were DEPRECATED in Wazuh 4.4) — an IAM instance role on a cloud VM needs
# nothing; otherwise mount ~/.aws/credentials into wazuh-manager and name the
# profile here. So no secret ever lands in the rendered manager config.
# SECURITY: the default flip (enabling cloud ingestion) rides the release
# security assessment like the other wazuh enrolment surfaces.
WAZUH_AWS_S3_BUCKET=
WAZUH_AWS_S3_LOG_TYPE=cloudtrail
WAZUH_AWS_REGION=
WAZUH_AWS_PROFILE=

# (#2002) Alert mail. ON whenever a recipient exists (RAZZFAZZ_OPERATOR_EMAIL,
# else ADMIN_CONTACT_EMAIL): the manager mails every alert at or above this
# level to it via smtp-relay:25, sender SMTP_FROM. 12 = "someone should look
# now" (rootcheck hits, FIM on /var/ossec, agent gone silent, docker exec into
# a container). <log_alert_level> stays 3 — this is the mail threshold only.
WAZUH_EMAIL_ALERT_LEVEL=12

# SECURITY: the SAME for the UNAUTHENTICATED 514 syslog listener — deliberately
# a separate variable (#855 rev-B). Widening the agent ports for a fleet must
# not silently open the one listener with no authenticator: anything inside the
# range below can inject forged events into your SIEM. Empty = loopback + the
# docker bridge only (which is what the #253 otel seam needs, and nothing more).
WAZUH_SYSLOG_ALLOWED_IPS=

# Secrets — generated per box by cli/init.sh and backfilled by cli/upgrade.sh
# (_gen_if_empty, profile-scoped "wazuh"). They are NOT optional: without them
# the module refuses to render, because the alternative is Wazuh's published
# demo credentials surviving on a real box.
#   WAZUH_INDEXER_PASSWORD    indexer `admin` account (bcrypt-hashed into
#                             internal_users.yml at container start)
#   WAZUH_DASHBOARD_PASSWORD  indexer `kibanaserver` service account
#   WAZUH_API_PASSWORD        manager API user `wazuh-wui`
#   WAZUH_AUTHD_PASSWORD      agent-enrolment shared secret (authd.pass)
#   WAZUH_CLIENT_SECRET       Authentik forward-auth ProxyProvider secret; this
#                             is the layer that makes wazuh.<domain> answer at
#                             all (37-wazuh.yaml, app slug `wazuh`)
#   WAZUH_OIDC_CLIENT_SECRET  Authentik OIDC client secret for the dashboard's
#                             own login (37-wazuh.yaml, app slug `wazuh-oidc`)
# The two Authentik secrets are separate on purpose — same split as Gitea's
# GITEA_CLIENT_SECRET / GITEA_OIDC_CLIENT_SECRET.
WAZUH_INDEXER_PASSWORD=
WAZUH_DASHBOARD_PASSWORD=
WAZUH_API_PASSWORD=
WAZUH_AUTHD_PASSWORD=
WAZUH_CLIENT_SECRET=
WAZUH_OIDC_CLIENT_ID=wazuh
WAZUH_OIDC_CLIENT_SECRET=

# ==============================================================================
# OPENHANDS CONFIGURATION [EXPERIMENTAL]
# ==============================================================================
# AI coding agent — spawns sandboxed agent-server containers per task.
# Requires Docker socket (documented risk, see DECISIONS.md D016).
# Upstream: https://github.com/All-Hands-AI/OpenHands (MIT)
# User-facing at https://openhands.${MAIN_DOMAIN}
OPENHANDS_VERSION=1.6.0
OPENHANDS_PORT=3003
OPENHANDS_DOMAIN=openhands.${MAIN_DOMAIN}
OPENHANDS_CLIENT_SECRET=

# ==============================================================================
# CODING TOOLS (gsd-pi + opencode-ai) — npm package pins
# ==============================================================================
# Build-time args for the razzfazz-coding-tools custom image (built once into
# `razzfazz-coding-tools:latest`, then provisioned per-user by agent-manager).
# Pinned for reproducibility — bump via the check-and-bump-versions skill.
OPENCODE_VERSION=1.18.25
# #36 coding-agent split — OpenAI Codex CLI (Apache-2.0) pin for the codex image.
CODEX_VERSION=0.151.0
# (M020 S07) CODING TOOLS global config removed — coding-tools is now per-user
# via agent-manager. Per-user gsd --web is at coding-tools-<slug>.${AGENTS_DOMAIN};
# opencode serve runs internal-only on the same per-user container at port 4096
# (consumed by modules/chat/functions/opencode_pipe.py via Docker DNS, not exposed).
# Per-instance OPENCODE_SERVER_PASSWORD is generated by the provisioner.
# ==============================================================================

# ==============================================================================
# EXTRA SYSTEM (APT) PACKAGES FOR PER-USER AGENT IMAGES (#212)
# ==============================================================================
# The per-user agent sandboxes (coding-agent opencode/codex/user-defined, moltis,
# hermes) run NON-ROOT on a READ-ONLY root filesystem with NO sudo (hostile-
# container hardening). So `apt install` CANNOT work at runtime inside an agent.
# Userspace tools DO install sudo-less into the persistent home volume already —
# `npm install -g` (→ ~/.npm-global), `pip install --user` (→ ~/.local),
# `cargo install` (→ ~/.cargo), and conda/micromamba. The one thing users can NOT
# add sudo-less is SYSTEM LIBRARIES (apt) — those must be baked into the image at
# BUILD time (as root, before the container drops to its non-root user).
#
# This is that knob. It's a build arg passed to every per-user agent image. To add
# a system package: APPEND its name to the value below (keep the existing libs so
# browser automation keeps working), then rebuild + re-provision:
#     rzfz post-install --refresh      # rebuilds the agent images with the new list
#     # then each user re-provisions from the My Agents drawer
# A bare `docker compose build` NO-OPs on an installed box (the #184 no-runtime-
# build overlay), so use `rzfz post-install --refresh` to pick up a changed list.
#
# The default below is the Playwright/Chromium runtime lib set, so headless-browser
# automation works out of the box — inside an agent terminal:
#     pip install --user playwright && playwright install chromium
# ...then Playwright drives the bundled Chromium against these baked libs.
#
# NOTE (trixie): hermes' base image (debian:13.x) uses the t64-renamed names
# (libcups2t64, libasound2t64, libatk1.0-0t64, ...). The bookworm-based images
# (coding-agent, moltis) use the un-suffixed names below. The value here uses the
# bookworm names, which also resolve on hermes' trixie base via transitional
# packages; each compose builder additionally carries a distro-correct fallback
# default for boxes whose .env predates this key.
USER_DEFINED_APT_PACKAGES=libnss3 libnspr4 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 libatspi2.0-0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 libcairo2 libasound2 libxshmfence1 libx11-6 libxcb1 libxext6 libxi6 fonts-liberation
# ==============================================================================

# ==========================================
# AGENT MANAGER CONFIGURATION [EXPERIMENTAL]
# ==========================================
# Per-user agent instance orchestration.
# Enable via: agents profile in COMPOSE_PROFILES
AGENT_MANAGER_PORT=5110
AGENT_MANAGER_DB=agent_manager_db
AGENTS_DOMAIN=agents.${MAIN_DOMAIN}
AGENTS_CLIENT_SECRET=

# Resource governance
AGENT_MAX_INSTANCES=20
AGENT_IDLE_TIMEOUT_LIGHTWEIGHT=1800
AGENT_IDLE_TIMEOUT_HEAVY=7200
AGENT_CLEANUP_AFTER_DAYS=30
# Memory governance (#36 / PR #84). Per-instance max + default (GB) that a
# power/admin user may pick per agent; the per-instance floor every user gets.
# The GLOBAL agents-memory budget + per-user cap are set in the Config UI
# (Personal Agents -> Global Limits) and stored in the Agent Manager DB (live,
# no recreate). AGENT_CORE_STACK_RESERVE_MB is the RAM held back for the core
# stack when the budget's dynamic per-box ceiling is derived from host memory.
AGENT_MEM_PER_INSTANCE_MAX_GB=16
AGENT_MEM_DEFAULT_GB=2
AGENT_CORE_STACK_RESERVE_MB=8192

# Egress governance (#959 W4 / #802 — the exfil half of #256)
# ----------------------------------------------------------
# AGENT_EGRESS_POLICY: `open` (DEFAULT, ships this way) or `allowlist`.
#   open       — today's behaviour. The agent fence networks (coding-agents,
#                agent-assistants) keep their direct route to the internet.
#                That is the bring-your-own-tool premise the coding sandboxes
#                rest on: their whole purpose is "install what you need".
#   allowlist  — fenced agents reach the internet ONLY through the
#                agent-egress-proxy, which permits exactly the hosts named in
#                AGENT_EGRESS_ALLOW and denies everything else.
#
# SETTING THIS ALONE FENCES NOTHING. The other half is the opt-in compose
# overlay modules/agents/compose.egress-allowlist.yml, which flips both fence
# nets to `internal: true` (so the proxy env is not merely a hint a hostile
# container can unset) and starts the proxy. Read that file's header before
# enabling: the fence nets must be REMOVED once, because Docker will not
# re-create an existing network with changed options — skip that and the fence
# silently stays open.
#
# NOT supported together with RAZZFAZZ_CORPORATE_PROXY=1: #281 already routes
# every agent container through the box's mandated proxy. The manager refuses
# the policy loudly in its log rather than emit an unverified chained config.
AGENT_EGRESS_POLICY=open
# AGENT_EGRESS_ALLOW: space-separated hosts the fenced agents may reach through
# the proxy — same idiom as DIFY_DOC_TOOLS_SSRF_ALLOW, and the same trap: the
# Caddy ACL's `allow {$VAR:default}` only applies the default when the var is
# UNSET, so a set-but-EMPTY value expands to a bare `allow` and crashes Caddy.
# The resolver treats emptied-on-purpose as FULLY CLOSED; to close deliberately,
# use the non-resolving sentinel `disabled.invalid` rather than a blank.
# Defaults cover the bring-your-own-tool floor (#802: npm/PyPI, the configured
# LLM endpoints, the Gitea instance). The in-fence names are listed because they
# resolve into RFC1918 and the ACL denies those below the allowlist; entries for
# modules that are not enabled are unreachable anyway and harmless.
AGENT_EGRESS_ALLOW=registry.npmjs.org pypi.org files.pythonhosted.org github.com codeload.github.com objects.githubusercontent.com raw.githubusercontent.com agent-manager gitea gpustack ollama-proxy llm-manager cognee searxng

# ==========================================
# PERSONAL MCP MANAGER CONFIGURATION [EXPERIMENTAL] (#36)
# ==========================================
# Per-user MCP-proxy provisioning + encrypted credential vault.
# Enable via: mcp profile in COMPOSE_PROFILES
MCP_MANAGER_PORT=5120
MCP_MANAGER_DB=mcp_manager_db
MCP_MANAGER_DB_USER=mcp_manager_user
MCP_MANAGER_DB_PASSWORD=
MCP_DOMAIN=mcp.${MAIN_DOMAIN}
# AES-256-GCM master key (base64 32 bytes) for credential encryption-at-rest.
# Minted by razzfazz-init.sh / razzfazz-post-install.sh — DO NOT leave empty
# in production (an empty key disables the credential vault).
MCP_MANAGER_SECRET_KEY=
# Authentik forward-auth client secret for the mcp.${MAIN_DOMAIN} site.
MCP_CLIENT_SECRET=
# #61 (HIGH-1): shared service-to-service secret gating mcp-manager's
# /internal/* routes (agent-manager presents it via X-MCP-Internal-Token).
# Minted by razzfazz-init.sh — empty => /internal fails closed (401).
MCP_INTERNAL_TOKEN=
# C1 bypass fix (PR #84 re-review): "came through Caddy" proof secret for the
# agent-manager per-instance subdomain proxy. Caddy injects
# X-Razzfazz-Proxy-Proof=$MANAGER_PROXY_SECRET (stripping any client value) on
# every proxied *.agents request; agent-manager REJECTS any request lacking it.
# Shared ONLY between Caddy and agent-manager — it MUST NOT be exposed to any
# sandbox coding-agent container. Minted by razzfazz-init.sh; empty => the
# manager fails closed (refuses all agent proxy requests). Required whenever the
# `agents` profile is active.
MANAGER_PROXY_SECRET=
# Max concurrent per-user MCP proxies box-wide.
MCP_MAX_INSTANCES=50
# OAuth client secrets (server-side only; empty until the operator registers
# OAuth apps per box — see core/mcp/oauth-providers.yaml).
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_SECRET=

# ==============================================================================
# OBSERVABILITY (observability profile) — OpenLIT + ClickHouse (M019)
# ==============================================================================
OBSERVABILITY_VERSION=1.24.1
OBSERVABILITY_PORT=8200
OBSERVABILITY_DOMAIN=observability.${MAIN_DOMAIN}
# Authentik forward-auth client secret — generated by razzfazz-init.sh on first install
OBSERVABILITY_CLIENT_SECRET=
# ClickHouse TTL for OpenLIT span tables (auto-prune older partitions)
OBSERVABILITY_RETENTION_DAYS=30
# OTLP/HTTP endpoint the modules/chat/pipelines/openlit_filter.py pushes spans to.
# Points at the otel-collector container (the real OTLP receiver) — NOT openlit,
# which ships no receiver (#193). Only reachable when the observability profile
# is active. Override only if running the collector/OpenLIT externally.
OPENLIT_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
# Scrub email / phone / API-key shapes from prompt + completion text before
# they reach OpenLIT. Off by default; set to "true" for customer deployments
# where chats may carry regulated data. Only affects span events, not
# token-count or latency attributes.
OBSERVABILITY_PII_FILTER=false
# Max characters of prompt/completion text the OpenLIT filter sends as span
# events. **0 disables prompt/completion content capture entirely** — model,
# token counts, latency and the user/chat id still flow, so the dashboards keep
# working; only the text stops. This is the privacy/compliance toggle: the
# shipped default is capture-ON at 2000 chars with PII scrubbing OFF, and that
# text lands in ClickHouse for 7 days. Empty or malformed = the 2000 default.
OBSERVABILITY_EXCERPT_MAX_CHARS=2000

# ClickHouse — OpenLIT span store
CLICKHOUSE_VERSION=25.8.28.1
CLICKHOUSE_USER=default
# Generated by razzfazz-init.sh on first install
CLICKHOUSE_PASSWORD=

# --- OpenTelemetry Collector (observability profile) — fixes #193 -----------
# The real OTLP collector (otel/opentelemetry-collector-contrib) that OpenLIT
# ingest actually lands in. The openlit image ships NO OTLP receiver; the
# collector receives OTLP on 4317/4318 and writes otel_traces/otel_logs/
# otel_metrics into ClickHouse (create_schema) — the tables the dashboard reads.
OTEL_COLLECTOR_VERSION=0.130.1

# --- #197: external OTLP log export (OPT-IN, OFF by default) -----------------
# Ship ALL container logs (filelog over /var/lib/docker/containers) to a
# customer-owned OTLP target (Grafana Loki+OTel, Tempo, Datadog, Splunk,
# Elastic, a plain OTEL Collector, ...). Enterprise / NIS2 centralized-logging.
# The outbound to the target is a DELIBERATE egress — allow-list that host in
# your egress model. With export OFF, nothing is tailed or dialed (air-gap safe).
OTEL_LOG_EXPORT_ENABLED=false
# Mechanical switch read by observability/compose.yml: which logs overlay the
# collector merges. Leave as the disabled (no-op) overlay; razzfazz-init.sh /
# the Config Portal flip it to the export overlay when OTEL_LOG_EXPORT_ENABLED=true.
OTEL_COLLECTOR_LOGS_OVERLAY=otel-collector-logs-disabled.yaml
# Customer OTLP endpoint. gRPC (default exporter): host:4317 or a TLS ingress.
# Required (only) when OTEL_LOG_EXPORT_ENABLED=true. Empty = export off.
OTEL_EXPORTER_OTLP_ENDPOINT=
# grpc | http/protobuf. v1 wires the gRPC exporter; http/protobuf is a
# documented swap in otel-collector-logs-export.yaml (both exporters are defined).
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# SECRET. Auth header VALUE sent as `Authorization: <this>` to the OTLP target
# (e.g. "Bearer <token>" or "Api-Token dt0c01..."). Treat like any credential;
# never logged. Empty = no auth header (mTLS / trusted-network targets).
OTEL_EXPORTER_OTLP_HEADERS=
# TLS to the target. false (default) = TLS on, verified against system CA roots
# (public-CA / Let's Encrypt ingress). true = plaintext (trusted network only).
# Private CA: uncomment ca_file in otel-collector-logs-export.yaml + mount the CA.
OTEL_EXPORTER_OTLP_INSECURE=false
# #253 X3: SYSLOG log export — the overlay variant for syslog-native SIEMs
# (rsyslog/Graylog/Splunk-syslog/QRadar). Select with
# OTEL_COLLECTOR_LOGS_OVERLAY=otel-collector-logs-syslog.yaml and allow-list
# the host in the box egress model. 6514=RFC5425 TLS; insecure=true only for
# legacy plaintext 514 on a trusted network.
OTEL_SYSLOG_HOST=
OTEL_SYSLOG_PORT=6514
OTEL_SYSLOG_PROTOCOL=rfc5424
OTEL_SYSLOG_TLS_INSECURE=false
# #253 X5: push metrics to a CUSTOMER-owned Prometheus/Mimir/VictoriaMetrics
# remote_write endpoint. Two overlay variants, both selected via
# OTEL_COLLECTOR_METRICS_OVERLAY (empty = the boot-safe disabled overlay):
#   otel-collector-metrics-remotewrite.yaml        OTLP/SDK metrics only
#   otel-collector-metrics-remotewrite-scrape.yaml + native /metrics scrapes
#       (caddy admin, authentik, llm-manager — docker-network only; also turns
#       Caddy's `metrics` server option on via the entrypoint)
# Allow-list the endpoint host in the box egress model (#114).
# CONTRACT: with an overlay selected, OTEL_PROM_RW_ENDPOINT is REQUIRED —
# an empty endpoint fails collector config load and the collector will not
# start (deliberate opt-in contract, same as the log overlays). Symptom:
# otel-collector restart-loop with "endpoint must be set" in its log.
# OTEL_PROM_RW_HEADERS is a credential (e.g. 'Bearer <token>'). Note: when
# empty, the exporter still sends an EMPTY `Authorization:` header — strict
# receivers/LBs may reject that; give it a value or use a network-trusted
# ingress.
OTEL_COLLECTOR_METRICS_OVERLAY=
OTEL_PROM_RW_ENDPOINT=
OTEL_PROM_RW_HEADERS=
OTEL_PROM_RW_TLS_INSECURE=false
# #253 X5 S3: exporter sidecars feeding the scrape overlay (postgres + valkey
# native metrics). Both run under the observability profile, docker-network
# only — no host port, no auth surface; the collector is the only consumer.
POSTGRES_EXPORTER_VERSION=v0.20.1
REDIS_EXPORTER_VERSION=v1.91.1-alpine
# postgres-exporter connects with a DEDICATED least-privilege monitoring role,
# never the cluster superuser: it is a third-party image and every other
# service in this stack already has its own <svc>_user. The role is created and
# reconciled by core/init-db.sh with `pg_monitor` (the grant upstream documents
# for this exporter) plus CONNECT — nothing else. Leave the password empty and
# `rzfz init` / `rzfz upgrade` mint one; a set value is never overwritten.
POSTGRES_EXPORTER_USER=postgres_exporter_user
POSTGRES_EXPORTER_PASSWORD=


# ==============================================================================
# CRAWL4AI CONFIGURATION [EXPERIMENTAL]
# ==============================================================================
# RAG-friendly web crawler (Apache-2.0). Browser-based scraping with Markdown
# extraction, structured output, and LLM-assisted content distillation.
# Enable via: crawl4ai profile in COMPOSE_PROFILES.
# User-facing playground at https://${CRAWL4AI_DOMAIN}/playground.
# Upstream: https://github.com/unclecode/crawl4ai
CRAWL4AI_VERSION=0.9.3
CRAWL4AI_PORT=8201
CRAWL4AI_DOMAIN=crawl4ai.${MAIN_DOMAIN}
# Authentik forward-auth client secret — generated by razzfazz-init.sh on first install
CRAWL4AI_CLIENT_SECRET=

# SearXNG SSO UI (#1157): forward_auth-gated metasearch UI at search.<domain>.
SEARXNG_DOMAIN=search.${MAIN_DOMAIN}
SEARXNG_CLIENT_SECRET=
# Bearer credential for the crawl4ai API itself (distinct from the Authentik
# forward_auth client_secret above). REQUIRED: the container binds 0.0.0.0 so
# Caddy can reach it, and crawl4ai refuses to start on a non-loopback bind
# without a credential. Generated by init/upgrade and by the Config Portal's
# profile provisioner. (#191)
CRAWL4AI_API_TOKEN=

# ==============================================================================
# LLM ORCHESTRATOR (manager) CONFIGURATION [EXPERIMENTAL] (#254)
# ==============================================================================
# Sovereign, Kubernetes-free control plane over a heterogeneous LLM fleet.
# Phase-1: gateway + TOKEN-ONLY chargeback (input/output/cached tokens per API
# key per window — no euros, no GPU-hours). Enable via the llm-manager
# profile in COMPOSE_PROFILES. Manager reuses the shared Postgres
# (llm_manager_db), Valkey (DB index 9), and the LiteLLM image pin
# (LITELLM_VERSION, shared with the mac gateway). GPUStack is untouched.
# Design: .gsd/reports/2026.09-llm-manager-build-spec-v2-2026-08-10.md
LLM_MANAGER_PORT=8091
# Public ingress domain. Caddy admin-gates /api/* + /ui/* via Authentik
# forward-auth (the app also enforces admin-group authz); /v1/* is open
# (rzfz-sk key auth in-app); /metrics is internal-only.
LLM_MANAGER_DOMAIN=llm-manager.${MAIN_DOMAIN}
# #1444 (cutover C4, D3): llm.<domain> IS the LLM Manager — console, management
# API and the OpenAI-compatible /v1 on one name. LLM_MANAGER_DOMAIN above stays
# for one cycle as a 301 for the console paths (scripts and joined nodes keep
# working on it). GPUStack's UI moved to GPUSTACK_DOMAIN=gpustack.<domain>.
LLM_DOMAIN=llm.${MAIN_DOMAIN}
# #263 SCH2: desired-state reconciler. `observe` (default) only reports what it
# would do; `enforce` reschedules the deployments of a lost worker (heartbeat
# older than LLM_MANAGER_WORKER_STALE_SECONDS, default 90 s) onto a worker with
# room — after the #917 startup grace, with a per-deployment cooldown and a
# per-pass cap. Switch to enforce deliberately, on a fleet you watch.
ORCH_RECONCILE=observe


# #559: the fleet hub — the master's OCI registry (Zot) at a TLS edge. The web
# UI (browse/search images) is SSO-gated; the /v2 docker API is HTTP-Basic for
# machines, checked by the manager's /api/hub-auth (constant-time; FAIL-CLOSED
# while the password is empty). Run `rzfz hub-credentials` to mint the
# password, then on each consumer: `docker login hub.<domain>` (user below).
# In-network consumers keep using llm-registry:5000 for their own HTTP fetches
# and never see this gate. RUNNER IMAGE pulls are the exception (#1677): those
# are performed by the HOST's docker daemon, which resolves in the host's
# resolver and has no `llm-registry` — so they go through this gate, on the
# master too. That is why the agent inherits the hub credential below.
LLM_HUB_DOMAIN=hub.${MAIN_DOMAIN}
# #1408: the registry coordinate the master renders into its /install-worker
# script for joining thin nodes (LLM_REGISTRY_URL=https://<it>,
# LLM_WORKER_RUNNER_REGISTRY=<it> on the node). EMPTY = the hub domain above —
# the edge a remote box can actually reach. Set only for a split edge (the hub
# published under a different name than LLM_HUB_DOMAIN). Bare host, no scheme.
LLM_MANAGER_WORKER_REGISTRY=
LLM_HUB_REGISTRY_USER=fleet
LLM_HUB_REGISTRY_PASSWORD=
# Authentik proxy-provider client secret for the hub's SSO'd web UI (34-hub.yaml).
# Generated by init/upgrade.
LLM_HUB_CLIENT_SECRET=
# Authentik forward-auth provider secret for the LLM Manager UI console
# (#254 Phase-3). Minted by razzfazz-init.sh.
LLM_MANAGER_UI_CLIENT_SECRET=
# #285/#340 node credential policy. enforce = the shared node key is refused on
# the wire; each node holds only its own per-worker key, and rotate-key can
# contain a single compromised node. FRESH installs get enforce from rzfz init;
# EMPTY here means the compose default (allow) — kept for upgraded boxes whose
# nodes still authenticate with the shared key. Flip to enforce once every node
# is (re-)enrolled with LLM_WORKER_COMMAND_KEY.
LLM_MANAGER_COMMAND_KEY_MODE=
# Comma-separated Authentik groups granting management-API admin access.
LLM_MANAGER_ADMIN_GROUPS=razzfazz.ai Super Admins,authentik Admins
# #851: three-tier RBAC (#842/#843) group lists — comma-separated Authentik
# group names, now forwarded to the llm-manager container (compose.yml) and
# therefore operator-overridable. Leave EMPTY to keep the code default (an
# empty value here is treated the same as unset — it does NOT disable the
# tier): default "razzfazz.ai LLM Admins".
LLM_MANAGER_ADMIN_TIER_GROUPS=
# Same as above for the USER tier: default "razzfazz.ai LLM Users".
LLM_MANAGER_USER_TIER_GROUPS=
LLM_MANAGER_DB=llm_manager_db
LLM_MANAGER_DB_USER=llm_manager_user
LLM_MANAGER_DB_PASSWORD=
# Valkey logical DB index for the orchestrator's auth cache + rpm/tpm windows.
LLM_MANAGER_VALKEY_DB=9
# Client-facing API-key prefix. A key looks like rzfz-sk-<random>.
LLM_MANAGER_KEY_PREFIX=rzfz-sk-
# Billing-meter CAP behaviour on the proxy hot path (#254 Phase 2):
#   available (default) — never block a completion on the meter; serve and
#       record best-effort (availability-first; may under-count in an outage).
#   strict — refuse (503) an unmetered request when the usage store is
#       unreachable (consistency-first; guarantees no un-billed tokens).
LLM_MANAGER_METERING_MODE=available
# #19 "option C": box-wide in-flight completion cap shared by EVERY consumer
# (Open WebUI, Dify, the agents, Cognee, …) — not just Dify's own per-app
# max_active_requests (#30). Once this many completions are in flight at the
# same time, the next request is REJECTED with 429 immediately rather than
# queued — queueing would just move the wedge from "GPU overloaded" to "manager
# holding N blocked connections" (the class of problem #325 already fixed on
# the upstream leg). 0 disables the gate (unbounded, pre-#19 behaviour). 24 is
# a conservative default for a single-GPU box serving one resident model;
# raise it on boxes with multiple GPUs/workers behind this manager.
LLM_MANAGER_MAX_CONCURRENT_REQUESTS=24
# #928: how long the WS inference relay (multi-node: a REMOTE worker's traffic
# goes back through its own inbound WebSocket) waits for the NEXT frame of a
# relayed response before failing THAT request with a 502 and telling the worker
# to stop generating. An IDLE-BETWEEN-FRAMES deadline, NOT a total request
# deadline: a long completion streams tokens continuously and is never affected;
# what this bounds is an engine that accepted a request and emitted nothing while
# the socket stays healthy — the one wedge neither a WS drop nor a client
# disconnect recovers from, which otherwise pins a relay slot (and one of
# LLM_MANAGER_MAX_CONCURRENT_REQUESTS above) until the manager restarts. 300s is
# generous on purpose: it must cover a cold engine's time-to-first-token. Set 0
# to disable the bound entirely (pre-#928 behaviour).
LLM_MANAGER_RELAY_IDLE_TIMEOUT_S=300
# #330 stage 1: GB GPUStack (or any external scheduler) holds on the SAME
# GPU — the LLM-Manager admission gate subtracts it so the two control
# planes stop double-booking (e.g. 38 for a resident qwen3.6 Q8). 0 = no
# coexistence. Stage 2 (dynamic reading) is gated on the 0.91 measurements.
LLM_MANAGER_VRAM_RESERVED_EXTERNAL_GB=0
# #1442 (cutover C2): set to `true` by post-install once GPUStack is registered
# as the manager's external backend — the ownership predicate
# (llm_manager_owns_standard_set) reads it, so on a federated box every
# consumer wires to the manager instead of to GPUStack. Written by
# `rzfz post-install --refresh`, cleared when the GPUStack profile goes away;
# do not set it by hand (a true without a registered worker points consumers
# at a manager that serves nothing).
LLM_MANAGER_GPUSTACK_FEDERATED=false
# Observability: export a per-request OTel span from the LLM Manager and the
# LiteLLM router to the observability module's otel-collector (→ ClickHouse →
# OpenLIT UI). Empty (default) = OFF: no callback, nothing emitted, no errors
# when the collector isn't running.
#
# #2003: post-install SETS this for you when the `observability` profile is on,
# and clears it again when the profile goes away — both the CLI and the Config
# Portal toggle, identically (pinned by
# tests/unit/consistency/test_2003_the_manager_seam_agrees.py). Until #2003 this
# comment said "set it when the profile is on" and nothing did, so the one
# surface every LLM call passes through emitted nothing while the dashboards
# were being called empty.
#
# Setting it costs ONE router reload: a non-empty value adds a `callbacks:
# ["otel"]` to the generated router config, and the entrypoint watcher restarts
# LiteLLM when that file changes (#1955 — measured at ~11 s of refused connects
# before the cushion, one cold start after it).
LLM_MANAGER_OTEL_ENDPOINT=
# OTLP wire protocol for the span export above (EXO-14). Consumed by
# modules/llm/manager/compose.yml as OTEL_EXPORTER_OTLP_PROTOCOL. Default suits an
# otel-collector on :4318; set to `grpc` for a collector that only speaks OTLP/gRPC.
#   http/protobuf (default) | grpc
LLM_MANAGER_OTEL_PROTOCOL=http/protobuf
# Internal master key the manager uses to talk to the LiteLLM pure-router
# (llm-manager-router). Known ONLY to the manager. Minted by
# razzfazz-init.sh — DO NOT leave empty in production.
LITELLM_INTERNAL_KEY=
# Shared secret a fleet node presents (Bearer) to register itself with the
# manager via POST /api/workers (#254 P2-B1). Distinct from the router master
# key above. EMPTY = node registration disabled (fail-closed). Minted by
# razzfazz-init.sh; on a multi-box fleet copy the same value to each worker box.
LLM_MANAGER_NODE_KEY=
# LLM Model Registry (Zot, #254 P2-D, profile llm-registry). Loopback debug
# port; in-network nodes use llm-registry:5000. Not 5000 on the host to avoid
# colliding with other services' conventional 5000.
LLM_REGISTRY_PORT=8093
# Pinned Zot image tag (repin to a reviewed tag/digest at ship).
ZOT_VERSION=v2.1.21

# ── Machine-managed / operator-visible keys the manifest writes (#522) ───────
# These are written by a migration `add` but were absent here, so a fresh install
# and an upgraded box disagreed about whether they exist at all.

# Docker's compose-file list, INCLUDING the llm device overlay for this box's
# HARDWARE. Written by `rzfz init` (and adjusted by `rzfz upgrade`) — do NOT set
# it by hand: the correct value depends on HARDWARE and on which llm profile is
# active, e.g.
#     compose.yml:modules/llm/compose.devices.amd.yml
# Left COMMENTED so a fresh install does not inherit a hardware-specific value it
# has not chosen yet. `rzfz status` verifies the overlay matches HARDWARE.
# COMPOSE_FILE=

# Host interface GPUStack's ports bind to.
#   standalone : 127.0.0.1 (default — no external workers)
#   master     : a specific LAN IP, so workers can reach it
#   worker     : 127.0.0.1 (outbound only)
# Anything other than 127.0.0.1 exposes GPUStack beyond the box; Caddy is the
# only surface meant to be reachable otherwise.
GPUSTACK_HOST_BIND=127.0.0.1

# ── LLM Manager / worker-agent tuning (#319) ───────────────────────────────────
# These are read by the code and were previously absent from this file. Three of
# them were not merely undocumented but UNSETTABLE: a compose `environment:`
# block is an allow-list, so a key it does not name never reaches the process no
# matter what is written here. The pass-throughs were added with #319.

# THE lever for GPU coexistence: the node's real model-memory budget in GB.
# On unified-memory boxes (Strix Halo) the auto-probe is unreliable and the
# node container usually lacks rocm-smi, so the box should declare it. This is
# what reserves headroom when GPUStack shares the GPU.
# EMPTY = auto-probe (current behaviour).
LLM_WORKER_MEM_BUDGET_GB=
# Fraction of a worker's VRAM carveout that admission control (#227) may commit
# before refusing a placement. 0.9 leaves 10% for KV growth and fragmentation.
# Out-of-range or unparseable values fall back to 0.9 rather than failing to start.
LLM_MANAGER_VRAM_HEADROOM=0.9
# Numeric HOST GIDs granting a non-root engine access to /dev/kfd + /dev/dri.
# Comma-separated. Group NAMES cannot be used — docker resolves them against the
# engine image's /etc/group, which minimal runner images do not define.
# EMPTY = engine runs as root, which already has device access.
RAZZFAZZ_GPU_GROUP_GIDS=
# #1517 rev-B: the llama.cpp server binary inside the runner image. EMPTY =
# llama-server, which is what every runner this repo builds ships. Only a
# custom runner image with a differently-named binary needs this. Read by the
# AMD and CUDA llama.cpp drivers; documented here because a key the drivers
# read but nothing forwards is a promise the box cannot redeem (#319/#1436).
RAZZFAZZ_LLAMACPP_BINARY=
# Repin an engine image without a code change (#331). EMPTY = the built-in
# default for that hardware class: llama-runner:b9851-vulkan (amd),
# llama-runner:b10853-cpu (cpu), vllm/vllm-openai:v0.25.1 (cuda).
# #1516 (E5): ONE repository, the target in the tag — the engine build first, then
# the toolkit and GPU architecture the binary was compiled for. The old names
# (llama-vulkan-runner:b9851 …) are published as aliases for one cycle, so an
# existing pin keeps resolving. The full set lives in
# modules/llm/runners/runners.yaml, which is what init/upgrade/post-install build
# from.
# #1188: the AMD default moved b8943 -> b9851 (multi-turn tool calls with
# thinking streamed raw Qwen XML on b8943). b8943 is still built as the
# rollback: RAZZFAZZ_ENGINE_IMAGE_AMD=llama-runner:b8943-vulkan repins a box;
# a running engine keeps its image until its next (re)launch.
RAZZFAZZ_ENGINE_IMAGE_AMD=
RAZZFAZZ_ENGINE_IMAGE_CPU=
RAZZFAZZ_ENGINE_IMAGE_CUDA=
# EXO-4.3: the CUDA llama.cpp runner image (the `llama-cuda-runner` GGUF-direct
# engine on NVIDIA) and the worker-agent engine selector. EMPTY = the worker-agent's
# per-hardware default driver. NOTE (EXO-4/#1012): the llama-cuda-runner build
# wiring is not yet in init/upgrade/post-install, so this path is not deploy-ready
# on NVIDIA — keep empty until that lands.
RAZZFAZZ_ENGINE_IMAGE_CUDA_LLAMACPP=
# #1329/#1436: the GB10 worker class (cuda-gb10 — DGX Spark / HP ZGX Nano, sm_121).
# EMPTY = nvcr.io/nvidia/vllm:26.08-py3 (vLLM; the Docker-Hub vllm-openai image has
# no sm_121 kernels and no PTX — measured dead on the box) and
# llama-cuda-gb10-runner:b9851 (the CUDA-13 / 121a llama.cpp runner).
RAZZFAZZ_ENGINE_IMAGE_CUDA_GB10=
RAZZFAZZ_ENGINE_IMAGE_CUDA_GB10_LLAMACPP=
# #1517: the GPU's compute capability decides WHICH CUDA llama.cpp runner this
# box can execute (12.0 = RTX PRO 6000 / sm_120, 12.1 = GB10 / sm_121a), read
# from `nvidia-smi --query-gpu=compute_cap`. EMPTY = ask the GPU. Set it only
# for a card no runner is built for yet, or one that misreports — a llama.cpp
# binary is compiled FOR an architecture, so the wrong value fails at engine
# start with "no kernel image is available for execution on the device". The
# agent's UnknownCudaCapability error names this key as the way out.
RAZZFAZZ_CUDA_COMPUTE_CAP=

# #1456: fraction of a GB10 node's UNIFIED memory one vLLM engine may
# pre-allocate. On GB10 "GPU memory" IS the host RAM, so the CUDA default of
# 0.9 would leave the OS, Docker and the agent ~12 GB of 121. Empty = derived
# from LLM_WORKER_MEM_BUDGET_GB / MemTotal (96 of 121.6 -> 0.79), 0.5 without
# a budget; a per-deployment gpu_memory_utilization always wins. Set this when
# the derived value does not fit — e.g. to leave room for a second engine.
RAZZFAZZ_NODE_ENGINE=
# ── Engine supervision windows (#971) ────────────────────────────────────────
# The node-agent's EngineSupervisor read all four of these from the environment
# already, but the node-agent compose `environment:` block is an allow-list and
# named none of them — so they were UNSETTABLE, the same trap as the #319 keys
# above. The pass-throughs were added with #971.
#
# READINESS GRACE: how long an engine may take to answer /health after launch
# before the supervisor calls the load failed and restarts it. Raise this on a
# box running a LARGE model: on the CUDA/vLLM path weights load in seconds, then
# the engine spends MINUTES in vLLM's vision-encoder + KV-cache profiling and
# (non-eager) CUDA-graph capture before /health ever answers. Too low and the
# supervisor kills the engine mid-profiling and loops forever — no crash, no
# OOM, exit 0, the model simply never serves. The old 120 s did exactly that to
# a 35B multimodal FP8 model; 300 s clears it with margin.
# Seconds. Empty / unparseable / non-positive → 300.
RZFZ_ENGINE_READINESS_GRACE=300
# #316 self-heal: cooldown before a circuit-broken engine is half-opened, so a
# transient host-pressure failure recovers on its own instead of showing
# false-"failed" forever — and the bound on those attempts.
# Seconds / count. Empty or non-positive → 180 / 3.
RZFZ_ENGINE_RECOVER_AFTER=180
RZFZ_ENGINE_MAX_RECOVER_ATTEMPTS=3
# Per-instance engine /health probe timeout on the node's report loop. The
# supervisor probes each supervised instance IN TURN before the registration
# POST, so N wedged instances cost N × this per cycle against the manager's 90 s
# staleness window. Seconds. Empty or non-positive → 2.
RZFZ_ENGINE_PROBE_TIMEOUT=2
# Loopback-only debug binds. In-network these are reached by service name
# (llm-worker-agent:8090, llm-manager-ui:8092), so changing these affects only
# what an operator can curl from the host.
LLM_WORKER_AGENT_PORT=8090
LLM_MANAGER_UI_PORT=8092
# Docker network the worker-agent joins launched engines to, so the LiteLLM router
# resolves them by instance name. Change only on a non-default compose project
# name — a wrong value here makes engines start and be unroutable.
LLM_WORKER_ENGINE_NETWORK=razzfazz-stack_default
# #1619 — the worker-agent's SECOND, lean beat, beside the 30 s full report
# (LLM_WORKER_REPORT_INTERVAL). It carries the four utilisation numbers the
# console's live chart draws and claims queued node commands, and nothing else;
# the full report keeps the registration, the instance table and the image
# pins. Seconds. 0 switches the beat off and the box behaves exactly as it did
# before — which is how to undo this on a live box without a rollback.
# Lower than ~1 buys nothing: the numbers are sysfs reads taken per beat.
LLM_WORKER_FAST_BEAT_INTERVAL=3
# ── Worker-for-a-remote-master mode (#549 R5) ────────────────────────────────
# A FULL installation can serve as a worker in ANOTHER master's fleet: enable
# the llm-worker-agent profile and point it at the remote manager. This is a
# first-class mode, sanctioned by the manager's D2 guard (the worker-agent
# registers as a plain worker; only self-declared managers are refused).
# One box runs ONE worker-agent pointed at ONE master, so engine ownership is
# never ambiguous — enrolling here means THIS box's engines belong to THAT
# fleet. Enrol with `rzfz worker-join` (writes LLM_WORKER_COMMAND_KEY).
#
# Where the worker-agent registers. EMPTY = the local manager
# (http://llm-manager:8080) — the single-box default. Set to the REMOTE
# master's URL for R5 mode.
LLM_WORKER_AGENT_MANAGER_URL=
# This worker's name in the master's fleet. The enrolment token's name is
# authoritative (#285); this must match it. EMPTY = "master" (the local
# default, which is wrong for R5 — worker-join sets it).
LLM_WORKER_NAME=

# The ONE registry this node may pull runner images from (#549 R2) — the
# master's Zot. deploy_runner refuses any other host, whatever the command
# channel says: a node never pulls runners from a public registry (the #307
# air-gap invariant, applied to images).
#
# EMPTY = LLM_HUB_DOMAIN, and that is the right value for almost every box.
# #1677: this used to ship `llm-registry:5000`, a COMPOSE-NETWORK name — but the
# pull is executed by the HOST's docker daemon, not by the agent, and the daemon
# cannot resolve it. Measured on 0.91: `llm-registry` does not resolve from the
# host, `hub.<domain>` does. Set this only for a split edge or a routed address
# a remote worker reaches over the LAN. Bare host, no scheme.
LLM_WORKER_RUNNER_REGISTRY=
# ── Routed (REMOTE) node addressing + registry credential (NODE-13, #1037) ───
# These four decide whether the worker-agent behaves as a co-located (LOCAL) or a
# routed (REMOTE) node. They were forwarded by modules/llm/node-agent/
# compose.thin.yml only, and the module compose's `environment:` block is an
# explicit allow-list (#319) — so on the FULL-install worker mode documented
# just above they were UNSETTABLE, and the box always insisted it was LOCAL.
#
# EMPTY on a single-box / co-located install, and that is the correct value: an
# empty advertise address IS the LOCAL signal (registry_is_local()), a LOCAL node
# pins its weight-registry base to http://llm-registry:5000 whatever
# LLM_REGISTRY_URL says, and attaches no credential in-network (#559).
#
# Host-routable base a REMOTE master uses to reach this worker's engines (#262).
# Setting it is what makes this node REMOTE.
LLM_WORKER_ADVERTISE_ADDR=
# The master's model-weight registry as THIS node reaches it (#307 S4/#571).
# Read only when the node is REMOTE. `rzfz node-init --registry` writes it.
LLM_REGISTRY_URL=
# Basic credential for that registry's hub edge (#559/#571). Both must be set or
# neither is used; never sent to any host outside LLM_REGISTRY_URL.
LLM_WORKER_REGISTRY_USER=
LLM_WORKER_REGISTRY_PASSWORD=
# PEM the manager pins when a worker enrolls (#419), so a joining node can verify
# it is talking to the real master and not a look-alike. Default is Caddy's own
# internal CA root inside the manager container; override only when the master
# presents a certificate from a different CA.
#
# One default, in ca_fingerprint.DEFAULT_CA_PEM, used by compose and by every
# in-app fallback (#499). It is under the caddy_data mount, so the manager can
# actually read it — a default nobody mounts makes the pin inert.
LLM_MANAGER_CA_PEM=/caddy-data/caddy/pki/authorities/local/root.crt
# How long a CLAIMED node command may stay unfinished before the LLM Manager
# stops believing in it and marks it failed (seconds). EMPTY = 6 hours (#1633).
# A node that dies mid-command — container restart, OOM kill, reboot — leaves
# its row at "claimed" forever, and the console reads that as "still pulling":
# on 0.79 a mirror_model sat there for hours while the box had no model and
# nothing reported an error. The sharp instrument against a STALLED TRANSFER is
# the node agent's own read timeout; this is only the backstop for the case
# that timeout cannot see. Deliberately generous: without progress reporting it
# cannot tell a slow 30 GB pull from a wedged one, so it sits where no honest
# transfer lives. Lower it only on a box whose weights are all local.
LLM_MANAGER_STALE_CLAIM_SECONDS=21600
# How long the LLM Manager may HOLD a request whose TCP connect to the LiteLLM
# router was REFUSED, instead of answering 502 straight away (seconds).
# 0 = no hold, answer 502 immediately (the behaviour before #1955).
#
# Why this exists: a router reload shuts the router's port for about eleven
# seconds. LiteLLM drains gracefully first — measured at 81 s on 0.91, with the
# old process still serving throughout — and the hole is between the old
# process letting go of the port and the new one taking it. Three of
# thirty-seven in-flight requests died in that hole, all with
# `router unreachable: All connection attempts failed`.
#
# Holding is safe ONLY because of what that error proves: the TCP handshake
# never completed, so the request never reached a model and a retry cannot make
# it generate twice. A timeout on an ACCEPTED request is never retried.
LLM_MANAGER_ROUTER_RECONNECT_SECONDS=20
#
# #2019: `apply-params` on a deployment whose weights provably fit twice starts
# the new engine ALONGSIDE the old one, so the model never leaves the router's
# model_list. Measured before that: 17.76 s and 1744 requests answered
# `404 no ready rerank engine` on 0.79. This is how long such an overlap may
# stay unresolved before it is abandoned — the old engine keeps serving and the
# new params did NOT apply, which an operator can see and retry, instead of an
# engine retired in favour of one that never came up. 0 = never abandon.
LLM_MANAGER_OVERLAP_ABANDON_S=900
# Optional HMAC key signing the LLM Manager monthly entitlement rollup
# (#254 P2-E2). EMPTY = rollup returned unsigned. Local usage_events remain the
# billing source-of-truth either way. Set to enable signature verification.
LLM_MANAGER_ROLLUP_KEY=
