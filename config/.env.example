# ==============================================================================
# LIGHTRAG CONFIGURATION [EXPERIMENTAL]
# ==============================================================================
# LightRAG is experimental and not included in any init package preset.
# Enable manually via setup UI or by adding 'lightrag' to COMPOSE_PROFILES.
# Graph storage uses file-based NetworkX (persisted to lightrag-data volume).
# ==============================================================================
LIGHTRAG_VERSION=v1.5.7
LIGHTRAG_PORT=9621
LIGHTRAG_DOMAIN=rag.${MAIN_DOMAIN}
# #690: LLM/embedding/rerank TARGET override — same semantics as the COGNEE_*
# variants (empty = the canonical endpoint; post-install wires the box).
# #1323: rerank rides the SAME endpoint as the rest. The note that used to
# stand here sent it to GPUStack instead, and was true when it was written —
# it stopped being true with #976 and #1445. Measured against a running
# GPUStack 0.7.1, the route it named answers 404 while /v1/rerank answers 401,
# so LightRAG's reranking posted into nothing and retrieval fell back to
# embedding-only without an error anywhere. A stale note beside the variable
# it documents is read as the rule.
LIGHTRAG_LLM_ENDPOINT=
LIGHTRAG_LLM_API_KEY=
LIGHTRAG_EMBEDDING_ENDPOINT=
LIGHTRAG_EMBEDDING_API_KEY=
LIGHTRAG_RERANK_ENDPOINT=
LIGHTRAG_RERANK_API_KEY=
# #1445 (cutover C5): the remaining OpenAI-compatible consumers wire to the
# canonical LLM endpoint (http://llm:8080/v1, the LLM Manager) with their own
# cost-centred service key — post-install mints and fills these in
# (wire_llm_manager_rag_consumers). EMPTY = the compose default (canonical
# URL) and no key yet; a GPUStack key here would be a WRONG key, not a fallback.
PAPERCLIP_LLM_ENDPOINT=
PAPERCLIP_LLM_API_KEY=
LLM_MANAGER_PAPERCLIP_KEY=
# The Ollama-protocol proxy on :11434 (D5) fronts the manager with its own key.
OLLAMA_PROXY_LLM_API_KEY=
LLM_MANAGER_OLLAMA_PROXY_KEY=
# #3301: the key a CALLER of the Ollama-protocol proxy must send
# (Authorization: Bearer <key>, to http://ollama-proxy:11434 on the stack
# network). Generated by init/upgrade; empty = the proxy refuses every request.
# A client that cannot send a header uses the LLM Manager instead
# (http://llm:8080/v1 with its own rzfz-sk- key).
OLLAMA_PROXY_CLIENT_KEY=
# Onyx's own manager key (cost centre stack/onyx): its chat provider and its
# embedding provider (http://llm:8080/v1/embeddings) both carry it. Minted by
# post-install's Onyx step; GPUSTACK_API_KEY is refused by the manager.
LLM_MANAGER_ONYX_KEY=

# LightRAG API Key (for programmatic access via X-API-Key header)
# Generated by razzfazz-init.sh
LIGHTRAG_API_KEY=

# LightRAG Auth (WebUI login credentials)
# Generated by razzfazz-init.sh
LIGHTRAG_TOKEN_SECRET=
LIGHTRAG_AUTH_ACCOUNTS=

# LightRAG LLM/Embedding models (must be deployed in GPUStack)
# Defaults match razzfazz-post-install.sh's standard preset; profile_provisioner
# back-fills these on profile-enable if left empty.
LIGHTRAG_LLM_MODEL=qwen3.6
# #3214: the embedding model and its dimension ship EMPTY. They depend on the
# box's hardware class (CPU: qwen3-embedding-0.6b, 1024; every other class:
# qwen3-embedding, 4096), and a value here counts as the box's own choice (#2727,
# an existing box keeps its embedder): a CPU box was wired to the 8B it never
# serves. Filled when the profile is enabled and by post-install.
LIGHTRAG_EMBEDDING_MODEL=
# EMBEDDING_DIM MUST equal the model's native output dim — the endpoint IGNORES
# the OpenAI `dimensions` param, so it is measured (or taken from the manifest).
LIGHTRAG_EMBEDDING_DIM=
# The endpoint ignores `dimensions`, so don't send it (misleading). Set true only
# for a model/runner that actually honours dimension truncation.
LIGHTRAG_EMBEDDING_SEND_DIM=false
# #2515: LightRAG's own compiled default (10 chunks/request, lightrag/constants.py
# DEFAULT_EMBEDDING_BATCH_NUM in v1.5.7) sat below the fleet floor of 16 the OWUI
# side now uses, and modules/knowledge/lightrag/compose.yml never set this var —
# every box ran at 10. EMBEDDING_FUNC_MAX_ASYNC (concurrency) is not overridden
# here: its own compiled default is already 8, well above the >= 2 floor.
LIGHTRAG_EMBEDDING_BATCH_NUM=16

# LightRAG Reranking (optional, uses cohere-compatible endpoint via GPUStack)
# Set LIGHTRAG_RERANK_BINDING=null to disable
LIGHTRAG_RERANK_BINDING=null
LIGHTRAG_RERANK_MODEL=

# LightRAG Timeouts (seconds)
LIGHTRAG_EMBEDDING_TIMEOUT=120
LIGHTRAG_LLM_TIMEOUT=300

# Authentik client secret for LightRAG proxy provider
LIGHTRAG_CLIENT_SECRET=

# ==============================================================================
# COGNEE CONFIGURATION [EXPERIMENTAL]
# ==============================================================================
# Cognee is experimental and not included in any init package preset.
# Enable manually via setup UI or by adding 'cognee' to COMPOSE_PROFILES.
# Uses Kuzu (embedded) for graph storage and PostgreSQL/pgvector for vector/relational.
# ==============================================================================
COGNEE_PORT=8011
# Host port for cognee-frontend (Next.js UI built from upstream source — rc6.7 #57)
COGNEE_FRONTEND_PORT=8012
COGNEE_DOMAIN=cognee.${MAIN_DOMAIN}
COGNEE_LOG_LEVEL=INFO
# Liveness watchdog inside the cognee container: when the cognee API stops
# answering for about three minutes, the watchdog ends the server so Docker
# restarts it. 1 = on (default), 0 = off.
COGNEE_LIVENESS=1

# Cognee LLM/Embedding models (must be deployed in GPUStack)
# Defaults match razzfazz-post-install.sh's standard preset; profile_provisioner
# back-fills these on profile-enable if left empty. The `openai/` prefix on the
# LLM model is required because LLM_PROVIDER=custom routes through litellm,
# which raises BadRequestError("LLM Provider NOT provided") on bare model names.
# Embedding uses openai_compatible (cognee's OpenAICompatibleEmbeddingEngine,
# direct openai SDK), so the bare name is correct there.
COGNEE_LLM_MODEL=openai/gemma4
# #690: LLM/embedding TARGET override. Empty = the compose default, which is the canonical endpoint (#1445)
# (http://gpustack:9090/...). On llm-manager boxes `rzfz post-install`
# sets these to http://llm-manager:8080/v1 plus a minted stack/cognee key
# automatically — do not hand-edit unless you know the target.
COGNEE_LLM_ENDPOINT=
# #3022: how many LLM calls cognee runs at the same time (knowledge-graph extraction).
# One call takes tens of seconds on the box's local model; more in flight than the
# model has slots only makes the LLM Manager reject them. 2 leaves room for chat on a
# 4-slot box; 0 removes the bound (not recommended).
COGNEE_LLM_MAX_CONCURRENT=2
COGNEE_LLM_API_KEY=
COGNEE_EMBEDDING_ENDPOINT=
COGNEE_EMBEDDING_API_KEY=
# M031 S3: cognee passes this JSON to litellm as kwargs. core/llm/sync.py
# updates max_tokens here when it runs. Default keeps thinking-mode off
# (gemma4/qwen3 support it but cognee's graph extractors prefer non-thinking).
# NOTE: GPUStack/llama-box honours the disable ONLY via chat_template_kwargs;
# the bare extra_body.enable_thinking (vLLM convention) and a /no_think prompt
# are both ignored, so qwen3.6 keeps reasoning and cognify times out (#170).
LLM_ARGS={"extra_body":{"chat_template_kwargs":{"enable_thinking":false}}}
# #3214: empty, filled per hardware class (see LIGHTRAG_EMBEDDING_MODEL above).
COGNEE_EMBEDDING_MODEL=
COGNEE_EMBEDDING_DIM=
# HuggingFace tokenizer for local embedding models (e.g. nomic-ai/nomic-embed-text-v1)
COGNEE_EMBEDDING_TOKENIZER=
# #2515 (checked, not changed): cognee's own EmbeddingConfig.embedding_batch_size
# (infrastructure/databases/vector/embeddings/config.py) defaults to 36 when unset
# — already above the fleet floor of 16, and this stack's compose.yml never sets
# EMBEDDING_BATCH_SIZE, so no override is needed. Its embedding CONCURRENCY is a
# separate, already-wired, deliberate throttle —
# modules/knowledge/cognee/compose.yml hardcodes EMBEDDING_RATE_LIMIT_REQUESTS=1 /
# EMBEDDING_RATE_LIMIT_INTERVAL=1 ("leaves GPUStack slots for chat"). Raising it
# unconditionally would regress that protection on any box that does NOT get the
# qwen3-embedding replica scale-out (#2515, cli/lib-llm-manager-deploy.sh:
# min(gpu_workers, 3), only on boxes with >= 2 GPU workers) — left alone here;
# revisit once that rate limit can be sized from the same worker count.

# #186 (Defect 1): auto-migrate the on-disk graph store when it is left in an
# OLDER ladybug storage format after a cognee upgrade (e.g. 0.16 -> 0.17), which
# otherwise makes the knowledge-graph viz read empty SILENTLY. On start,
# kuzu-migrate.py backs up the store then runs cognee's official export/import
# migration (storage-format gated, non-fatal). Set to false on air-gapped boxes
# or to migrate under a maintenance window — the helper then only DETECTS the
# stale format and logs the manual `ladybug_migrate …` recovery command.
# The automatic path needs PyPI egress during the one-time migration.
COGNEE_KUZU_AUTO_MIGRATE=true

# Authentik client secret for Cognee proxy provider
COGNEE_CLIENT_SECRET=
# #1806: signs cognee session tokens (fastapi-users). Generated per box by
# init/upgrade. EMPTY is NOT a fallback to a default — cognee reads
# os.getenv(name, "super_secret"), so an empty value here makes it sign with an
# EMPTY HMAC key (trivially forgeable), while UNSET would use the public
# "super_secret". Both are insecure; the cognee API is exempt from the SSO gate
# (Caddyfile F-034), so init/upgrade fill this before cognee starts and
# post-install refuses to wire cognee while it is empty.
COGNEE_JWT_SECRET=

