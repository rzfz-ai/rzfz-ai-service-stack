#.env

# ==============================================================================
# RAZZFAZZ AI SERVICE STACK - GLOBAL CONFIGURATION
# ==============================================================================
# This file contains the primary configuration for the entire service stack.
# It defines global domains, secrets, versions, and connection details.
#
# USAGE:
# - Copy this file to .env and adjust values for your environment.
# - Enable desired services via COMPOSE_PROFILES.
# - Passwords and Secrets SHOULD be changed for production deployments.
# ==============================================================================

# ==============================================================================
# STACK VERSION TRACKING (set by razzfazz-init.sh / razzfazz-upgrade.sh)
# ==============================================================================
RAZZFAZZ_VERSION=
# #1593: set while an upgrade is running and cleared together with
# RAZZFAZZ_VERSION when it finishes. An aborted run leaves it set, so the box
# can say "code is <target>, run not finished" instead of reporting the old
# version as if nothing had happened. Empty on a healthy box.
RAZZFAZZ_UPGRADE_IN_PROGRESS=
RAZZFAZZ_COMMIT=

# Release channel / box role (#28). Controls where `rzfz upgrade` pulls from:
#   internal (default) — SEQIS-fleet box. Upgrade pre-flight ASSERTS the origin
#                        remote is the internal Gitea
#                        (https://git.razzfazz.ai/razzfazz.ai/razzfazz-ai-service-stack.git)
#                        and aborts on mismatch (CLAUDE.md git-remote-standard).
#   public             — customer/public box. Upgrade pre-flight instead REDIRECTS
#                        origin to the public GitHub mirror
#                        (https://github.com/rzfz-ai/rzfz-ai-service-stack.git)
#                        and allows anonymous pulls (no git credential required).
# Default is `public` since 2026.09 (#602, operator decision): a forgotten
# channel on a CUSTOMER box used to fail loudly at the customer (origin
# pointing at an unreachable git.razzfazz.ai) — with `public` the failure
# mode of a forgotten FLEET box stays in-house, and the upgrade pre-flight's
# fleet guard (PAT present + channel=public -> abort with guidance) makes it
# fail loudly HERE. Fleet installs get `internal` via preset
# (master-cpu/testvm-cpu), origin auto-detection at init, or by hand.
RAZZFAZZ_CHANNEL=public
# #692: shared memory budget (GB) for ALL agent containers — enforced as
# MemoryMax on razzfazz-agents.slice (installed by harden-host, used as
# cgroup parent by the agent-manager). Empty = auto: 30% of host RAM,
# min 4 GB. Coding agents are build machines; keep this deliberately small
# on 30-GB demo boxes. Re-run 'sudo ./scripts/harden-host.sh' after changes.
AGENT_TOTAL_MEMORY_BUDGET_GB=

# #693: build-phase RAM safety. PARALLELISM empty = auto (min(nproc,
# MemAvailable/4GB)) — big boxes build at full width, 30-GB boxes serialize
# instead of OOM-freezing next to the running stack (0.208, 2026-08-24).
# MIN_FREE_GB is the loud-warning threshold before any build phase.
RAZZFAZZ_BUILD_PARALLELISM=
RAZZFAZZ_BUILD_MIN_FREE_GB=8

# Public release remote for PUBLIC/customer boxes (#27; Codeberg-exit 2026-07).
# This is where a `public`-channel box's `origin` is redirected on upgrade, and
# what init's channel-detect matches `origin` against. Leave unset/commented: the
# canonical GitHub mirror (https://github.com/rzfz-ai/rzfz-ai-service-stack.git) is
# the built-in default (scripts/lib.sh). Override ONLY for staging/fork testing —
# point a test box at a fork without touching source, e.g.:
#   RAZZFAZZ_PUBLIC_REMOTE=https://github.com/<fork>/rzfz-ai-service-stack.git
# No effect on internal fleet boxes (they use the git.razzfazz.ai Gitea).
#RAZZFAZZ_PUBLIC_REMOTE=
# Optional SECONDARY/fallback public remote, tried only if a fetch from the
# primary fails (e.g. a self-hosted code.rzfz.ai or a GitLab mirror). Empty by
# default (GitHub-primary, no secondary yet).
#RAZZFAZZ_PUBLIC_REMOTE_FALLBACK=

# Absolute host path of the repo. Set by razzfazz-init.sh on first install
# (and razzfazz-upgrade.sh on upgrade). Used by core/compose.yml so the
# razzfazz-config container's bind-mount source matches what the docker
# daemon sees on the host — without this, the apply flow tells the daemon
# to mount /stack/... which doesn't exist on the host, the daemon auto-
# creates it as a directory tree, and subsequent caddy/dify recreates
# fail with "mount file→directory mismatch".
STACK_HOST_PATH=

# Path to the operator's git-credentials file (typically $HOME/.git-credentials).
# Bind-mounted read-only into razzfazz-config so the Image Updates check can
# fetch the upstream manifest via the smart-HTTP git protocol (which Authentik's
# proxy on git.razzfazz.ai exempts; raw-file URLs get the SSO redirect). Set
# by razzfazz-init.sh / razzfazz-upgrade.sh if the file exists. Optional —
# image_checker degrades to an error-with-workaround in the UI if missing.
STACK_GIT_CREDENTIALS_PATH=

# ==============================================================================
# STACK PROFILES & DOMAIN
# ==============================================================================
# COMPOSE_PROFILES controls which optional service groups are started.
# Add or remove profile names (comma-separated) to enable/disable modules.
# Core services (Caddy, PostgreSQL, Authentik, Valkey, SMTP, Backup, Setup UI)
# are always started and are not profile-gated.
#
# Available profiles:
#
#   chat              Open WebUI + Pipelines (AI chat interface)
#   dify              Dify API/Worker/Web/Sandbox/Plugin Daemon (LLM workflow builder)
#   llm-manager       LLM Manager — the OpenAI-compatible gateway every consumer
#                     talks to. Ships in the default profile list and is
#                     always-on since the 2026.09 cutover (#979/#1443).
#   llm-registry      Model artifact registry (Zot) for the manager's workers.
#   llm-worker-agent  Runs the engines the manager schedules. The three belong
#                     together — a manager without the other two serves nothing.
#   llm-legacy        GPUStack v0.7.1 + Model Sync + Ollama proxy — the optional
#                     GPUStack backend beside the LLM Manager, which federates
#                     it (#1442). ONE profile for every hardware line; HARDWARE
#                     picks the device overlay: amd => our Vulkan build,
#                     nvidia => our CUDA build (#1448), cpu => the upstream
#                     v0.7.1-cpu image (#1447). The overlay is REQUIRED — the
#                     service carries no image of its own.
#   monitor           Komodo + FerretDB + Komodo-Postgres (container monitoring UI)
#   searxng           SearXNG (privacy-focused metasearch engine)
#   stts              Speaches — speech-to-text + text-to-speech
#   gotenberg         Gotenberg (PDF / document conversion)
#   gitea             Gitea (self-hosted Git)
#
#   docling           Docling — document parsing for the RAG pipelines
#   lightrag          LightRAG — graph-based RAG knowledge base         [EXPERIMENTAL]
#   cognee            Cognee + Kuzu — GraphRAG with AI memory (on by default, #520)
#   agents            Agent Manager — per-user agent instances          [EXPERIMENTAL]
#
# Note: the default LLM backend is the LLM Manager, which is a TRIO —
# llm-manager (the OpenAI-compatible gateway), llm-registry (the model artifacts)
# and llm-worker-agent (runs the engines); a manager without the other two serves
# nothing (#1292, operator decision E3).
#
# The GPUStack runtime is `llm-legacy` (v0.7.1), and it is the only one left.
# #1447 (C7a) removed the 2.x `llm` profile and #1448/#1586 (C7b) folded the CPU
# variant `llm-cpu` into it — both tokens are rewritten on upgrade, so an
# existing box keeps working, but neither names a profile any more. HARDWARE
# picks the device overlay (amd => custom Vulkan build, nvidia => custom CUDA
# llama.cpp, cpu => the CPU overlay); #1448 (C8) had already merged the former
# llm-cuda in the same way.
#
# A GPUStack profile NEXT TO the manager is supported: since #1442 the manager
# registers it as an external backend and fronts it, and every consumer keeps
# talking to the one canonical endpoint. `rzfz init` does not OFFER that
# combination — a first install should not be a decision about federation — but
# nothing breaks if you add one later. (This paragraph used to say a dual box
# "deploys nothing and still reports red probes"; that stopped being true with
# #1441 and #1442.)
# #2153: this line and cli/init.sh's DEFAULT_PROFILES describe the SAME box
# (tests/unit/consistency/test_2153_*). cognee and docling are on by default
# (#520); a template without them built a box with a different document
# extractor than `rzfz init` does, and nothing said so.
COMPOSE_PROFILES=chat,cognee,dify,docling,gotenberg,llm-manager,llm-registry,llm-worker-agent,monitor,searxng,stts

# Base domain for all services (e.g., example.com)
MAIN_DOMAIN=test-razzfazz.ai

# Timezone
TZ=Europe/Berlin
GENERIC_TIMEZONE=Europe/Berlin

# TLS Certificate Mode (set by razzfazz-init.sh --tls-mode)
# "internal" = Self-signed certificates (local development/testing)
# Empty = Let's Encrypt (production, requires public domain + ports 80/443 open)
TLS_MODE=
# Caddy TLS directive (derived from TLS_MODE by razzfazz-init.sh)
# "tls internal" for self-signed, empty for Let's Encrypt
TLS_DIRECTIVE=
# #1594: TLS issuer for the two WILDCARD vHosts (*.agents, *.mcp). A wildcard
# certificate covers ONE label, so `*.<domain>` does NOT match
# `<user>.agents.<domain>` — and a wildcard can only be validated by dns-01,
# which this stack ships no plugin for. Left on the ACME path those two blocks
# retried for 30 days on a production customer domain (#1594).
#   on_demand       = ACME per-name on first visit (TLS_MODE=letsencrypt)
#   issuer internal = Caddy's internal CA (TLS_MODE=certificate | internal);
#                     these hosts are per-user proxies behind Authentik.
# DERIVED at container start by core/Caddy/entrypoint.sh from TLS_MODE — the
# value here is a seed, not the authority. That is deliberate: an upgraded box
# and a box whose TLS_MODE was changed through the portal are then both right
# without anyone editing this line.
TLS_WILDCARD_ISSUER=on_demand

# ==============================================================================
# NETWORK MODE (#184) — the single front-door for the egress axis
# ==============================================================================
# One knob governs HOW install/upgrade obtains new content. It SUPERSEDES the two
# legacy booleans below (RAZZFAZZ_CORPORATE_PROXY / RAZZFAZZ_OFFLINE), which are
# now its internal implementation:
#   online   direct egress (default). Today's behavior; no overlay.
#   proxied  egress ONLY through the corporate proxy (+ trust its CA) — #181.
#            Drives RAZZFAZZ_CORPORATE_PROXY + compose.corporate-proxy.yml.
#   offline  NO internet egress; the LAN stays up (inter-container + Dify→local
#            subnet still work) — #184. Drives RAZZFAZZ_OFFLINE + compose.offline.yml
#            + the verify-images / egress gates. Content comes from the package.
#
# IMPORTANT: the network mode governs only install/upgrade content acquisition. It
# does NOT change the UNIVERSAL runtime rule that `docker compose up` / module
# enable / disable NEVER build or pull — that holds on online, proxied AND offline
# boxes alike (WS2a). Building/downloading happens exactly once, at install.
#
# BACK-COMPAT: leave this empty to DERIVE the mode from the legacy booleans (an
# existing #181 box with RAZZFAZZ_CORPORATE_PROXY=1 keeps behaving as `proxied`).
# Change it via the wizard, which reconciles COMPOSE_FILE + the booleans:
#   rzfz setup --network-mode --mode offline      # (or online | proxied)
#   rzfz setup --network-mode --status
# For proxied you still run `rzfz setup --corporate-proxy …` (installs the host CA).
RAZZFAZZ_NETWORK_MODE=online

# ==============================================================================
# CORPORATE PROXY (#181) — OPT-IN, OFF BY DEFAULT
# ==============================================================================
# For customer sites whose internet egress goes ONLY through a corporate
# HTTP(S) forward proxy that does TLS INTERCEPTION with its own private CA.
# Without this, every outbound TLS call (docker image pulls, HuggingFace model
# downloads, Dify plugin marketplace, apt, npm/pip, git) fails with cert errors.
#
# DO NOT hand-edit these — run the wizard, which installs the CA into the host
# trust store, regenerates the certs/caddy-ca.pem superset bundle, generates the
# compose.corporate-proxy.yml overlay, and wires it into COMPOSE_FILE:
#
#   rzfz setup --corporate-proxy --proxy-url http://proxy.corp:3128 \
#              --ca-file /path/to/proxy-ca.pem [--dns 192.0.2.53] [--egress-set standard]
#   rzfz setup --corporate-proxy --status   # verify
#   rzfz setup --corporate-proxy --off      # disable
#
# See docs/enterprise/how-to/corporate-proxy.md. A non-proxied box leaves
# RAZZFAZZ_CORPORATE_PROXY=0 and is completely unaffected (no overlay generated).
#
# Master toggle: 1/true = enabled. When 1, scripts/lib.sh appends the proxy CA
# (RAZZFAZZ_EXTRA_CA_FILE) into certs/caddy-ca.pem on every init/upgrade.
RAZZFAZZ_CORPORATE_PROXY=0
# Proxy URL used for HTTP_PROXY/HTTPS_PROXY (host, docker daemon, containers).
RAZZFAZZ_PROXY_URL=
# Extra NO_PROXY entries (CSV) appended to the auto-computed internal set
# (localhost + all service names + docker subnets + MAIN_DOMAIN). Inter-container
# and same-box traffic MUST bypass the proxy — the defaults already cover it.
RAZZFAZZ_PROXY_NOPROXY=
# Corporate DNS resolver (CSV) set as the docker daemon `dns:` upstream so
# containers can resolve external names. Optional if you pin the proxy host.
RAZZFAZZ_CORPORATE_DNS=
# Box-local path to the corporate proxy CA (PEM). The wizard stages the uploaded
# CA to certs/corporate-proxy-ca.pem (gitignored) and points this at it. Never
# committed, never baked into a shared image — trust is scoped to this one box.
RAZZFAZZ_EXTRA_CA_FILE=
# Which services get the CA+proxy overlay: `standard` (maintained egress
# allow-list) or `all` (every defined service; env is harmless to non-egress).
RAZZFAZZ_PROXY_EGRESS_SET=standard
# Optional HOST:IP to pin the proxy host as extra_hosts on egress containers
# (for locked-down-DNS sites where even the proxy name won't resolve).
RAZZFAZZ_PROXY_HOST_PIN=

# ==============================================================================
# OFFLINE / AIR-GAP (#184) — internal implementation of RAZZFAZZ_NETWORK_MODE=offline
# ==============================================================================
# Do NOT hand-edit — set RAZZFAZZ_NETWORK_MODE=offline (or `rzfz setup
# --network-mode --mode offline`) and this is driven for you. When 1, install /
# upgrade skip all INTERNET-egress operations (docker build/pull, HuggingFace
# model pulls, Dify plugin marketplace, apt, external git) — content comes from
# the offline package — while LAN / inter-container traffic stays fully up.
RAZZFAZZ_OFFLINE=0

# ==============================================================================
# AIR-GAP REGISTRY MIRROR (#184 P2) — OPT-IN, OFF BY DEFAULT, orthogonal to mode
# ==============================================================================
# For an air-gap site that runs a LOCAL docker registry (a pull-through mirror)
# instead of the save/load offline package. When set (e.g. `registry.local:5000`),
# install / upgrade PULL every pinned image from `${RAZZFAZZ_REGISTRY_MIRROR}/
# <original-image-path>:<tag>` instead of the upstream registry — the generated
# compose.registry-mirror.yml overlay rewrites each PULLED service's `image:`.
# Locally-BUILT (build:) services are NOT rewritten (their image is built on the
# box, never pulled). This ONLY changes the PULL source; it does NOT change the
# UNIVERSAL runtime no-build/no-pull rule.
#
# ORTHOGONAL to RAZZFAZZ_NETWORK_MODE — a box can be online+mirror, proxied+mirror
# or offline+mirror. Leave empty for the normal (upstream-registry) behavior. The
# overlay is reconciled automatically on every init/upgrade (and by
# `rzfz setup --network-mode --status`) whenever this is set. Best-effort.
RAZZFAZZ_REGISTRY_MIRROR=

# ==============================================================================
# SERVICE VERSIONS (Docker Image Tags)
# ==============================================================================
# Keep versions pinned for stability
POSTGRES_VERSION=pg17
VALKEY_VERSION=9.1.2
BACKUP_VERSION=v2.48.2

# Core
AUTHENTIK_VERSION=2026.5.7

# Chat & LLM
OPENWEBUI_VERSION=0.11.3
# #23: Open WebUI document content-extraction engine. Empty = OWUI's built-in
# extractor. Set to `docling` to route uploads through the internal docling server
# (requires the `docling` profile) — razzfazz-post-install sets this automatically
# when docling is enabled. Uncomment to override the docling host/port.
OWUI_CONTENT_EXTRACTION_ENGINE=
# OWUI_DOCLING_SERVER_URL=http://docling:5001
PIPELINES_VERSION=git-039f9c5  # no semver; pin to a git-sha (upstream main tag)
# Hardware overlay selector for the `llm-legacy` profile. Valid: amd | nvidia | cpu.
# razzfazz-init.sh auto-detects this; override to force a specific overlay.
HARDWARE=amd
# rc6.7 #63: AMD GPU device access — must match host render gid (gid that owns /dev/dri/renderD128 and /dev/kfd; typically 992 on Ubuntu 24.04 but
# distros vary). razzfazz-init.sh detects this from `getent group render`. Wrong value → ACCEL_WORKING -13 EACCES inside gpustack.
RENDER_GID=992
# #536 (2026.09 fleet flip): uid:gid the gpustack container runs as. The AMD
# default profile `llm-legacy` runs NON-ROOT out of the box — live-verified on
# 0.91 (ready_replicas:1, rerank on GPU); the header of modules/llm/compose.yml
# (service gpustack-legacy) records the verification and the three
# prerequisites. The other gpustack variants (upstream `llm` / `llm-cpu`,
# `llm-cuda`) are NOT verified de-rooted and still run as root; de-root them at
# your own risk with modules/llm/compose.nonroot.yml.
# OPT-OUT (one line, no COMPOSE_FILE surgery): set BOTH to 0 and recreate
# gpustack — the container is root again. `rzfz upgrade` re-owns the
# gpustack-data volume once when a box flips (Step 7c) and refuses to flip a
# box whose gpustack image predates the flip.
GPUSTACK_UID=1000
GPUSTACK_GID=1000
# M018 / S03.5 — GPUStack scheduler resource reservations. The scheduler
# refuses to place additional model instances if doing so would push
# host RAM or GPU VRAM past these reserves. Mitigation for the host-OOM
# cascade observed in the S03.1 stress test (5h sustained inference →
# kernel SVM/userptr workqueue thrash → OOM-killed llama-server). Defaults
# below are the rc5 baseline for the 32 GiB host RAM + 96 GiB BIOS-pinned
# VRAM Strix Halo single-box layout. Tune up if you have more RAM, or down
# if you can demonstrate sustained-load stability with less.
GPUSTACK_RESERVED_RAM_GIB=8
GPUSTACK_RESERVED_VRAM_GIB=4

# Docker platform architecture (auto-detected by razzfazz-init.sh)
# linux/amd64 for x86_64, linux/arm64 for Apple Silicon / ARM64
DOCKER_PLATFORM=linux/amd64

# Dify
DIFY_VERSION=1.17.1
DIFY_SANDBOX_VERSION=0.2.15
DIFY_PLUGIN_VERSION=0.6.10-local
# DIFY_APPS_JSON: populated by modules/dify/seed-apps.sh after the operator creates
# example apps in the Dify UI. JSON array consumed by modules/chat/functions/dify_pipe.py.
# Format: [{"id":"<pipe_id>","name":"<display>","api_key":"app-...","type":"chat|workflow|completion"}, ...]
DIFY_APPS_JSON=[]
# DIFY_DOC_TOOLS_SSRF_ALLOW: SSRF-proxy allow-list of internal AI-tool services —
# ga.6 STANDARD. Space-separated hosts a Dify workflow / plugin may reach THROUGH
# the forward proxy (caddy:8195). Dify (api/worker/sandbox/plugin-daemon) sits on
# the isolated ssrf_proxy_network and routes ALL outbound through this proxy, so
# anything a workflow orchestrates — INCLUDING the LLM backend (gpustack) — must be
# listed here or the RFC1918 deny blocks it (LLM nodes would 403). As of ga.6 the
# full internal AI-tool set is allowed BY DEFAULT so workflows work out of the box:
# LLM/inference (gpustack, ollama-proxy, speaches), search/crawl (searxng,
# crawl4ai), doc-processing (docling, tika, presidio-*, stirling-pdf, gotenberg)
# and RAG (lightrag, cognee, cognee-mcp).
# NOT "open SSRF": the Caddyfile acl is first-match-wins — ONLY these named hosts
# are permitted; every other RFC1918 address (postgres, valkey, authentik, the
# socket-proxy, …) stays DENIED. Hosts whose module isn't enabled are unreachable →
# harmless to list. (OpenWebUI + personal agents are NOT on the SSRF proxy — they
# reach services directly on the default network, so they need no entry here.)
# MUST NOT be empty — Caddy's `allow {$VAR:default}` only applies the default when
# UNSET; a set-but-empty value expands to a bare `allow` and crashes Caddy. Use the
# non-resolving sentinel `disabled.invalid` to fully close instead.
# #1548 — THIS LIST IS ALSO AN AUTHENTICATION BOUNDARY. The forward proxy runs
# inside the Caddy container, so anything it reaches sees Caddy's source IP —
# which `llm-manager`, the Config Portal, the start portal, the agent manager and
# the MCP manager all accept as proof that Authentik's forward_auth handled the
# request. The proxy now strips `X-Authentik-*` / `X-Rzfz-*` from every forwarded
# request (core/Caddy/Caddyfile, guarded by
# tests/api/network/test_1548_forward_proxy_strips_identity.py), so a client can
# no longer assert an identity through it. Do not add a service that authenticates
# on that source-IP anchor here without re-reading that guard first.
DIFY_DOC_TOOLS_SSRF_ALLOW=gpustack ollama-proxy speaches searxng crawl4ai docling tika presidio-analyzer presidio-anonymizer presidio-image-redactor stirling-pdf gotenberg lightrag cognee cognee-mcp gitea

# Git
GITEA_VERSION=1.27.3

# Tools & Monitoring
SEARXNG_VERSION=2026.7.19-6da6eee26
GOTENBERG_VERSION=8.37.0
KOMODO_VERSION=2.3.3
KOMODO_DB_VERSION=17-0.107.0-ferretdb-2.7.0 # ferretdb-postgres
FERRETDB_VERSION=2.7.0
SPEACHES_VERSION=0.8.3-cpu

# ==============================================================================
# SUBDOMAINS & PUBLIC URLS
# ==============================================================================
OPENWEBUI_DOMAIN=chat.${MAIN_DOMAIN}
GPUSTACK_DOMAIN=gpustack.${MAIN_DOMAIN}
KOMODO_DOMAIN=admin.${MAIN_DOMAIN}
DIFY_DOMAIN=dify.${MAIN_DOMAIN}
AUTHENTIK_DOMAIN=auth.${MAIN_DOMAIN}
BACKUP_DOMAIN=backup.${MAIN_DOMAIN}
LICENSE_DOMAIN=license.${MAIN_DOMAIN}
# M028 — post-login start portal (replaces Authentik App library as the launcher)
START_DOMAIN=start.${MAIN_DOMAIN}
GITEA_DOMAIN=git.${MAIN_DOMAIN}
HELP_DOMAIN=help.${MAIN_DOMAIN}

# Autowarm retry schedule for the Help mirror, in WHOLE SECONDS, comma
# separated — NO unit suffix (`120,300,900`, not `120,300s`).
# #1284: the first mirroring pass runs once at container start; a source that
# rate-limits or truncates during that pass left its section permanently
# empty, a different section on every install. These are the delays between
# the follow-up passes; an app whose cache is already healthy costs nothing in
# a later pass. Unparseable input warns once and falls back to the default.
HELP_AUTOWARM_RETRY_DELAYS=120,300,900
# (#22) SETUP_DOMAIN removed in 2026.07 — the setup.<domain> web UI is gone;
# use the Settings portal (SETTINGS_DOMAIN) and the `rzfz setup` CLI.
# #1200 (2026.09): the portal is "Settings" in the UI (#1198) and now answers on
# settings.<domain>. CONFIG_DOMAIN stays for ONE cycle as the legacy hostname:
# Caddy serves it as a 301 -> SETTINGS_DOMAIN so bookmarks and customer docs
# keep working. Point nothing new at CONFIG_DOMAIN. TLS_MODE=certificate boxes:
# the operator certificate must cover settings.<domain> (SAN or wildcard) —
# `rzfz upgrade` warns when it does not.
SETTINGS_DOMAIN=settings.${MAIN_DOMAIN}
CONFIG_DOMAIN=config.${MAIN_DOMAIN}

# Email for Let's Encrypt config in Caddy
LETSENCRYPT_EMAIL=support@razzfazz.ai

# Support contact address used by the Configuration Portal "Get Support" /
# log-snapshot flow. Falls back to support@razzfazz.ai when empty.
SUPPORT_EMAIL=

# (#54) Admin contact surfaced as the "Contact your administrator" mailto link
# in the Start Portal password-change UI. Defaults to
# razzfazz-ai-admin@<MAIN_DOMAIN> when unset.
ADMIN_CONTACT_EMAIL=

# (#2002) Where the stack's own alerts go: the mailbox a human reads. Seeded by
# `rzfz init` from the admin e-mail it asks for. Consumers: Wazuh mails alerts
# at or above WAZUH_EMAIL_ALERT_LEVEL here through the internal smtp-relay.
# Empty = alert mail stays OFF (falls back to ADMIN_CONTACT_EMAIL first) — the
# render logs that it is off, because a SIEM nobody hears from is the defect.
RAZZFAZZ_OPERATOR_EMAIL=

# (#248 P2) Authentik group name whose members may publish a razzfazz-shortcuts
# tile at visibility="company" (broadcasts to every user), in addition to
# admins (`authentik Admins` / `razzfazz.ai Super Admins`), who may always
# publish company-wide regardless of this setting. Defaults to
# "razzfazz.ai Shortcut Authors" when unset — create that group in Authentik
# before relying on it; an unset/nonexistent group simply means only admins
# can publish company-wide (fail-closed, not an error).
SHORTCUT_AUTHORS_GROUP=

# ==============================================================================
# DATABASES (Shared)
# ==============================================================================
# PostgreSQL Connection Details
POSTGRES_USER=docker
# Generated by razzfazz-init.sh — do not use example values in production
POSTGRES_PASSWORD=
POSTGRES_DB=main_db
POSTGRES_PORT=5432

# Per-service database users (created by core/init-db.sh)
# Each service gets a dedicated user with access restricted to its own database.
# Passwords are generated by razzfazz-init.sh.
AUTHENTIK_DB_USER=authentik_user
AUTHENTIK_DB_PASSWORD=
OPENWEBUI_DB_USER=openwebui_user
OPENWEBUI_DB_PASSWORD=
GPUSTACK_DB_USER=gpustack_user
GPUSTACK_DB_PASSWORD=
DIFY_DB_USER=dify_user
DIFY_DB_PASSWORD=
DIFY_PLUGIN_DB_USER=dify_plugin_user
