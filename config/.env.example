# All secrets below are generated by razzfazz-init.sh. Do not ship real values here.

# OpenWebUI Secret Key
WEBUI_SECRET_KEY=

# Pipelines API Key (External Auth for Pipelines)
PIPELINES_API_KEY=

# Authentik Secret Key
AUTHENTIK_SECRET_KEY=

# Dify Plugin Daemon Keys
# Key for the daemon server
PLUGIN_DAEMON_KEY=
# Key for internal communication
PLUGIN_DIFY_INNER_API_KEY=
# Dify Sandbox API Key (generated by razzfazz-init.sh)
SANDBOX_API_KEY=

# ==============================================================================
# SERVICE PORTS (Internal/External Mapping)
# ==============================================================================
OPENWEBUI_PORT=8080
SEARXNG_PORT=8088
SPEACHES_PORT=5003
KOMODO_PORT=8180
KOMODO_PERIPHERY_PORT=8120
GPUSTACK_PORT=9090
GOTENBERG_PORT=3005

# ==============================================================================
# GITEA CONFIGURATION
# ==============================================================================
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=2222

# Generated by razzfazz-init.sh
GITEA_SECRET_KEY=
GITEA_INTERNAL_TOKEN=
GITEA_ADMIN_USER=admin
GITEA_ADMIN_PASSWORD=
GITEA_ADMIN_EMAIL=razzfazz-ai-admin@localhost

# ==============================================================================
# LIGHTRAG CONFIGURATION [EXPERIMENTAL]
# ==============================================================================
# LightRAG is experimental and not included in any init package preset.
# Enable manually via setup UI or by adding 'lightrag' to COMPOSE_PROFILES.
# Graph storage uses file-based NetworkX (persisted to lightrag-data volume).
# ==============================================================================
LIGHTRAG_VERSION=v1.5.5
LIGHTRAG_PORT=9621
LIGHTRAG_DB=lightrag_db
LIGHTRAG_DOMAIN=rag.${MAIN_DOMAIN}

# LightRAG API Key (for programmatic access via X-API-Key header)
# Generated by razzfazz-init.sh
LIGHTRAG_API_KEY=

# LightRAG Auth (WebUI login credentials)
# Generated by razzfazz-init.sh
LIGHTRAG_TOKEN_SECRET=
LIGHTRAG_AUTH_ACCOUNTS=

# LightRAG LLM/Embedding models (must be deployed in GPUStack)
# Defaults match razzfazz-post-install.sh's standard preset; profile_provisioner
# back-fills these on profile-enable if left empty.
LIGHTRAG_LLM_MODEL=qwen3.6
LIGHTRAG_EMBEDDING_MODEL=qwen3-embedding
# EMBEDDING_DIM MUST equal the model's native output dim — the GPUStack/llama-box
# endpoint IGNORES the OpenAI `dimensions` param (measured: 768/2560/4096 all
# return 4096). qwen3-embedding emits 4096-dim vectors; 768 was nomic's dim.
LIGHTRAG_EMBEDDING_DIM=4096
# The endpoint ignores `dimensions`, so don't send it (misleading). Set true only
# for a model/runner that actually honours dimension truncation.
LIGHTRAG_EMBEDDING_SEND_DIM=false

# LightRAG Reranking (optional, uses cohere-compatible endpoint via GPUStack)
# Set LIGHTRAG_RERANK_BINDING=null to disable
LIGHTRAG_RERANK_BINDING=null
LIGHTRAG_RERANK_MODEL=

# LightRAG Timeouts (seconds)
LIGHTRAG_EMBEDDING_TIMEOUT=120
LIGHTRAG_LLM_TIMEOUT=300

# Authentik client secret for LightRAG proxy provider
LIGHTRAG_CLIENT_SECRET=

# ==============================================================================
# COGNEE CONFIGURATION [EXPERIMENTAL]
# ==============================================================================
# Cognee is experimental and not included in any init package preset.
# Enable manually via setup UI or by adding 'cognee' to COMPOSE_PROFILES.
# Uses Kuzu (embedded) for graph storage and PostgreSQL/pgvector for vector/relational.
# ==============================================================================
COGNEE_PORT=8011
# Host port for cognee-frontend (Next.js UI built from upstream source — rc6.7 #57)
COGNEE_FRONTEND_PORT=8012
COGNEE_DB=cognee_db
COGNEE_DOMAIN=cognee.${MAIN_DOMAIN}
COGNEE_LOG_LEVEL=INFO

# Cognee LLM/Embedding models (must be deployed in GPUStack)
# Defaults match razzfazz-post-install.sh's standard preset; profile_provisioner
# back-fills these on profile-enable if left empty. The `openai/` prefix on the
# LLM model is required because LLM_PROVIDER=custom routes through litellm,
# which raises BadRequestError("LLM Provider NOT provided") on bare model names.
# Embedding uses openai_compatible (cognee's OpenAICompatibleEmbeddingEngine,
# direct openai SDK), so the bare name is correct there.
COGNEE_LLM_MODEL=openai/gemma4
# M031 S3: cognee passes this JSON to litellm as kwargs. core/llm/sync.py
# updates max_tokens here when it runs. Default keeps thinking-mode off
# (gemma4/qwen3 support it but cognee's graph extractors prefer non-thinking).
# NOTE: GPUStack/llama-box honours the disable ONLY via chat_template_kwargs;
# the bare extra_body.enable_thinking (vLLM convention) and a /no_think prompt
# are both ignored, so qwen3.6 keeps reasoning and cognify times out (#170).
LLM_ARGS={"extra_body":{"chat_template_kwargs":{"enable_thinking":false}}}
COGNEE_EMBEDDING_MODEL=nomic-embed-text
COGNEE_EMBEDDING_DIM=768
# HuggingFace tokenizer for local embedding models (e.g. nomic-ai/nomic-embed-text-v1)
COGNEE_EMBEDDING_TOKENIZER=

# #186 (Defect 1): auto-migrate the on-disk graph store when it is left in an
# OLDER ladybug storage format after a cognee upgrade (e.g. 0.16 -> 0.17), which
# otherwise makes the knowledge-graph viz read empty SILENTLY. On start,
# kuzu-migrate.py backs up the store then runs cognee's official export/import
# migration (storage-format gated, non-fatal). Set to false on air-gapped boxes
# or to migrate under a maintenance window — the helper then only DETECTS the
# stale format and logs the manual `ladybug_migrate …` recovery command.
# The automatic path needs PyPI egress during the one-time migration.
COGNEE_KUZU_AUTO_MIGRATE=true

# Authentik client secret for Cognee proxy provider
COGNEE_CLIENT_SECRET=

# ==============================================================================
# APACHE TIKA CONFIGURATION [EXPERIMENTAL]
# ==============================================================================
# Profile: tika
# Internal-only document analysis REST API (text + metadata extraction).
# Access via Docker DNS: http://tika:9998
TIKA_PORT=9998

# ==============================================================================
# DOCLING SERVE CONFIGURATION [EXPERIMENTAL]
# ==============================================================================
# Profile: docling
# Document conversion API with Swagger (/docs) and Gradio (/ui) interfaces.
# VLM pipeline mode: zero local models — delegates to granite-docling on GPUStack.
# User-facing at https://docling.${MAIN_DOMAIN} behind Authentik SSO.
DOCLING_PORT=5001
DOCLING_CLIENT_SECRET=
# #129: docling runs a two-process RQ engine on valkey (DB 9) so the Gradio UI
# works with >1 uvicorn worker. Conversion concurrency now lives in the
# separate docling-rq-worker; this is its replica count (the real knob).
# UVICORN_WORKERS stays for HTTP concurrency (DOCLING_UVICORN_WORKERS, default 3).
DOCLING_RQ_WORKER_REPLICAS=2
# DOCLING_UVICORN_WORKERS=3

# ==============================================================================
# PRESIDIO CONFIGURATION [EXPERIMENTAL]
# ==============================================================================
# Profile: presidio
# PII detection (Analyzer) and image redaction (Image Redactor).
# Internal-only — no Caddy, no Authentik.
# Access via Docker DNS: presidio-analyzer:3000 / presidio-image-redactor:3000
PRESIDIO_ANALYZER_PORT=5100
PRESIDIO_ANONYMIZER_PORT=5300
PRESIDIO_IMAGE_REDACTOR_PORT=5200

# ==============================================================================
# STIRLING-PDF CONFIGURATION [EXPERIMENTAL]
# ==============================================================================
# Profile: stirling-pdf
# Full-featured PDF manipulation web UI. Authentik handles all auth.
# User-facing at https://pdf.${MAIN_DOMAIN}
STIRLING_PDF_PORT=8181
STIRLING_CLIENT_SECRET=

# ==============================================================================
# PAPERCLIP CONFIGURATION [EXPERIMENTAL]
# ==============================================================================
# Open-source AI company orchestration platform.
# Hire AI employees, set goals, automate jobs — org chart, tasks, budgets.
# Upstream: https://github.com/paperclipai/paperclip (MIT)
# User-facing at https://paperclip.${MAIN_DOMAIN}
# Note: PAPERCLIP_BETTER_AUTH_SECRET must NEVER be rotated — it invalidates
#       all user sessions. It is generated once by razzfazz-init.sh.
PAPERCLIP_VERSION=v2026.707.0
PAPERCLIP_PORT=3100
PAPERCLIP_DOMAIN=paperclip.${MAIN_DOMAIN}
PAPERCLIP_DB=paperclip_db
PAPERCLIP_DB_PASSWORD=
PAPERCLIP_BETTER_AUTH_SECRET=
PAPERCLIP_CLIENT_SECRET=

# ==============================================================================
# SYNAPSE MATRIX HOMESERVER CONFIGURATION [EXPERIMENTAL]
# ==============================================================================
# Matrix homeserver — powers the razzfazz.ai internal Matrix network.
# Used by Moltis (bot account) and Element Web (browser client).
# Upstream: https://github.com/element-hq/synapse (AGPL-3.0)
# Note: SYNAPSE_SERVER_NAME is PERMANENT — cannot change after first start.
#       Sets Matrix user IDs to @username:${MAIN_DOMAIN}.
# Note: SYNAPSE_MACAROON_SECRET_KEY must NEVER be rotated — breaks Matrix tokens.
# Note: SYNAPSE_REGISTRATION_SHARED_SECRET is used by post-install to create
#       the Moltis bot account via the admin API.
SYNAPSE_DB=synapse_db
SYNAPSE_DB_PASSWORD=
MATRIX_DOMAIN=matrix.${MAIN_DOMAIN}
ELEMENT_WEB_DOMAIN=element.${MAIN_DOMAIN}
SYNAPSE_SERVER_NAME=${MAIN_DOMAIN}
SYNAPSE_REPORT_STATS=no
SYNAPSE_REGISTRATION_SHARED_SECRET=
SYNAPSE_MACAROON_SECRET_KEY=
SYNAPSE_FORM_SECRET=
SYNAPSE_CLIENT_SECRET=
MATRIX_CLIENT_ID=

# ==============================================================================
# (M020 S07) MOLTIS + HERMES global config removed — both are now per-user via
# agent-manager (`agents` profile). Per-user instances are launched from the
# "My Agents" dashboard at https://agents.${MAIN_DOMAIN}/dashboard. Per-instance
# secrets (MOLTIS password, HERMES API_SERVER_KEY) are generated by the
# agent-manager provisioner at launch and stored in the per-instance config
# JSONB column — they're returned to the OpenWebUI pipes via the user-scoped
# /api/find/<agent_type> endpoint.
#
# Build-time image pins for the per-user agent images (locally built once, then
# provisioned per-user by agent-manager). Match the compose ${VAR:-default}
# fallbacks in modules/agents/compose.yml and the manifest runtime_only pins.
# Bump via the check-and-bump-versions skill.
HERMES_AGENT_VERSION=v2026.8.3
MOLTIS_VERSION=20260719.01
# ==============================================================================

# Element Web (Matrix browser client) — served alongside Synapse
ELEMENT_WEB_CLIENT_SECRET=

# ==============================================================================
# GPUSTACK CONFIGURATION
# ==============================================================================
# GPUStack Mode: standalone, master, or worker
# standalone: All ports bound to localhost only (default, no external workers)
# master: All ports bound to 0.0.0.0 (accepts external worker connections)
# worker: Connect to a remote GPUStack master server as compute node
GPUSTACK_MODE=standalone
# Port bind address (auto-set by razzfazz-init.sh based on GPUSTACK_MODE)
# 127.0.0.1 = standalone, 0.0.0.0 = master/worker
GPUSTACK_BIND=127.0.0.1
# Worker IP address advertised to master (host IP, not Docker-internal IP)
# Only for worker nodes - auto-detected by razzfazz-init.sh
GPUSTACK_WORKER_IP=
# Worker name shown in master UI (defaults to hostname if empty)
GPUSTACK_WORKER_NAME=

# Per-service admin password (generated by razzfazz-init.sh, unique per service)
GPUSTACK_ADMIN_PASSWORD=

GPUSTACK_DATABASE_URL="postgresql://${GPUSTACK_DB_USER}:${GPUSTACK_DB_PASSWORD}@postgres:5432/${GPUSTACK_DB}"
GPUSTACK_MASTER_SERVER_URL=   # Only for worker nodes
GPUSTACK_MASTER_SERVER_TOKEN= # Only for worker nodes
# GPUStack API Key for model-sync service (generate in GPUStack UI after first start)
# Set via: rzfz setup --set-gpustack-api-key <KEY>  or the Configuration Portal (config.<domain> -> Settings -> GPUStack)
# IMPORTANT: These are placeholders — you MUST replace them after GPUStack's first start.
# Log in to https://llm.<domain>, create an API key, then run:
#   rzfz setup --set-gpustack-api-key <KEY>
GPUSTACK_API_KEY=gpustack_CHANGEME_AFTER_FIRST_START
# GPUStack OpenAI-compatible API Key for ollama-proxy
# IMPORTANT: Same as above — must be replaced with a real key from GPUStack UI.

# ------------------------------------------------------------------------------
# LLM backpressure limiter (#19 — "option C", box-wide 429 backpressure)
# ------------------------------------------------------------------------------
# Caddy caps the rate of OpenAI-compat inference requests (llm.<domain>/v1-openai*)
# admitted to gpustack ACROSS ALL clients that reach it via the public ingress,
# returning 429 + Retry-After once the cap is exceeded — so an overload backs off
# instead of piling onto gpustack until it OOMs/storms. Complements the per-app
# Dify max_active_requests guard (#30). Box-wide (single shared bucket), NOT
# per-IP.
#
# LLM_MAX_CONCURRENT       = inference requests admitted per window (the cap).
# LLM_MAX_CONCURRENT_WINDOW = the window (Caddy duration, e.g. 1s, 500ms, 2s).
#
# DEFAULT = OFF: 100000/1s is effectively unlimited, so existing installs are
# never throttled. To enable backpressure, set a real cap sized to your box,
# e.g. LLM_MAX_CONCURRENT=8 with LLM_MAX_CONCURRENT_WINDOW=1s. Apply with
# `docker compose up -d --force-recreate caddy`.
#
# NOTE: consumers that dial gpustack:9090 by Docker DNS directly (OWUI, cognee,
# lightrag, agents) bypass Caddy and are not covered by this ingress cap.
LLM_MAX_CONCURRENT=100000
LLM_MAX_CONCURRENT_WINDOW=1s

# ------------------------------------------------------------------------------
# Mac LLM gateway (profile: mac-llm) — opt-in, OFF by default (2026.08)
# ------------------------------------------------------------------------------
# A LiteLLM proxy (llm-mac-gateway) that fronts one-or-more Macs running Ollama
# (Apple-Silicon / MLX) as a SECOND OpenAI-compatible endpoint, load-balanced +
# health-checked. GPUStack is UNTOUCHED. Enable by adding `mac-llm` to
# COMPOSE_PROFILES AND creating modules/llm/mac-gateway/config.yaml (copy
# config.example.yaml and declare your Macs). See modules/llm/mac-gateway/README.md.
#
# MAC_GATEWAY_MASTER_KEY: stack components authenticate to the gateway with this.
#   REQUIRED when mac-llm is enabled — generate a strong random secret.
# MAC_GATEWAY_PORT: loopback host-side port for operator debug (127.0.0.1 only);
#   in-network consumers use llm-mac-gateway:4000 via Docker DNS.
# LITELLM_VERSION: pinned LiteLLM image tag (ghcr.io/berriai/litellm:<tag>).
#   Repin to a reviewed tag / @sha256 digest at ship (security review).
MAC_GATEWAY_MASTER_KEY=
MAC_GATEWAY_PORT=4000
LITELLM_VERSION=main-v1.83.7-stable

# ==============================================================================
# OPENWEBUI CONFIGURATION
# ==============================================================================
WEBUI_URL=https://${OPENWEBUI_DOMAIN}
OLLAMA_BASE_URL= # Blank for OpenAI compatible API usage via GPUStack
# Open WebUI OpenAI-compatible endpoints (2026.08). OWUI takes a ;-separated
# list of base URLs paired 1:1 with keys. GPUStack is always endpoint #1; when
# the `mac-llm` profile is enabled, append the Mac gateway as endpoint #2:
#   OWUI_OPENAI_BASE_URLS=http://gpustack:9090/v1-openai;http://llm-mac-gateway:4000/v1
#   OWUI_OPENAI_KEYS=${GPUSTACK_API_KEY};${MAC_GATEWAY_MASTER_KEY}
# Defaults keep the GPUStack-only wiring so existing boxes are unchanged (the
# gateway is unreachable unless mac-llm is on). The P2 Config Portal toggle
# writes these automatically.
OWUI_OPENAI_BASE_URLS=http://gpustack:9090/v1-openai
# Left EMPTY on purpose: docker-compose does NOT recursively expand a .env value, so
# `${GPUSTACK_API_KEY}` here would reach Open WebUI as a LITERAL string and break auth
# (GPUStack 401 -> "no models"). razzfazz-post-install.sh resolves this to the live
# GPUStack key (both fresh + --refresh); the mac-llm / Config Portal toggle may override
# with a multi-backend "gpustack;mac" combo.
OWUI_OPENAI_KEYS=
# Open WebUI ships fast (multiple 0.9.x patches per week). The default
# in-app "update available" banner pings GitHub on every page load and
# is noise for fleets that pin OPENWEBUI_VERSION via this .env. Disable
# the version-check call + the banner stack-wide. Operators who want to
# track upstream releases can flip back to true on their own .env.
ENABLE_VERSION_UPDATE_CHECK=false

# ==============================================================================
# GOOGLE OAUTH (Scenario: google)
# ==============================================================================
# Set to true when using --scenario google, false for --scenario base
ENABLE_GOOGLE_OAUTH=false
# Derived: set to true when ENABLE_GOOGLE_OAUTH or ENABLE_OPENWEBUI_OIDC is true.
# Controls ENABLE_OAUTH_SIGNUP in Open WebUI — allows new users to register via OAuth/OIDC.
# Managed automatically by razzfazz-init.sh. Do not set manually.
ENABLE_OAUTH_SIGNUP=false
# Set by razzfazz-init.sh --scenario google (interactive prompt or --google-client-id / --google-client-secret)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Restrict Google OAuth to specific domain (e.g., seqis.com)
GOOGLE_OAUTH_DOMAIN=seqis.com

# ==============================================================================
# MICROSOFT ENTRA ID OAUTH (SSO)
# ==============================================================================
# Enable Microsoft Entra ID (formerly Azure AD) as a second SSO source.
# Can be enabled independently of or alongside ENABLE_GOOGLE_OAUTH.
# Requires an App Registration in Microsoft Entra ID (Azure Portal):
#   - Redirect URI: https://auth.<domain>/source/oauth/callback/entra/
#   - API permissions: openid, profile, email
#   - Single-tenant: set ENTRA_TENANT_ID to your Directory (tenant) ID
ENABLE_ENTRA_OAUTH=false
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
# Optional: restrict enrollment to accounts with this email domain.
# Leave empty to allow all accounts from the configured tenant.
# Useful for blocking guest/B2B accounts that exist in your tenant.
ENTRA_OAUTH_DOMAIN=

# ==============================================================================
# NATIVE OIDC — Open WebUI & Gitea (via Authentik)
# ==============================================================================
# When enabled, Open WebUI / Gitea authenticate natively via Authentik OIDC
# and auto-provision users on first login. Caddy forward-auth is retained
# as a defense-in-depth outer layer.
# Client ID/Secret are auto-seeded by razzfazz-init.sh (#30): the init's
# secret-generation step sets OPENWEBUI_OIDC_CLIENT_ID=openwebui_oidc_client and
# a random OPENWEBUI_OIDC_CLIENT_SECRET. They feed BOTH the Authentik
# openwebui-oidc blueprint (the provider) and the Open WebUI container env. Set
# ENABLE_OPENWEBUI_OIDC=true to activate native SSO login (removes OWUI's second
# login). init-authentik.sh applies the blueprint only when both are non-empty.
# #70: defaults TRUE so a fresh box has working native OIDC out of the box —
# the openwebui-oidc Authentik app + provider exist, OWUI's "Continue with
# Authentik" button resolves (was 404 on clean install), and discovery is
# fetched over the live Caddy CA (#55). Caddy forward-auth remains the
# defense-in-depth outer gate. Creds are seeded unconditionally below, so the
# blueprint gate is satisfied on every clean init.
ENABLE_OPENWEBUI_OIDC=true
OPENWEBUI_OIDC_CLIENT_ID=openwebui_oidc_client
OPENWEBUI_OIDC_CLIENT_SECRET=

# Gitea native OIDC against Authentik (#29). Client ID/Secret are auto-seeded by
# razzfazz-init.sh: GITEA_OIDC_CLIENT_ID=gitea_oidc_client + a random
# GITEA_OIDC_CLIENT_SECRET. They feed the Authentik gitea-oidc blueprint and
# modules/gitea/init-gitea.sh (`gitea admin auth add-oauth --auto-discover-url
# …/gitea-oidc/…`). Set ENABLE_GITEA_AUTHENTIK_OIDC=true to activate the
# "Sign in with Authentik" button; Gitea auto-registers the OIDC user on first
# login. init-authentik.sh applies the blueprint only when both are non-empty.
# #70: defaults TRUE (see ENABLE_OPENWEBUI_OIDC) — on a fresh box init-gitea.sh
# runs `gitea admin auth add-oauth` so the "Sign in with Authentik" button is
# wired (was 404 on clean install) and the gitea-oidc Authentik app exists.
ENABLE_GITEA_AUTHENTIK_OIDC=true
GITEA_OIDC_CLIENT_ID=gitea_oidc_client
GITEA_OIDC_CLIENT_SECRET=
# Derived by razzfazz-init.sh: true when Google OAuth OR Authentik OIDC is
# enabled. Gates Gitea's GITEA__oauth2_client__ENABLE_AUTO_REGISTRATION so SSO
# users self-provision on first login.
GITEA_OAUTH_AUTO_REGISTER=false

# ------------------------------------------------------------------------------
# TRUE SSO — group -> in-app role mapping (#33)
# ------------------------------------------------------------------------------
# The 4 native-OIDC apps (Open WebUI, Gitea, Matrix/Synapse, Vaultwarden)
# auto-provision the SSO user on first login, but everyone historically landed
# as a plain "user". This maps an Authentik GROUP -> the app's admin role via
# each app's native OIDC group-claim mechanism. Authentik emits the user's group
# names as a `groups` claim (core/Authentik/blueprints/base/06-oauth-groups-scope.yaml).
#
# SSO_ADMIN_GROUP is the Authentik group whose members become in-app ADMINS.
# It reuses the existing tier/group model — do NOT hardcode a user. Default is
# the superuser group seeded by 02-groups.yaml.
SSO_ADMIN_GROUP=razzfazz.ai Super Admins
#
# Open WebUI role management. When true, OWUI derives each user's role from their
# Authentik groups on EVERY OIDC login: admin if in OAUTH_ADMIN_ROLES, user if in
# OAUTH_ALLOWED_ROLES, else denied. Fresh installs default ON — the seeded admin
# (akadmin) is in "razzfazz.ai Super Admins", so it maps to admin with no lockout.
# NOTE: the UPGRADE migration (migrations/env-changes.json) adds this as FALSE on
# existing boxes, because turning it on re-evaluates existing users and would
# demote an OWUI admin who is NOT in SSO_ADMIN_GROUP. On upgrade, flip to true
# only after confirming your operator account is in "razzfazz.ai Super Admins".
ENABLE_OWUI_OAUTH_ROLE_MANAGEMENT=true
# Groups (comma-separated) allowed to sign in to Open WebUI as regular users.
# Members of SSO_ADMIN_GROUP additionally get admin (OAUTH_ADMIN_ROLES).
OWUI_OAUTH_ALLOWED_ROLES=razzfazz.ai Chat Users,razzfazz.ai Super Admins
# Gitea maps SSO_ADMIN_GROUP -> Gitea site admin automatically via its OIDC
# source (--admin-group + --group-claim-name groups) — no separate toggle;
# always active whenever ENABLE_GITEA_AUTHENTIK_OIDC=true.
#
# Matrix/Synapse and Vaultwarden: OIDC group->admin-ROLE is NOT supported by
# these apps in their stable configs (Synapse server-admin is a DB/admin-API
# flag; Vaultwarden's admin panel is a shared ADMIN_TOKEN). The `groups` claim
# is emitted for them anyway; elevate their admins manually. See PR / brief.

# ==============================================================================
# AUTHENTIK CONFIGURATION
# ==============================================================================
# Generated by razzfazz-init.sh — do not use example values in production
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_TOKEN=

# SMTP / Email — passed through to Authentik (internal relay, no credentials needed)
AUTHENTIK_EMAIL__HOST=smtp-relay
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=
AUTHENTIK_EMAIL__USE_TLS=false
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__FROM=${SMTP_FROM:-noreply@${MAIN_DOMAIN}}
AUTHENTIK_EMAIL__TIMEOUT=10

# B-11 — Tighter MFA policy default (NIS2 21(2)(j)).
# When `true` (the default for new installs), the shipped Authentik
# blueprint `core/Authentik/blueprints/base/07-mfa-policy.yaml` enables
# the `razzfazz.ai - Require Admin MFA` PolicyBinding, which gates the
# default-authentication-flow's MFA-validation stage on Super Admins
# group membership. Combined with the upstream stage's
# `not_configured_action: configure`, every member of `razzfazz.ai
# Super Admins` (akadmin + any operator-promoted admin) is force-walked
# through TOTP / WebAuthn / Static enrolment on their next login if
# they don't yet have an authenticator registered. Non-admin users
# (customer end-users / per-app-group users) are unaffected.
#
# Set to `false` to disable the policy WITHOUT removing the blueprint
# (so flipping back to `true` later doesn't recreate IDs).
#
# Existing installs (upgrade path): this var is NOT auto-added to the
# customer's `.env` by `razzfazz-upgrade.sh` — the operator decides
# post-handover whether to opt in. New installs land with the default
# (`true`) baked in.
RAZZFAZZ_REQUIRE_ADMIN_MFA=true

# Options: 'base' or 'google' (set by razzfazz-init.sh --scenario)
DEPLOYMENT_SCENARIO=base

# Secrets referenced in blueprints (Best Practice)
# Authentik proxy provider client secrets (generated by razzfazz-init.sh)
CHAT_CLIENT_SECRET=

# ==============================================================================
# SMTP RELAY CONFIGURATION
# ==============================================================================
# Centralized SMTP relay for all services (Authentik, Dify, Gitea, OpenWebUI).
# All services send to the internal smtp-relay container on port 587.
# The relay can either send directly or forward to an external SMTP provider.
#
# SMTP_MODE: "relay" or "direct"
#   relay  = Forward through external SMTP provider (recommended for deliverability)
#   direct = Send directly to recipient MX servers (requires SPF/DKIM/DMARC DNS records)
SMTP_MODE=relay

# Internal SASL password for Docker-internal SMTP relay (generated by razzfazz-init.sh)
# Used by services that require SMTP authentication (e.g., Dify email plugin)
SMTP_INTERNAL_PASSWORD=

# Sender address used by all services
SMTP_FROM=razzfazz-ai-box-1@${MAIN_DOMAIN}

# Allowed sender domains for the SMTP relay container
# Add additional domains if SMTP_FROM uses a different domain than MAIN_DOMAIN
# SMTP_ALLOWED_SENDER_DOMAINS=${MAIN_DOMAIN} otherdomain.com

# --- Relay Mode Settings (only used when SMTP_MODE=relay) ---
# External SMTP provider credentials
# For Google Workspace SMTP Relay (IP-based auth): smtp-relay.gmail.com
# For Gmail with App Password: smtp.gmail.com
# For Mailgun/Brevo/SendGrid: use their SMTP credentials
SMTP_RELAY_HOST=smtp-relay.gmail.com
SMTP_RELAY_PORT=587
SMTP_RELAY_USERNAME=
SMTP_RELAY_PASSWORD=

# --- Direct Mode Settings (only used when SMTP_MODE=direct) ---
# DKIM signing (optional but strongly recommended for direct mode)
# Generate: opendkim-genkey -s mail -d yourdomain.com
# SMTP_DKIM_SELECTOR=mail
# SMTP_DKIM_PRIVATE_KEY_FILE=/etc/opendkim/keys/mail.private

# ==============================================================================
# KOMODO CONFIGURATION
# ==============================================================================
# ga.1 (Issue F): Komodo 2.2.0 validates incoming requests against KOMODO_HOST.
# Behind Caddy the external Host is admin.<domain>, so localhost mismatched → HTTP 400.
# Point it at the external URL Komodo is actually reached on.
KOMODO_HOST=https://${KOMODO_DOMAIN}
KOMODO_TITLE=razzfazz.ai Services Stack
KOMODO_DB_TYPE=mongodb
KOMODO_DATABASE_URI=mongodb://${POSTGRES_USER}:${POSTGRES_PASSWORD}@ferretdb:27017/komodo?authSource=admin
KOMODO_FIRST_SERVER=https://komodo-periphery:${KOMODO_PERIPHERY_PORT}
KOMODO_FIRST_SERVER_NAME=Local
KOMODO_LOCAL_AUTH=true
# Per-service admin password (generated by razzfazz-init.sh, unique per service)
KOMODO_INIT_ADMIN_USERNAME=admin
KOMODO_INIT_ADMIN_PASSWORD=

# ==============================================================================
# BACKUP CONFIGURATION
# ==============================================================================
BACKUP_CRON_EXPRESSION="0 3 * * *"
BACKUP_FILENAME="backup-%Y-%m-%d-%H%M.tar.gz"
BACKUP_RETENTION_DAYS="7"
# Where offen builds the temporary archive. offen writes the archive (and, with
# encryption, the .gpg) to a HARDCODED /tmp inside the backup container — it does
# NOT honor TMPDIR — so /tmp is a mount. Leave EMPTY (default) on boxes with a
# large root/OS disk: a named docker volume (backup-tmp) on the root disk is used.
# On a box whose root disk is small and the backup archive lives on a SEPARATE
# disk, set this to a host path ON that backup disk (e.g. the dir that holds the
# backups), so the ~2x-archive-size temp build never pressures root and can't
# trigger a disk-full -> postgres crash-loop. Example:
#   BACKUP_TMP_DIR=/home/<user>/razzfazz-ai-service-stack/backups/.offen-tmp
BACKUP_TMP_DIR=""
# Include LLM/TTS model files (gpustack-data, speaches-data) in backups?
# "false" (default): exclude model files — saves significant disk space
# "true": include model files in every backup
BACKUP_INCLUDE_MODEL_FILES="false"
# Exclude the dify-plugin-daemon volume from backups?
# "false" (default): the volume IS backed up.
# "true": skip it — Dify plugin data is re-downloadable and can grow large.
# The Configuration Portal (Backup → Settings) toggles this and derives
# BACKUP_EXCLUDE_REGEXP below from it together with BACKUP_INCLUDE_MODEL_FILES.
BACKUP_EXCLUDE_DIFY_PLUGINS="false"
# Regex pattern for volumes to exclude from backup (used by offen/docker-volume-backup)
# DERIVED from BACKUP_INCLUDE_MODEL_FILES + BACKUP_EXCLUDE_DIFY_PLUGINS by the
# Configuration Portal — edit those toggles rather than this line by hand.
#
# #182: the physical DB datadirs — postgres-data, valkey-data,
# postgres-komodo-data — are ALWAYS excluded. They are captured LOGICALLY by
# core/backup/pre-backup.sh (pg_dumpall → databases/postgres_core.sql +
# postgres_komodo.sql; valkey SAVE), which is what restore imports. Excluding
# the live datadirs means offen never tars a churning pg_wal (the
# `lstat …/pg_wal/…: no such file` race that silently killed the whole
# nightly + upgrade backup, #157), so postgres NO LONGER has to be stopped
# during the archive — no more ~24 s nightly DB-unavailability blip. The
# Configuration Portal re-appends these three datadirs on every settings save,
# so they can never be toggled back in by accident. IF you ever re-add
# postgres-data / postgres-komodo-data to the tar, you MUST also restore the
# `docker-volume-backup.stop-during-backup=true` label on those services
# (see core/compose.yml) or the pg_wal race returns.
# Default (models excluded, dify plugins kept):
#   "gpustack-data|speaches-data|postgres-data|valkey-data|postgres-komodo-data"
BACKUP_EXCLUDE_REGEXP="gpustack-data|speaches-data|postgres-data|valkey-data|postgres-komodo-data"
# Password used to encrypt backup archives (GPG). Set by razzfazz-init.sh to
# AUTHENTIK_BOOTSTRAP_PASSWORD so the customer can decrypt using the sticker
# on the box — losing the admin password also loses backup decryption.
BACKUP_ENCRYPTION_PASSWORD=

# ==============================================================================
# ADDITIONAL SECRETS (generated by razzfazz-init.sh)
# ==============================================================================
DIFY_CLIENT_SECRET=
ADMIN_CLIENT_SECRET=
LLM_CLIENT_SECRET=
BACKUP_CLIENT_SECRET=
GITEA_CLIENT_SECRET=
# Authentik proxy provider secrets for Licenses, Help UIs
# (#22) SETUP_CLIENT_SECRET removed — setup.<domain> app retired in 2026.07.
LICENSES_CLIENT_SECRET=
HELP_CLIENT_SECRET=

ACME_EMAIL=
GPUSTACK_SECRET_KEY=
KOMODO_PASSKEY=

# Per-service admin passwords (generated by razzfazz-init.sh, each unique)
# Dify admin password (max 30 characters)
DIFY_ADMIN_PASSWORD=
# Cognee default user password
COGNEE_ADMIN_PASSWORD=
# Cognee API key for the cognee-mcp sidecar (M033 S12) — minted post-install
# from cognee /api/v1/auth/api-keys. Lets MCP agents (Moltis/Hermes) use cognee
# as memory via http://cognee-mcp:8000/mcp. Empty → sidecar can't authenticate.
COGNEE_MCP_API_KEY=
# #36 two-tier Cognee memory: enable backend access control + auth enforcement.
# When true (default), the Cognee backend requires auth on /api/* and scopes
# datasets per user — required for TRULY isolated "Personal Memory (private)"
# MCP integrations (the mcp-manager fail-closes personal cognee provisioning
# when this is off, so no isolation is ever faked). All in-stack callers already
# authenticate, so this does not break them. Set false only for a deliberate
# single-tenant box.
COGNEE_ACCESS_CONTROL=true

# ==============================================================================
# PAPERLESS-NGX CONFIGURATION [EXPERIMENTAL]
# ==============================================================================
# Self-hosted document management — scan, OCR, archive, and search documents.
# Reuses existing gotenberg and tika containers for Office doc + metadata support.
# Upstream: https://github.com/paperless-ngx/paperless-ngx (GPL-3.0)
# User-facing at https://paperless.${MAIN_DOMAIN}
PAPERLESS_PORT=8001
PAPERLESS_DOMAIN=paperless.${MAIN_DOMAIN}
PAPERLESS_DB=paperless_db
PAPERLESS_SECRET_KEY=
PAPERLESS_OCR_LANGUAGE=eng+deu
PAPERLESS_CLIENT_SECRET=

# ==============================================================================
# VAULTWARDEN CONFIGURATION [EXPERIMENTAL]
# ==============================================================================
# Self-hosted Bitwarden-compatible password manager with Authentik OIDC SSO.
# Vault encryption is local (master password independent of SSO provider).
# Upstream: https://github.com/dani-garcia/vaultwarden (GPL-3.0)
# User-facing at https://vault.${MAIN_DOMAIN}
VAULTWARDEN_PORT=8222
VAULTWARDEN_DOMAIN=vault.${MAIN_DOMAIN}
VAULTWARDEN_DB=vaultwarden_db
# /admin is a shared-secret, user-agnostic server backdoor. Left EMPTY by default =
# panel DISABLED (Vaultwarden refuses to open it token-free). All admin work is done
# via Authentik SSO Org-Owner roles. To enable /admin for break-glass, set this to an
# Argon2 hash from `vaultwarden hash` (NOT a plaintext token — that's a config-leak = takeover).
VAULTWARDEN_ADMIN_TOKEN=
VAULTWARDEN_CLIENT_SECRET=
# Organization Groups (group-based collection access) — on by default so org Owners
# can grant collection permissions to groups instead of per-member. Set to "false" to
# hide the Groups feature. Vaultwarden's own default is off; the stack enables it.
VAULTWARDEN_ORG_GROUPS_ENABLED=true
# F-041: Set to "true" only when TLS_MODE=internal (self-signed certs)
# razzfazz-init.sh sets this based on TLS_MODE at install time
VAULTWARDEN_SSO_ACCEPT_INVALID_CERTS=false
# Email (#12): Vaultwarden has no MAIL_ENABLED toggle — mail is enabled purely by
# setting SMTP_HOST. EMPTY = mail off (default). Set to `smtp-relay` to route
# Vaultwarden email through the internal relay (SASL auth: mail@${MAIN_DOMAIN} /
# SMTP_INTERNAL_PASSWORD, reusing SMTP_FROM). Port/security are overridable below.
VAULTWARDEN_SMTP_HOST=
VAULTWARDEN_SMTP_PORT=587
VAULTWARDEN_SMTP_SECURITY=off

# ==============================================================================
# INFISICAL CONFIGURATION [EXPERIMENTAL]
# ==============================================================================
# Self-hosted secrets management for developers and AI agents.
# Agents (gsd-2, paperclip, openhands) use INFISICAL_API_URL + machine identity tokens.
# Upstream: https://github.com/Infisical/infisical (MIT)
# User-facing at https://infisical.${MAIN_DOMAIN}
INFISICAL_PORT=8888
INFISICAL_DOMAIN=infisical.${MAIN_DOMAIN}
INFISICAL_DB=infisical_db
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=
INFISICAL_CLIENT_SECRET=

# ==============================================================================
# ONYX (AI ENTERPRISE SEARCH) CONFIGURATION [EXPERIMENTAL]
# ==============================================================================
# AI-powered enterprise search across Gitea repos + paperless-ngx documents.
# Uses Gitea GitHub-compatible API as connector source.
# Upstream: https://github.com/onyx-dot-app/onyx (MIT)
# User-facing at https://onyx.${MAIN_DOMAIN}
ONYX_DOMAIN=onyx.${MAIN_DOMAIN}
ONYX_DB=onyx_db
ONYX_SECRET=
ONYX_CLIENT_SECRET=
# #170 — disable Qwen3 "thinking" for Onyx's own LLM calls ONLY. The stack's Onyx
# points at the GPUStack qwen3.6 model (llama-box runner), which defaults to
# thinking-mode and leaves Onyx's agentic answers empty. This JSON is forwarded by
# Onyx's LiteLLM as extra_body → chat_template_kwargs reaches llama-box (the runner
# ignores the vLLM enable_thinking flag). SCOPED TO ONYX: the shared qwen3.6 model
# is untouched, so OWUI / Dify / cognee / TARIC keep thinking ON. Set empty to opt
# out (e.g. if you point Onyx at a provider that rejects unknown body params).
ONYX_LITELLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

