# ==============================================================================
# CODING TOOLS (gsd-pi + opencode-ai) — npm package pins
# ==============================================================================
# Build-time args for the razzfazz-coding-tools custom image (built once into
# `razzfazz-coding-tools:latest`, then provisioned per-user by agent-manager).
# Pinned for reproducibility — bump via the check-and-bump-versions skill.
OPENCODE_VERSION=1.18.4
# #36 coding-agent split — OpenAI Codex CLI (Apache-2.0) pin for the codex image.
CODEX_VERSION=0.144.6
# (M020 S07) CODING TOOLS global config removed — coding-tools is now per-user
# via agent-manager. Per-user gsd --web is at coding-tools-<slug>.${AGENTS_DOMAIN};
# opencode serve runs internal-only on the same per-user container at port 4096
# (consumed by modules/chat/functions/opencode_pipe.py via Docker DNS, not exposed).
# Per-instance OPENCODE_SERVER_PASSWORD is generated by the provisioner.
# ==============================================================================

# ==============================================================================
# EXTRA SYSTEM (APT) PACKAGES FOR PER-USER AGENT IMAGES (#212)
# ==============================================================================
# The per-user agent sandboxes (coding-agent opencode/codex/user-defined, moltis,
# hermes) run NON-ROOT on a READ-ONLY root filesystem with NO sudo (hostile-
# container hardening). So `apt install` CANNOT work at runtime inside an agent.
# Userspace tools DO install sudo-less into the persistent home volume already —
# `npm install -g` (→ ~/.npm-global), `pip install --user` (→ ~/.local),
# `cargo install` (→ ~/.cargo), and conda/micromamba. The one thing users can NOT
# add sudo-less is SYSTEM LIBRARIES (apt) — those must be baked into the image at
# BUILD time (as root, before the container drops to its non-root user).
#
# This is that knob. It's a build arg passed to every per-user agent image. To add
# a system package: APPEND its name to the value below (keep the existing libs so
# browser automation keeps working), then rebuild + re-provision:
#     rzfz post-install --refresh      # rebuilds the agent images with the new list
#     # then each user re-provisions from the My Agents drawer
# A bare `docker compose build` NO-OPs on an installed box (the #184 no-runtime-
# build overlay), so use `rzfz post-install --refresh` to pick up a changed list.
#
# The default below is the Playwright/Chromium runtime lib set, so headless-browser
# automation works out of the box — inside an agent terminal:
#     pip install --user playwright && playwright install chromium
# ...then Playwright drives the bundled Chromium against these baked libs.
#
# NOTE (trixie): hermes' base image (debian:13.x) uses the t64-renamed names
# (libcups2t64, libasound2t64, libatk1.0-0t64, ...). The bookworm-based images
# (coding-agent, moltis) use the un-suffixed names below. The value here uses the
# bookworm names, which also resolve on hermes' trixie base via transitional
# packages; each compose builder additionally carries a distro-correct fallback
# default for boxes whose .env predates this key.
USER_DEFINED_APT_PACKAGES=libnss3 libnspr4 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 libatspi2.0-0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 libcairo2 libasound2 libxshmfence1 libx11-6 libxcb1 libxext6 libxi6 fonts-liberation
# ==============================================================================

# ==========================================
# AGENT MANAGER CONFIGURATION [EXPERIMENTAL]
# ==========================================
# Per-user agent instance orchestration.
# Enable via: agents profile in COMPOSE_PROFILES
AGENT_MANAGER_PORT=5110
AGENT_MANAGER_DB=agent_manager_db
AGENTS_DOMAIN=agents.${MAIN_DOMAIN}
AGENTS_CLIENT_SECRET=

# Resource governance
AGENT_MAX_INSTANCES=20
AGENT_IDLE_TIMEOUT_LIGHTWEIGHT=1800
AGENT_IDLE_TIMEOUT_HEAVY=7200
AGENT_CLEANUP_AFTER_DAYS=30
# Memory governance (#36 / PR #84). Per-instance max + default (GB) that a
# power/admin user may pick per agent; the per-instance floor every user gets.
# The GLOBAL agents-memory budget + per-user cap are set in the Config UI
# (Personal Agents -> Global Limits) and stored in the Agent Manager DB (live,
# no recreate). AGENT_CORE_STACK_RESERVE_MB is the RAM held back for the core
# stack when the budget's dynamic per-box ceiling is derived from host memory.
AGENT_MEM_PER_INSTANCE_MAX_GB=16
AGENT_MEM_DEFAULT_GB=2
AGENT_CORE_STACK_RESERVE_MB=8192

# ==========================================
# PERSONAL MCP MANAGER CONFIGURATION [EXPERIMENTAL] (#36)
# ==========================================
# Per-user MCP-proxy provisioning + encrypted credential vault.
# Enable via: mcp profile in COMPOSE_PROFILES
MCP_MANAGER_PORT=5120
MCP_MANAGER_DB=mcp_manager_db
MCP_MANAGER_DB_USER=mcp_manager_user
MCP_MANAGER_DB_PASSWORD=
MCP_DOMAIN=mcp.${MAIN_DOMAIN}
# AES-256-GCM master key (base64 32 bytes) for credential encryption-at-rest.
# Minted by razzfazz-init.sh / razzfazz-post-install.sh — DO NOT leave empty
# in production (an empty key disables the credential vault).
MCP_MANAGER_SECRET_KEY=
# Authentik forward-auth client secret for the mcp.${MAIN_DOMAIN} site.
MCP_CLIENT_SECRET=
# #61 (HIGH-1): shared service-to-service secret gating mcp-manager's
# /internal/* routes (agent-manager presents it via X-MCP-Internal-Token).
# Minted by razzfazz-init.sh — empty => /internal fails closed (401).
MCP_INTERNAL_TOKEN=
# C1 bypass fix (PR #84 re-review): "came through Caddy" proof secret for the
# agent-manager per-instance subdomain proxy. Caddy injects
# X-Razzfazz-Proxy-Proof=$MANAGER_PROXY_SECRET (stripping any client value) on
# every proxied *.agents request; agent-manager REJECTS any request lacking it.
# Shared ONLY between Caddy and agent-manager — it MUST NOT be exposed to any
# sandbox coding-agent container. Minted by razzfazz-init.sh; empty => the
# manager fails closed (refuses all agent proxy requests). Required whenever the
# `agents` profile is active.
MANAGER_PROXY_SECRET=
# Max concurrent per-user MCP proxies box-wide.
MCP_MAX_INSTANCES=50
# OAuth client secrets (server-side only; empty until the operator registers
# OAuth apps per box — see core/mcp/oauth-providers.yaml).
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_SECRET=

# ==============================================================================
# OBSERVABILITY (observability profile) — OpenLIT + ClickHouse (M019)
# ==============================================================================
OBSERVABILITY_VERSION=1.24.1
OBSERVABILITY_PORT=8200
OBSERVABILITY_DOMAIN=observability.${MAIN_DOMAIN}
# Authentik forward-auth client secret — generated by razzfazz-init.sh on first install
OBSERVABILITY_CLIENT_SECRET=
# ClickHouse TTL for OpenLIT span tables (auto-prune older partitions)
OBSERVABILITY_RETENTION_DAYS=30
# OTLP/HTTP endpoint the modules/chat/pipelines/openlit_filter.py pushes spans to.
# Points at the otel-collector container (the real OTLP receiver) — NOT openlit,
# which ships no receiver (#193). Only reachable when the observability profile
# is active. Override only if running the collector/OpenLIT externally.
OPENLIT_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
# Scrub email / phone / API-key shapes from prompt + completion text before
# they reach OpenLIT. Off by default; set to "true" for customer deployments
# where chats may carry regulated data. Only affects span events, not
# token-count or latency attributes.
OBSERVABILITY_PII_FILTER=false

# ClickHouse — OpenLIT span store
CLICKHOUSE_VERSION=25.8.28.1
CLICKHOUSE_USER=default
# Generated by razzfazz-init.sh on first install
CLICKHOUSE_PASSWORD=

# --- OpenTelemetry Collector (observability profile) — fixes #193 -----------
# The real OTLP collector (otel/opentelemetry-collector-contrib) that OpenLIT
# ingest actually lands in. The openlit image ships NO OTLP receiver; the
# collector receives OTLP on 4317/4318 and writes otel_traces/otel_logs/
# otel_metrics into ClickHouse (create_schema) — the tables the dashboard reads.
OTEL_COLLECTOR_VERSION=0.130.1

# --- #197: external OTLP log export (OPT-IN, OFF by default) -----------------
# Ship ALL container logs (filelog over /var/lib/docker/containers) to a
# customer-owned OTLP target (Grafana Loki+OTel, Tempo, Datadog, Splunk,
# Elastic, a plain OTEL Collector, ...). Enterprise / NIS2 centralized-logging.
# The outbound to the target is a DELIBERATE egress — allow-list that host in
# your egress model. With export OFF, nothing is tailed or dialed (air-gap safe).
OTEL_LOG_EXPORT_ENABLED=false
# Mechanical switch read by observability/compose.yml: which logs overlay the
# collector merges. Leave as the disabled (no-op) overlay; razzfazz-init.sh /
# the Config Portal flip it to the export overlay when OTEL_LOG_EXPORT_ENABLED=true.
OTEL_COLLECTOR_LOGS_OVERLAY=otel-collector-logs-disabled.yaml
# Customer OTLP endpoint. gRPC (default exporter): host:4317 or a TLS ingress.
# Required (only) when OTEL_LOG_EXPORT_ENABLED=true. Empty = export off.
OTEL_EXPORTER_OTLP_ENDPOINT=
# grpc | http/protobuf. v1 wires the gRPC exporter; http/protobuf is a
# documented swap in otel-collector-logs-export.yaml (both exporters are defined).
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# SECRET. Auth header VALUE sent as `Authorization: <this>` to the OTLP target
# (e.g. "Bearer <token>" or "Api-Token dt0c01..."). Treat like any credential;
# never logged. Empty = no auth header (mTLS / trusted-network targets).
OTEL_EXPORTER_OTLP_HEADERS=
# TLS to the target. false (default) = TLS on, verified against system CA roots
# (public-CA / Let's Encrypt ingress). true = plaintext (trusted network only).
# Private CA: uncomment ca_file in otel-collector-logs-export.yaml + mount the CA.
OTEL_EXPORTER_OTLP_INSECURE=false

