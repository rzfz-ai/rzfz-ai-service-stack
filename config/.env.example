PAPERLESS_DB_PASSWORD=
INFISICAL_DB_USER=infisical_user
INFISICAL_DB_PASSWORD=
ONYX_DB_USER=onyx_user
ONYX_DB_PASSWORD=

# Valkey (Redis) Connection Details
# Generated by razzfazz-init.sh — do not use example values in production
VALKEY_PASSWORD=
