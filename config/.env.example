GITEA_SSH_PORT=2222

# Generated by razzfazz-init.sh
GITEA_SECRET_KEY=
GITEA_INTERNAL_TOKEN=
GITEA_ADMIN_USER=admin
GITEA_ADMIN_PASSWORD=
