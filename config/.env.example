# Profile: presidio
# PII detection (Analyzer) and image redaction (Image Redactor).
# Internal-only — no Caddy, no Authentik.
# Access via Docker DNS: presidio-analyzer:3000 / presidio-image-redactor:3000
PRESIDIO_ANALYZER_PORT=5100
PRESIDIO_ANONYMIZER_PORT=5300
PRESIDIO_IMAGE_REDACTOR_PORT=5200

# ==============================================================================
